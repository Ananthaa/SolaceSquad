{% extends "base.html" %}

{% block title %}Sign In to SolaceSquad — Your Wellness Dashboard{% endblock %}
{% block meta_desc %}Sign in to your SolaceSquad account and continue your mental, physical and professional wellness journey with certified consultants.{% endblock %}
{% block meta_robots %}noindex, follow{% endblock %}
{% block og_title %}Sign In to SolaceSquad — Your Wellness Dashboard{% endblock %}
{% block og_desc %}Sign in to SolaceSquad and continue your wellness journey with certified consultants.{% endblock %}
{% block tw_title %}Sign In to SolaceSquad — Your Wellness Dashboard{% endblock %}
{% block tw_desc %}Sign in to SolaceSquad and continue your wellness journey with certified consultants.{% endblock %}

{% block content %}
<div
    class="min-h-screen flex items-center justify-center bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-12 px-4">
    <div class="max-w-md w-full">
        <!-- Logo -->
        <div class="text-center mb-8">
            <a href="/" class="inline-block mb-4">
                <img src="/static/images/logo.png" alt="SolaceSquad" class="h-16 w-auto mx-auto">
            </a>
            <h1 class="text-3xl font-display font-bold text-gray-900 mt-4">Welcome Back</h1>
            <p class="text-gray-600 mt-2">Sign in to continue your wellbeing journey</p>
        </div>

        <!-- Login Form -->
        <div class="card">
            <form method="POST" action="/login" class="space-y-6">
                <input type="hidden" name="next_url" value="{{ next_url or '' }}">

                <!-- Google Login Button -->
                <a href="/auth/google/login" id="google-login-btn"
                   class="flex items-center justify-center gap-3 w-full py-3 border border-gray-300 rounded-lg hover:bg-gray-50 active:bg-gray-100 transition font-medium text-gray-700 text-sm">
                    <svg class="w-5 h-5" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="none" d="M0 0h48v48H0z"/></svg>
                    Continue with Google
                </a>

                <!-- Divider -->
                <div class="flex items-center gap-3 my-2">
                    <hr class="flex-grow border-gray-200">
                    <span class="text-xs text-gray-400 whitespace-nowrap">or sign in with email</span>
                    <hr class="flex-grow border-gray-200">
                </div>

                {% if error %}
                <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded">
                    <div class="flex items-center">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-red-500 mr-2"></i>
                        <p class="text-sm text-red-700">{{ error }}</p>
                    </div>
                </div>
                {% endif %}

                {% if success %}
                <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded">
                    <div class="flex items-center">
                        <i data-lucide="check-circle" class="w-5 h-5 text-green-500 mr-2"></i>
                        <p class="text-sm text-green-700">{{ success }}</p>
                    </div>
                </div>
                {% endif %}

                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        Email Address
                    </label>
                    <input type="email" id="email" name="email" required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
                        placeholder="you@example.com">
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
                        Password
                    </label>
                    <input type="password" id="password" name="password" required
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
                        placeholder="••••••••">
                </div>

                <div class="flex items-center justify-between">
                    <label class="flex items-center">
                        <input type="checkbox"
                            class="w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500">
                        <span class="ml-2 text-sm text-gray-600">Remember me</span>
                    </label>
                    <a href="/forgot-password" class="text-sm text-primary-600 hover:text-primary-700">
                        Forgot password?
                    </a>
                </div>

                <button type="submit" class="btn btn-primary w-full text-lg">
                    Sign In
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>

            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">
                    Don't have an account?
                    <a href="/signup" class="text-primary-600 hover:text-primary-700 font-medium">
                        Sign up
                    </a>
                </p>
            </div>
        </div>

        <p class="text-center text-sm text-gray-500 mt-6">
            By signing in, you agree to our
            <a href="/terms" class="text-primary-600 hover:text-primary-700">Terms of Service</a>
            and
            <a href="/privacy" class="text-primary-600 hover:text-primary-700">Privacy Policy</a>
        </p>
    </div>
</div>
{% endblock %}