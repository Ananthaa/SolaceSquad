    // Call Diagnostics checker (runs in lobby on failure)
    async function runCompatibilityDiagnostics(error) {
        const diagCard = document.getElementById('lobby-diagnostics-card');
        const diagPerm = document.getElementById('diag-permission');
        const diagHard = document.getElementById('diag-hardware');
        const diagNet  = document.getElementById('diag-network');
        const diagAdv  = document.getElementById('diag-advice');

        if (!diagCard) return;
        diagCard.classList.remove('hidden');

        let advice = '';

        // 1. Diagnose Permission
        const errName = error ? (error.name || error.constructor.name) : '';
        if (errName === 'NotAllowedError' || errName === 'PermissionDeniedError') {
            diagPerm.innerHTML = '<span class="text-red-600 font-semibold">❌ Blocked</span>';
            advice += 'Your browser is blocking the microphone. Please click the lock icon 🔒 next to the website URL at the top of your screen, change the Microphone setting to "Allow", and click "Try Again".\n\n';
        } else {
            diagPerm.innerHTML = '<span class="text-green-600 font-semibold">✅ Allowed</span>';
        }

        // 2. Diagnose Hardware
        try {
            const devices = await navigator.mediaDevices.enumerateDevices();
            const mics = devices.filter(d => d.kind === 'audioinput');
            if (mics.length === 0) {
                diagHard.innerHTML = '<span class="text-red-600 font-semibold">❌ Not plugged in</span>';
                advice += 'We cannot find any microphone connected to your computer/phone. Please plug in a headset or external microphone and click "Try Again".\n\n';
            } else if (errName === 'NotReadableError' || errName === 'TrackStartError') {
                diagHard.innerHTML = '<span class="text-amber-600 font-semibold">⚠️ Locked by another app</span>';
                advice += 'Your microphone is busy. Please close other apps that use your microphone (like Zoom, MS Teams, Skype, or Google Meet) and click "Try Again".\n\n';
            } else if (errName === 'TimeoutError') {
                diagHard.innerHTML = '<span class="text-red-600 font-semibold">❌ Not responding</span>';
                advice += 'Your microphone system is temporarily frozen. Try unplugging your microphone, plugging it into a different USB port, restarting your browser, and retrying.\n\n';
            } else {
                diagHard.innerHTML = `<span class="text-green-600 font-semibold">✅ Connected (${mics.length} mic(s))</span>`;
            }
        } catch (e) {
            diagHard.innerHTML = '<span class="text-amber-600 font-semibold">⚠️ Scan failed</span>';
        }

        // 3. Diagnose Network
        diagNet.innerHTML = '<span class="text-slate-500">Testing...</span>';
        const startNet = Date.now();
        try {
            const res = await fetch('/api/call/ice-servers', { cache: 'no-store' }).catch(() => null);
            const latency = Date.now() - startNet;
            if (res && res.ok) {
                if (latency > 800) {
                    diagNet.innerHTML = `<span class="text-amber-600 font-semibold">⚠️ Slow connection (${latency}ms)</span>`;
                    advice += 'Your internet connection is slow. The call will connect, but you might experience audio lag. Try moving closer to your Wi-Fi router or closing background downloads.\n\n';
                } else {
                    diagNet.innerHTML = `<span class="text-green-600 font-semibold">✅ Good (${latency}ms)</span>`;
                }
            } else {
                diagNet.innerHTML = '<span class="text-red-600 font-semibold">❌ No internet / Blocked</span>';
                advice += 'We cannot reach our servers. Please check your internet connection and turn off any VPN or work firewalls, then try again.\n\n';
            }
        } catch (e) {
            diagNet.innerHTML = '<span class="text-red-600 font-semibold">❌ Offline</span>';
            advice += 'Please check that you are connected to the internet and click "Try Again".\n\n';
        }

        if (!advice) {
            advice = 'We could not start your microphone. Try refreshing this page or opening it in a different browser (Chrome, Safari, or Firefox).';
        }

        diagAdv.innerText = advice.trim();
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    // Manually trigger call diagnostics check from the button
    async function runManualDiagnostics() {
        const btn = document.getElementById('diag-run-btn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = 'Testing...';
        }
        
        // Attempt to acquire microphone to test connection
        let testError = null;
        try {
            const constraints = { 
                audio: selectedMicId ? { deviceId: { exact: selectedMicId } } : true, 
                video: false 
            };
            // 6-second timeout for manual test
            const stream = await Promise.race([
                navigator.mediaDevices.getUserMedia(constraints),
                new Promise((_, reject) => setTimeout(() => reject(new DOMException("Microphone timeout", "TimeoutError")), 6000))
            ]);
            stream.getTracks().forEach(t => t.stop());
        } catch (e) {
            testError = e;
        }
        
        await runCompatibilityDiagnostics(testError);
        
        // If the test succeeded, override the card header to show success
        if (!testError) {
            const diagCard = document.getElementById('lobby-diagnostics-card');
            const diagAdv  = document.getElementById('diag-advice');
