        }
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    async function changeLobbyMic(deviceId) {
        selectedMicId = deviceId;
        if (!lobbyStream) return;

        lobbyStream.getAudioTracks().forEach(t => t.stop());
        try {
            const constraints = { audio: { deviceId: { exact: deviceId } } };
            const newStream = await navigator.mediaDevices.getUserMedia(constraints);
            const newTrack = newStream.getAudioTracks()[0];

            lobbyStream.removeTrack(lobbyStream.getAudioTracks()[0]);
