    function startLobbyAudioVisualizer(stream) {
        try {
            if (lobbyAudioContext) {
                lobbyAudioContext.close().catch(() => {});
            }
            lobbyAudioContext = new (window.AudioContext || window.webkitAudioContext)();
            lobbyAnalyser = lobbyAudioContext.createAnalyser();
            lobbyAnalyser.fftSize = 256;

            const source = lobbyAudioContext.createMediaStreamSource(stream);
            source.connect(lobbyAnalyser);

            const bufferLength = lobbyAnalyser.frequencyBinCount;
            const dataArray = new Uint8Array(bufferLength);
            const volBar = document.getElementById('lobby-vol-indicator');

            function drawVolume() {
                if (!lobbyAudioContext || lobbyAudioContext.state === 'closed') return;
                requestAnimationFrame(drawVolume);

                lobbyAnalyser.getByteFrequencyData(dataArray);
                let values = 0;
                for (let i = 0; i < bufferLength; i++) {
                    values += dataArray[i];
                }
                const average = values / bufferLength;
                
                // Mute styling indicator check
                if (lobbyMicMuted) {
                    if (volBar) volBar.style.width = '0%';
                    return;
                }
                
                const percent = Math.min(100, Math.round((average / 110) * 100));
                if (volBar) volBar.style.width = percent + '%';
            }
            drawVolume();
        } catch (e) {
            console.warn('[Lobby] Volume visualizer error:', e);
        }
    }

