    async function toggleLobbyCam() {
        const videoEl = document.getElementById('lobby-preview-video');
        const avatarEl = document.getElementById('lobby-camera-avatar');
        const btn = document.getElementById('lobby-btn-cam');
        const icon = document.getElementById('lobby-icon-cam');
        if (!videoEl || !avatarEl || !btn || !icon) return;

        if (lobbyCamMuted) {
            try {
                const constraints = {
                    video: selectedCameraId ? { deviceId: { exact: selectedCameraId }, width: 640, height: 480 } : { width: 640, height: 480 }
                };
                const camStream = await navigator.mediaDevices.getUserMedia(constraints);
                const track = camStream.getVideoTracks()[0];

                if (lobbyStream) {
                    lobbyStream.getVideoTracks().forEach(t => { t.stop(); lobbyStream.removeTrack(t); });
                    lobbyStream.addTrack(track);
                } else {
                    lobbyStream = camStream;
                }

                videoEl.srcObject = new MediaStream([track]);
                videoEl.classList.remove('hidden');
                avatarEl.classList.add('hidden');
                btn.classList.add('bg-blue-600');
                btn.classList.remove('bg-slate-800/90');
