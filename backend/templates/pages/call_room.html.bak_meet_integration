    // Recording variables
    let mediaRecorder;
    let recordedChunks = [];
    let audioContext;
    let audioDestination;
    let remoteStreamForRecording; // To keep track
    let recordingCanvas;
    let recordingCtx;
    let isDrawingCanvas = false;
    let canvasStream;
    let isRecordingVideo = false;

    // ── Auto-start recording on audio mix destination ──────────────────
    function startRecording() {
        if (!CONSENT_TO_RECORD) {
            console.log('[Recording] Bypassing call recording - user did not consent');
            return;
        }
        if (!window.MediaRecorder || !audioDestination) {
            console.warn('[Recording] MediaRecorder or audioDestination not available');
            return;
        }
        try {
            recordedChunks = []; // clear previous chunks
            isRecordingVideo = false;
            
            // Create a canvas to combine video feeds programmatically
            recordingCanvas = document.createElement('canvas');
            recordingCanvas.width = 640;
            recordingCanvas.height = 480;
            recordingCtx = recordingCanvas.getContext('2d');
            
            // Draw placeholder background
            recordingCtx.fillStyle = '#0f172a';
            recordingCtx.fillRect(0, 0, 640, 480);
            recordingCtx.fillStyle = '#ffffff';
            recordingCtx.font = '16px sans-serif';
            recordingCtx.textAlign = 'center';
            recordingCtx.fillText('Consultation Session Active', 320, 240);
            
            isDrawingCanvas = true;
            function drawLoop() {
                if (!isDrawingCanvas) return;
                
                recordingCtx.fillStyle = '#0f172a';
                recordingCtx.fillRect(0, 0, 640, 480);
                
                const remoteVideo = document.getElementById('remote-video');
                const localVideo = document.getElementById('local-video');
                
                const remoteActive = remoteVideo && remoteVideo.srcObject && remoteVideo.srcObject.getVideoTracks().length > 0 && remoteVideo.srcObject.getVideoTracks()[0].readyState === 'live';
                const localActive = localVideo && localVideo.srcObject && localVideo.srcObject.getVideoTracks().length > 0 && localVideo.srcObject.getVideoTracks()[0].readyState === 'live';
                
                if (remoteActive && localActive) {
                    // Draw side-by-side
                    recordingCtx.drawImage(remoteVideo, 0, 120, 320, 240);
                    recordingCtx.drawImage(localVideo, 320, 120, 320, 240);
                    isRecordingVideo = true;
                } else if (remoteActive) {
                    recordingCtx.drawImage(remoteVideo, 80, 60, 480, 360);
                    isRecordingVideo = true;
                } else if (localActive) {
                    recordingCtx.drawImage(localVideo, 80, 60, 480, 360);
                    isRecordingVideo = true;
                } else {
                    recordingCtx.fillStyle = '#ffffff';
                    recordingCtx.font = '18px sans-serif';
                    recordingCtx.textAlign = 'center';
                    recordingCtx.fillText('Consultation Session (Audio Only)', 320, 240);
                }
                
                requestAnimationFrame(drawLoop);
            }
            drawLoop();
            
            // Capture stream at 10 FPS
            canvasStream = recordingCanvas.captureStream(10);
            
            // Mix canvas video track with mixed audio
            const mixedTracks = [
                ...audioDestination.stream.getAudioTracks(),
                ...canvasStream.getVideoTracks()
            ];
            
            const recordStream = new MediaStream(mixedTracks);
            
            // Use video mimeType if canvas returns a video track
            const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp8,opus')
                ? 'video/webm;codecs=vp8,opus'
                : (MediaRecorder.isTypeSupported('video/webm') ? 'video/webm' : 'audio/webm');
                
            mediaRecorder = new MediaRecorder(recordStream, { 
                mimeType,
                videoBitsPerSecond: 150000, // 150 Kbps (lightweight video)
                audioBitsPerSecond: 32000   // 32 Kbps (clear speech audio)
            });
            mediaRecorder.ondataavailable = (e) => {
                if (e.data && e.data.size > 0) recordedChunks.push(e.data);
            };
            mediaRecorder.start(10000); // collect chunks every 10s

            // Show REC badge
            const badge = document.getElementById('recording-badge');
            if (badge) badge.classList.remove('hidden');
            console.log('[Recording] Started — mimeType:', mimeType);
        } catch (err) {
            console.error('[Recording] Failed to start MediaRecorder:', err);
        }
    }

    // Initialize call
    async function initializeCall() {
        try {
            // Fetch ICE servers from backend (supports METERED_API_KEY for reliable TURN)
            await fetchIceServers();

            // Helper to get user media with an 8-second timeout to prevent driver freeze hangs
            async function getUserMediaWithTimeout(constraints, timeoutMs = 8000) {
                return Promise.race([
                    navigator.mediaDevices.getUserMedia(constraints),
                    new Promise((_, reject) => 
                        setTimeout(() => reject(new DOMException("Microphone request timed out (possible hardware freeze).", "TimeoutError")), timeoutMs)
                    )
                ]);
            }

            // Get user media — try ideal constraints first, fall back to relaxed
            try {
                localStream = await getUserMediaWithTimeout({
                    audio: { 
                        echoCancellation: true, 
                        noiseSuppression: true, 
                        sampleRate: 44100,
                        deviceId: selectedMicId ? { exact: selectedMicId } : undefined
                    },
                    video: false
                });
                console.log('[Mic] Acquired audio stream with full constraints');
            } catch (micErr) {
                console.warn('[Mic] Full constraints failed, trying relaxed:', micErr.name, micErr.message);
                try {
                    localStream = await getUserMediaWithTimeout({ 
                        audio: selectedMicId ? { deviceId: { exact: selectedMicId } } : true, 
                        video: false 
                    });
                    console.log('[Mic] Acquired audio stream with relaxed constraints');
                } catch (micErr2) {
                    // Both attempts failed — throw the error to block call join and trigger diagnostics
                    const errName = micErr2.name || micErr2.constructor.name || 'UnknownError';
                    console.error('[Mic] getUserMedia failed:', errName, micErr2.message);
                    throw micErr2;
                }
            }

            // Pre-sync microphone mute state selected in the lobby
            if (localStream && localStream.getAudioTracks().length > 0) {
                localStream.getAudioTracks()[0].enabled = !PRE_START_MIC_MUTED;
                micMuted = PRE_START_MIC_MUTED;
                const micBtn = document.getElementById('mic-btn');
                const micIcon = document.getElementById('mic-icon');
                const micText = document.getElementById('mic-text');
                if (micBtn && micIcon && micText) {
                    if (micMuted) {
                        micBtn.classList.add('mic-muted');
                        micIcon.setAttribute('data-lucide', 'mic-off');
                        micText.textContent = 'Unmute';
                    } else {
                        micBtn.classList.remove('mic-muted');
                        micIcon.setAttribute('data-lucide', 'mic');
                        micText.textContent = 'Mute';
                    }
                }
            }

            // Initialize AudioContext for recording mixing
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
            audioDestination = audioContext.createMediaStreamDestination();

            // Add local stream to mixer
            const localSource = audioContext.createMediaStreamSource(localStream);
            localSource.connect(audioDestination);

            // Connect to Socket.IO
            socket = io({
                path: '/socket.io'
            });

            socket.on('connect', () => {
                console.log('Connected to signaling server');
                socket.emit('join_call', {
                    room_id: ROOM_ID,
                    user_type: USER_TYPE,
                    user_name: USER_NAME
                });
            });

            // Re-emit join_call whenever the socket reconnects with a NEW SID
            // (Socket.IO auto-reconnects after network hiccups, generating a new SID)
            socket.on('reconnect', () => {
                console.log('[Socket] Reconnected — re-joining room with new SID');
                socket.emit('join_call', {
                    room_id: ROOM_ID,
                    user_type: USER_TYPE,
                    user_name: USER_NAME
                });
            });

            socket.on('room_joined', (data) => {
                console.log('Joined room:', data);
                updateStatus('connected', 'Connected');
                startEndTimeWatcher(); // start 5-min end-time warning

                // If camera was toggled ON in the lobby overlay, automatically start video in call
                if (PRE_START_VIDEO) {
                    toggleCamera();
                }

                // Only show REC badge / signal recording if user consented at booking
                if (CONSENT_TO_RECORD) {
                    if (data.recording) {
                        // Already recording (other peer started it) — show badge
                        const badge = document.getElementById('recording-badge');
                        if (badge) badge.classList.remove('hidden');
                    } else {
                        // Signal server to start recording for this room
                        socket.emit('start_recording', { room_id: ROOM_ID });
                    }
                } else {
                    // No consent — ensure badge stays hidden
                    const badge = document.getElementById('recording-badge');
                    if (badge) badge.classList.add('hidden');
                    console.log('[Recording] No consent — recording skipped.');
                }

                // Start local MediaRecorder (gated internally by CONSENT_TO_RECORD)
                startRecording();
            });

            socket.on('peer_joined', async (data) => {
                console.log('Peer joined:', data);
                updateStatus('connected', 'Peer connected');

                // Start call timer
                if (!callStartTime) {
                    startCallTimer();
                }

                // Mark appointment as in_progress now that both parties have joined
                try {
                    await fetch(`/api/appointments/${APPOINTMENT_ID}/status`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: 'in_progress' })
                    });
                } catch (e) {
                    console.warn('Could not update appointment status to in_progress:', e);
                }

                // Close existing connection if any before starting a new session
                if (peerConnection) {
                    try {
                        peerConnection.close();
                    } catch (e) {
                        console.warn('[WebRTC] Error closing peer connection on peer_joined:', e);
                    }
                    peerConnection = null;
                }

                // Create peer connection and send offer (user initiates to consultant)
                if (USER_TYPE === 'user') {
                    await createPeerConnection();
                    const offer = await peerConnection.createOffer();
                    await peerConnection.setLocalDescription(offer);
                    socket.emit('offer', {
                        room_id: ROOM_ID,
                        sdp: offer
                    });
                }
            });

            socket.on('offer', async (data) => {
                // Renegotiation: if peer connection already exists and is alive,
                // just update the remote description — do NOT create a new connection
                // (creating a new one destroys the active audio stream).
                if (!peerConnection || peerConnection.connectionState === 'closed') {
                    console.log('[WebRTC] Initial offer — creating peer connection');
                    await createPeerConnection();
                } else {
                    console.log('[WebRTC] Renegotiation offer — reusing existing peer connection');
                }
                await peerConnection.setRemoteDescription(new RTCSessionDescription(data.sdp));
                await flushPendingCandidates(); // flush any candidates that arrived early
                const answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);
                socket.emit('answer', {
                    room_id: ROOM_ID,
                    sdp: answer
                });
            });

            socket.on('answer', async (data) => {
                console.log('Received answer');
                await peerConnection.setRemoteDescription(new RTCSessionDescription(data.sdp));
                await flushPendingCandidates(); // flush any candidates that arrived early
            });

            // ICE candidate handler — buffer if remote description or peerConnection not yet set
            socket.on('ice_candidate', async (data) => {
                if (!data || !data.candidate) return;
                if (peerConnection && peerConnection.remoteDescription && peerConnection.remoteDescription.type) {
                    try {
                        await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
                    } catch(e) {
                        console.warn('[ICE] Failed to add candidate:', e);
                    }
                } else {
                    // Buffer the candidate — will be flushed after setRemoteDescription
                    console.log('[ICE] Buffering candidate (no remote desc or peer connection yet), total buffered:', pendingCandidates.length + 1);
                    pendingCandidates.push(data.candidate);
                }
            });

            socket.on('peer_left', () => {
                console.log('Peer left the call');
                updateStatus('disconnected', 'Other participant left');
                if (peerConnection) {
                    try {
                        peerConnection.close();
                    } catch (e) {
                        console.warn('[WebRTC] Error closing peer connection on peer_left:', e);
                    }
                    peerConnection = null;
                }
            });

            socket.on('peer_disconnected', () => {
                console.log('Peer disconnected');
                updateStatus('disconnected', 'Other participant disconnected — waiting for them to rejoin...');
                if (peerConnection) {
                    try {
                        peerConnection.close();
                    } catch (e) {
                        console.warn('[WebRTC] Error closing peer connection on peer_disconnected:', e);
                    }
                    peerConnection = null;
                }
            });

            // Peer went on a break — show informative status
            socket.on('peer_on_break', (data) => {
                console.log('[Call] Peer is on a break');
                updateStatus('connecting', '⏸ Other participant is on a short break...');
            });

            // Peer returned from break
            socket.on('peer_rejoined', (data) => {
                console.log('[Call] Peer has returned from break');
                updateStatus('connected', 'Connected');
            });

            // Remote party turned off their camera — clear the remote video panel
            socket.on('video_stopped', () => {
                console.log('[Call] Remote stopped video');
                const remoteVideoEl = document.getElementById('remote-video');
                if (remoteVideoEl) remoteVideoEl.srcObject = null;
                // Hide video panels if local camera is also off
                if (!cameraEnabled) {
                    const panels = document.getElementById('video-panels');
                    if (panels) panels.classList.remove('active');
                }
            });

            socket.on('recording_started', (data) => {
                console.log('Recording started');
                const badge = document.getElementById('recording-badge');
                if (badge) badge.classList.remove('hidden');
            });

        } catch (error) {
            // Catch-all for non-mic errors (ICE fetch, AudioContext, socket failures)
            console.error('[Call] Initialization error:', error.name, error.message, error);
            updateStatus('disconnected', 'Failed to connect');
            throw error;
        }
    }

    // Flush ICE candidates that arrived before setRemoteDescription was called
    async function flushPendingCandidates() {
        while (pendingCandidates.length > 0) {
            const c = pendingCandidates.shift();
            try {
                await peerConnection.addIceCandidate(new RTCIceCandidate(c));
                console.log('[ICE] Flushed buffered candidate');
            } catch(e) {
                console.warn('[ICE] Buffered candidate failed:', e);
            }
        }
    }

    // Create peer connection
    async function createPeerConnection() {
        if (peerConnection) {
            try {
                peerConnection.close();
            } catch (e) {
                console.warn('[WebRTC] Error closing existing peer connection in createPeerConnection:', e);
            }
        }
        pendingCandidates = []; // clear any buffered candidates from previous connection
        peerConnection = new RTCPeerConnection(ICE_SERVERS);

        // Add local stream
        localStream.getTracks().forEach(track => {
            peerConnection.addTrack(track, localStream);
        });

        // Add video track if camera is enabled (so video works after rejoining)
        if (cameraEnabled && videoTrack) {
            const videoStream = new MediaStream([videoTrack]);
            videoSender = peerConnection.addTrack(videoTrack, videoStream);
            console.log('[WebRTC] Automatically added active video track to the new peer connection');
        }

        // Handle ICE candidates
        peerConnection.onicecandidate = (event) => {
            if (event.candidate) {
                socket.emit('ice_candidate', {
                    room_id: ROOM_ID,
                    candidate: event.candidate
                });
            } else {
                console.log('[ICE] All candidates gathered');
            }
        };

        // Monitor connection + ICE state — with automatic ICE restart on failure
        peerConnection.onconnectionstatechange = () => {
            const state = peerConnection.connectionState;
            console.log('[WebRTC] connectionState:', state);
            if (state === 'connected') {
                updateStatus('connected', 'Connected');
                iceRestartAttempts = 0; // reset counter on success
            } else if (state === 'failed') {
                // Attempt ICE restart up to 3 times before giving up
                if (iceRestartAttempts < 3 && USER_TYPE === 'user') {
                    iceRestartAttempts++;
                    console.log(`[ICE] Restarting ICE (attempt ${iceRestartAttempts}/3)`);
                    updateStatus('connecting', `Reconnecting... (attempt ${iceRestartAttempts}/3)`);
                    peerConnection.restartIce();
                    peerConnection.createOffer({ iceRestart: true }).then(offer => {
                        return peerConnection.setLocalDescription(offer);
                    }).then(() => {
                        socket.emit('offer', { room_id: ROOM_ID, sdp: peerConnection.localDescription });
                    }).catch(e => console.warn('[ICE] Restart offer failed:', e));
                } else {
                    updateStatus('disconnected', 'Connection lost. Please click "Rejoin Call" or reload.');
                }
            } else if (state === 'disconnected') {
                updateStatus('connecting', 'Reconnecting...');
            }
        };

        peerConnection.oniceconnectionstatechange = () => {
            console.log('[ICE] iceConnectionState:', peerConnection.iceConnectionState);
        };

        peerConnection.onicegatheringstatechange = () => {
            console.log('[ICE] gatheringState:', peerConnection.iceGatheringState);
        };

        // Handle remote stream — supports both audio and video tracks
        peerConnection.ontrack = (event) => {
            const track = event.track;
            const remoteStream = event.streams[0];

            if (track.kind === 'video') {
                console.log('[Call] Received remote video track');
                const remoteVideoEl = document.getElementById('remote-video');
                // Use the track directly — event.streams[0] may be the audio-only
                // localStream from the sender, which has no video data to display.
                remoteVideoEl.srcObject = new MediaStream([track]);
                document.getElementById('video-panels').classList.add('active');
                // When remote stops video, hide panel if local also off
                track.onended = () => {
                    remoteVideoEl.srcObject = null;
                    if (!cameraEnabled) {
                        document.getElementById('video-panels').classList.remove('active');
                    }
                };
            } else {
                // Audio track — attach to persistent DOM element to prevent GC killing playback
                console.log('[Call] Received remote audio track, attaching to #remote-audio');
                const remoteAudioEl = document.getElementById('remote-audio');
                if (remoteAudioEl) {
                    remoteAudioEl.srcObject = remoteStream;
                    // Handle autoplay policy — play() may be blocked until a user gesture
                    remoteAudioEl.play().catch(err => {
                        console.warn('[Audio] Autoplay blocked, waiting for user gesture to resume:', err);
                        const resumeAudio = () => {
                            remoteAudioEl.play().catch(e => console.warn('[Audio] Resume play failed:', e));
                            document.removeEventListener('click', resumeAudio);
                            document.removeEventListener('touchstart', resumeAudio);
                        };
                        document.addEventListener('click', resumeAudio, { once: true });
                        document.addEventListener('touchstart', resumeAudio, { once: true });
                    });
                } else {
                    // Fallback: use a module-level variable so GC cannot collect it
                    console.warn('[Audio] #remote-audio element not found, using window reference fallback');
                    window._remoteAudioFallback = new Audio();
                    window._remoteAudioFallback.srcObject = remoteStream;
                    window._remoteAudioFallback.play().catch(e => console.warn('[Audio] Fallback play failed:', e));
                }

                // Add to mixer for recording
                if (audioContext && audioDestination) {
                    if (audioContext.state === 'suspended') audioContext.resume();
                    const remoteSource = audioContext.createMediaStreamSource(remoteStream);
                    remoteSource.connect(audioDestination);
                }
            }
        };

        return peerConnection;
    }

    // Toggle mute
    function toggleMute() {
        if (localStream) {
            const audioTrack = localStream.getAudioTracks()[0];
            if (audioTrack) {
                audioTrack.enabled = !audioTrack.enabled;
                isMuted = !audioTrack.enabled;

                const muteBtn = document.getElementById('mute-btn');
                const muteText = document.getElementById('mute-text');
                const micIcon = document.getElementById('mic-icon');

                if (isMuted) {
                    muteBtn.classList.add('muted');
                    muteText.textContent = 'Unmute';
                    micIcon.setAttribute('data-lucide', 'mic-off');
                } else {
                    muteBtn.classList.remove('muted');
                    muteText.textContent = 'Mute';
                    micIcon.setAttribute('data-lucide', 'mic');
                }

                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            }
        }
    }

    // ── Camera Toggle ─────────────────────────────────────────────────────────
    async function toggleCamera() {
        const cameraBtn  = document.getElementById('camera-btn');
        const cameraIcon = document.getElementById('camera-icon');
        const cameraText = document.getElementById('camera-text');
        const localVideoEl  = document.getElementById('local-video');
        const videoPanels   = document.getElementById('video-panels');

        if (!cameraEnabled) {
            try {
                // Request camera permission using selected device ID
                const constraints = {
                    video: selectedCameraId 
                        ? { deviceId: { exact: selectedCameraId }, width: 1280, height: 720 } 
                        : { width: 1280, height: 720 }
                };
                const camStream = await navigator.mediaDevices.getUserMedia(constraints);
                videoTrack = camStream.getVideoTracks()[0];

                // Show local self-view
                localVideoEl.srcObject = new MediaStream([videoTrack]);
                videoPanels.classList.add('active');

                // Add video track to peer connection + renegotiate
                // Use a dedicated video-only stream so the remote ontrack receives
                // a video stream (not the audio localStream) via event.streams[0].
                if (peerConnection) {
                    const videoStream = new MediaStream([videoTrack]);
                    videoSender = peerConnection.addTrack(videoTrack, videoStream);
                    try {
                        const offer = await peerConnection.createOffer();
                        await peerConnection.setLocalDescription(offer);
                        socket.emit('offer', { room_id: ROOM_ID, sdp: offer });
                    } catch (e) {
                        console.warn('[Video] Renegotiation offer failed:', e);
                    }
                }

                // Handle remote ending their video call
                videoTrack.onended = () => { if (cameraEnabled) toggleCamera(); };

                cameraEnabled = true;
                cameraBtn.classList.add('camera-on');
                cameraIcon.setAttribute('data-lucide', 'video');
                cameraText.textContent = 'Stop Video';
                if (typeof lucide !== 'undefined') lucide.createIcons();

            } catch (err) {
                console.error('[Video] Camera access denied:', err);
                alert('Could not access camera. Please allow camera access in your browser settings.');
            }
        } else {
            // Turn off camera
            if (videoTrack) {
                videoTrack.enabled = false; // instantly black on remote side
                videoTrack.stop();
                videoTrack = null;
            }
            if (videoSender && peerConnection) {
                try { peerConnection.removeTrack(videoSender); } catch(e) {}
                videoSender = null;
            }
            localVideoEl.srcObject = null;

            // Notify remote party to clear their video panel
            if (socket) socket.emit('video_stopped', { room_id: ROOM_ID });

            // Hide video panel if remote also has no video
            const remoteVideo = document.getElementById('remote-video');
            if (!remoteVideo || !remoteVideo.srcObject) {
                videoPanels.classList.remove('active');
            }

            cameraEnabled = false;
            cameraBtn.classList.remove('camera-on');
            cameraIcon.setAttribute('data-lucide', 'video-off');
            cameraText.textContent = 'Start Video';
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
    }

    // ── Take a Break ──────────────────────────────────────────────────────────
    async function takeBreak() {
        // Pause local audio
        if (localStream) {
            localStream.getAudioTracks().forEach(t => t.enabled = false);
        }
        // Notify peer
        if (socket) socket.emit('on_break', { room_id: ROOM_ID });

        // Update appointment status
        try {
            await fetch(`/api/appointments/${APPOINTMENT_ID}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: 'in_progress' })  // keep in_progress; peer sees badge
            });
        } catch (_) { }

        // Show banner & swap buttons
        updateStatus('connecting', '⏸ On a break — click Rejoin when ready');
        document.getElementById('break-btn').classList.add('hidden');
        document.getElementById('rejoin-btn').classList.remove('hidden');
        document.getElementById('mute-btn').disabled = true;
    }

    // ── Rejoin after break ────────────────────────────────────────────────────
    function rejoinCall() {
        // Resume local audio
        if (localStream) {
            localStream.getAudioTracks().forEach(t => t.enabled = true);
        }
        isMuted = false;
        const muteBtn = document.getElementById('mute-btn');
        const muteText = document.getElementById('mute-text');
        const micIcon = document.getElementById('mic-icon');
        if (muteBtn) muteBtn.classList.remove('muted');
        if (muteText) muteText.textContent = 'Mute';
        if (micIcon) micIcon.setAttribute('data-lucide', 'mic');
        if (typeof lucide !== 'undefined') lucide.createIcons();

        // Notify peer
        if (socket) socket.emit('rejoin_call', { room_id: ROOM_ID });

        updateStatus('connected', 'Connected');
        document.getElementById('rejoin-btn').classList.add('hidden');
        document.getElementById('break-btn').classList.remove('hidden');
        document.getElementById('mute-btn').disabled = false;
    }

    // ── Red Flag Operations ───────────────────────────────────────────────────
    let preFlagMuted = false;
    let preFlagCamera = false;

    function openRedFlagModal() {
        // 1. Record pre-flag mic and camera states
        preFlagMuted = isMuted;
        preFlagCamera = cameraEnabled;

        // 2. Pause local streams
        if (localStream) {
            localStream.getAudioTracks().forEach(t => t.enabled = false);
            localStream.getVideoTracks().forEach(t => t.enabled = false);
        }

        // 3. Notify peer that we went on break (pauses call)
        if (socket) socket.emit('on_break', { room_id: ROOM_ID });

        // 4. Update status label
        updateStatus('connecting', '⏸ Call is paused');

        // 5. Show modal
        document.getElementById('red-flag-modal').classList.remove('hidden');
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeRedFlagModal() {
        // 1. Hide modal
        document.getElementById('red-flag-modal').classList.add('hidden');

        // 2. Restore mic state
        if (localStream) {
            localStream.getAudioTracks().forEach(t => t.enabled = !preFlagMuted);
        }
        
        // 3. Restore camera state
        if (localStream && preFlagCamera) {
            localStream.getVideoTracks().forEach(t => t.enabled = true);
        }

        // 4. Notify peer that we rejoined
        if (socket) socket.emit('rejoin_call', { room_id: ROOM_ID });

        // 5. Restore status label
        updateStatus('connected', 'Connected');
    }

    async function submitRedFlag(event) {
        event.preventDefault();
        const reason = document.getElementById('red-flag-reason').value;
        if (!reason.trim()) return;

        // Close modal
        document.getElementById('red-flag-modal').classList.add('hidden');

        // Submit red flag to backend
        try {
            await fetch(`/api/appointments/${APPOINTMENT_ID}/red-flag`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason })
            });
        } catch (e) {
            console.error('Failed to submit red flag:', e);
        }

        // Bypasses rating/feedback completely and redirects
        bypassRating = true;

        // End call and exit
        await proceedWithEndCall(true);
    }

    // ── End Call ─────────────────────────────────────────────────────────────
    // ── Exit Reason Modal Operations ──────────────────────────────────────────
    function closeExitModal() {
        document.getElementById('exit-reason-modal').classList.add('hidden');
    }

    async function submitExitReason(event) {
        event.preventDefault();
        const checkedInput = document.querySelector('input[name="exit_reason"]:checked');
        if (!checkedInput) return;
        const reason = checkedInput.value;

        closeExitModal();

        // If patient chose "I wanted a break...", don't prompt them for a rating when they exit
        if (reason === 'I wanted a break will join back again.') {
            bypassRating = true;
        } else {
            bypassRating = false;
        }

        // Call the backend exit-call API
        try {
            await fetch(`/api/appointments/${APPOINTMENT_ID}/exit-call`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason: reason })
            });
        } catch (e) {
            console.error('Failed to report exit reason:', e);
        }

        // Now run the cleanup and redirect (bypassing the complete endpoint check, 
        // since the exit-call endpoint has already handled it)
        await proceedWithEndCall(true);
    }

    // ── End Call ─────────────────────────────────────────────────────────────
    async function endCall() {
        const isConsultant = USER_TYPE === 'consultant';
        const confirmMsg = isConsultant
            ? 'Complete this session? Make sure you have written your consultation notes before ending.'
            : 'Are you sure you want to end the call?';

        if (isConsultant) {
            const notesVal = document.getElementById('consultation-notes').value.trim();
            if (!notesVal) {
                alert('Please write session notes before completing the consultation.');
                return;
            }
        }

        if (!confirm(confirmMsg)) return;

        // Check if exiting before scheduled duration has completed
        const nowMs = new Date().getTime();
        if (nowMs < SCHEDULED_END_MS) {
            // Show exit reason modal
            document.getElementById('exit-reason-modal').classList.remove('hidden');
            return;
        }

        await proceedWithEndCall(false);
    }

    async function proceedWithEndCall(bypassComplete = false) {
        const isConsultant = USER_TYPE === 'consultant';
        if (isConsultant) {
            // Auto-save notes first
            await saveNotes();

            if (!bypassComplete) {
                // Consultant completes the session via the /complete endpoint
                // (enforces that both parties must have joined)
                try {
                    const resp = await fetch(`/api/appointments/${APPOINTMENT_ID}/complete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const result = await resp.json();
                    if (!result.success) {
                        alert('Cannot complete session: ' + result.error);
                        return;
                    }
                } catch (e) {
                    console.warn('Could not call /complete endpoint:', e);
                    // Fallback: mark via status endpoint
                    try {
                        await fetch(`/api/appointments/${APPOINTMENT_ID}/status`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: 'completed' })
                        });
                    } catch (_) { }
                }
            }
        }

        // Stop recorder and upload
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
            isDrawingCanvas = false;
            mediaRecorder.stop();
            mediaRecorder.onstop = async () => {
                const mimeType = isRecordingVideo ? 'video/webm' : 'audio/webm';
                const blob = new Blob(recordedChunks, { type: mimeType });
                await uploadRecording(blob);
                cleanupAndRedirect();
            };
        } else {
            isDrawingCanvas = false;
            cleanupAndRedirect();
        }
    }

    // Upload Recording — called automatically after endCall()
    function uploadRecording(blob) {
        return new Promise((resolve) => {
            if (!blob || blob.size === 0) {
                console.warn('[Recording] Empty blob — skipping upload');
                resolve({ success: false, error: 'Empty blob' });
                return;
            }
            const formData = new FormData();
            formData.append('file', blob, `recording-${APPOINTMENT_ID}.webm`);
            formData.append('appointment_id', APPOINTMENT_ID);

            // Show saving status on end button (safe — call already ended)
            const btn = document.querySelector('.btn-end');
            if (btn) btn.textContent = 'Saving recording (0%)...';

            const xhr = new XMLHttpRequest();
            xhr.open('POST', `/api/calls/${ROOM_ID}/recording`, true);

            xhr.upload.onprogress = (event) => {
                if (event.lengthComputable) {
                    const percentComplete = Math.round((event.loaded / event.total) * 100);
                    if (btn) btn.textContent = `Saving recording (${percentComplete}%)...`;
                }
            };

            xhr.onload = () => {
                if (xhr.status >= 200 && xhr.status < 300) {
                    try {
                        const result = JSON.parse(xhr.responseText);
                        if (result.success) {
                            console.log('[Recording] Uploaded successfully:', result.url);
                            resolve(result);
                        } else {
                            console.warn('[Recording] Upload returned error:', result.error);
                            resolve({ success: false, error: result.error });
                        }
                    } catch (e) {
                        console.error('[Recording] Parse error:', e);
                        resolve({ success: false, error: 'Parse error' });
                    }
                } else {
                    console.error('[Recording] HTTP error:', xhr.statusText);
                    resolve({ success: false, error: xhr.statusText });
                }
            };

            xhr.onerror = (err) => {
                console.error('[Recording] Upload failed:', err);
                resolve({ success: false, error: 'Upload network error' });
            };

            xhr.send(formData);
        });
    }

    function cleanupAndRedirect() {
        // Stop all tracks
        if (localStream) {
            localStream.getTracks().forEach(track => track.stop());
        }

        // Close peer connection
        if (peerConnection) {
            peerConnection.close();
        }

        // Disconnect socket
        if (socket) {
            socket.emit('leave_call', { room_id: ROOM_ID });
            socket.disconnect();
        }

        // Stop timer
        if (timerInterval) {
            clearInterval(timerInterval);
        }

        if (audioContext) {
            audioContext.close();
        }

        // Redirect based on user type
        if (USER_TYPE === 'consultant') {
            window.location.href = '/consultant';
        } else {
            if (bypassRating) {
                window.location.href = '/app';
            } else {
                // Show rating popup for users before redirecting
                showRatingPopup();
            }
        }
    }

    // Update status
    function updateStatus(status, text) {
        const indicator = document.getElementById('status-indicator');
        const statusText = document.getElementById('status-text');

        indicator.className = 'status-indicator';
        indicator.classList.add(`status-${status}`);
        statusText.textContent = text;
    }

    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
        if (localStream) {
            localStream.getTracks().forEach(track => track.stop());
        }
        if (socket) {
            socket.disconnect();
        }
    });

    // Save consultation notes
    async function saveNotes() {
        const notes = document.getElementById('consultation-notes').value;
        const btn = document.getElementById('save-notes-btn');
        const status = document.getElementById('save-status');

        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Saving...';

        try {
            const response = await fetch(`/api/appointments/${APPOINTMENT_ID}/notes`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ notes: notes })
            });

            const data = await response.json();

            if (data.success) {
                status.textContent = 'Notes saved successfully';
                status.classList.remove('opacity-0');
                status.classList.add('text-green-600');
                setTimeout(() => {
                    status.classList.add('opacity-0');
                }, 3000);
            } else {
                status.textContent = 'Error saving notes';
                status.classList.remove('opacity-0');
                status.classList.add('text-red-600');
            }
        } catch (error) {
            console.error('Error saving notes:', error);
            status.textContent = 'Error saving notes';
            status.classList.remove('opacity-0');
            status.classList.add('text-red-600');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Save';
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }
    }

    // Start call timer
    function startCallTimer() {
        callStartTime = Date.now();
        timerInterval = setInterval(() => {
            const elapsed = Math.floor((Date.now() - callStartTime) / 1000);
            const minutes = Math.floor(elapsed / 60);
            const seconds = elapsed % 60;
            document.getElementById('timer').textContent =
                `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }, 1000);
    }

    // --- Modal & History Logic ---

    // History
    function openHistoryModal() {
        document.getElementById('history-modal').classList.remove('hidden');
        loadPatientHistory();
    }

    function closeHistoryModal() {
        document.getElementById('history-modal').classList.add('hidden');
    }

    async function loadPatientHistory() {
        // Use global APPOINTMENT.user_id 
        if (!APPOINTMENT || !APPOINTMENT.user_id) return;

        try {
            const res = await fetch(`/api/patients/${APPOINTMENT.user_id}/history`);
            const data = await res.json();

            if (data.success) {
                document.getElementById('hist-patient-name').textContent = data.patient.name;

                let html = '';

                // Vitals
                html += '<div class="mb-4"><h3 class="font-bold text-gray-800 border-b pb-1 mb-2">Recent Vitals</h3>';
                if (data.vitals.length > 0) {
                    html += '<div class="grid grid-cols-3 gap-2">';
                    data.vitals.forEach(v => {
                        html += `<div class="bg-blue-50 p-2 rounded text-xs">
                            <div class="font-semibold">${v.date}</div>
                            <div>HR: ${v.heart_rate || '--'} bpm</div>
                        </div>`;
                    });
                    html += '</div>';
                } else {
                    html += '<p class="text-sm text-gray-500">No vitals recorded.</p>';
                }
                html += '</div>';

                // Appointments
                html += '<div class="mb-4"><h3 class="font-bold text-gray-800 border-b pb-1 mb-2">Past Interactions</h3>';
                if (data.appointments.length > 0) {
                    data.appointments.forEach(appt => {
                        html += `<div class="mb-2 bg-gray-50 p-3 rounded-lg text-sm border border-gray-100">
                            <div class="flex justify-between font-semibold mb-1">
                                <span>${appt.date}</span>
                                <span class="text-gray-600">${appt.consultant}</span>
                            </div>
                            <p class="text-gray-700">${appt.notes || 'No notes'}</p>
                        </div>`;
                    });
                } else {
                    html += '<p class="text-sm text-gray-500">No previous appointments.</p>';
                }
                html += '</div>';

                // Wellness Summary Reports
                html += '<div class="mb-4"><h3 class="font-bold text-gray-800 border-b pb-1 mb-2">Past Wellness Summary Reports</h3>';
                if (data.prescriptions.length > 0) {
                    data.prescriptions.forEach(rx => {
                        html += `<div class="mb-2 bg-green-50 p-3 rounded-lg text-sm border border-green-100">
                            <div class="font-semibold mb-1 text-green-800">${rx.date}</div>
                            <div class="mb-1 text-gray-600"><span class="font-medium">Diagnosis:</span> ${rx.diagnosis || '--'}</div>
                            <div class="text-gray-700"><span class="font-medium">Meds:</span> ${rx.medications.join(', ')}</div>
                        </div>`;
                    });
                } else {
                    html += '<p class="text-sm text-gray-500">No past prescriptions.</p>';
                }
                html += '</div>';

                document.getElementById('history-content').innerHTML = html;
            } else {
                document.getElementById('history-content').innerHTML = `<p class="text-red-500">Error: ${data.error}</p>`;
            }
        } catch (e) {
            console.error(e);
            document.getElementById('history-content').innerHTML = '<p class="text-red-500">Failed to load history.</p>';
        }
    }


</script>

<!-- ═══════════════════════════════════════════════════════════
     POST-CALL RATING POPUP
═══════════════════════════════════════════════════════════ -->
<div id="ratingOverlay" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden">
    <div id="ratingCard" class="bg-white rounded-3xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
        <div class="bg-gradient-to-br from-violet-600 via-purple-600 to-pink-500 p-6 text-white text-center">
            <div class="text-4xl mb-2">⭐</div>
            <h2 class="text-xl font-bold">How was your session?</h2>
            <p class="text-purple-100 text-sm mt-1">Your feedback helps improve our consultants</p>
        </div>
        <div class="p-6">
            <!-- Star Rating -->
            <div class="flex justify-center gap-2 mb-4" id="starContainer">
                <button class="star-btn text-4xl text-gray-300 hover:text-yellow-400 transition-colors" data-star="1"
                    onclick="selectStar(1)">★</button>
                <button class="star-btn text-4xl text-gray-300 hover:text-yellow-400 transition-colors" data-star="2"
                    onclick="selectStar(2)">★</button>
                <button class="star-btn text-4xl text-gray-300 hover:text-yellow-400 transition-colors" data-star="3"
                    onclick="selectStar(3)">★</button>
                <button class="star-btn text-4xl text-gray-300 hover:text-yellow-400 transition-colors" data-star="4"
                    onclick="selectStar(4)">★</button>
                <button class="star-btn text-4xl text-gray-300 hover:text-yellow-400 transition-colors" data-star="5"
                    onclick="selectStar(5)">★</button>
            </div>
            <p class="text-center text-sm text-gray-500 mb-4" id="ratingLabel">Tap a star to rate</p>

            <!-- Optional feedback -->
            <textarea id="ratingFeedback" placeholder="Any comments? (optional)" rows="2"
                class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm resize-none focus:ring-2 focus:ring-purple-400 focus:border-purple-400 mb-3"></textarea>

            <!-- Anonymous / Named Toggle -->
            <div class="mb-4">
                <p class="text-xs text-gray-500 mb-2 text-center">Post feedback as:</p>
                <div class="flex gap-2 justify-center">
                    <button id="pill-named" onclick="toggleAnonymous(false)"
                        class="px-4 py-1.5 rounded-full text-xs font-semibold transition-all bg-purple-600 text-white">
                        Your Name
                    </button>
                    <button id="pill-anon" onclick="toggleAnonymous(true)"
                        class="px-4 py-1.5 rounded-full text-xs font-semibold transition-all bg-gray-100 text-gray-600">
                        Anonymous
                    </button>
                </div>
                <p id="anonPreview" class="text-center text-xs text-gray-400 mt-1">Will post as: {{ user.name }}</p>
            </div>

            <button onclick="submitRating()" id="submitRatingBtn"
                class="w-full bg-gradient-to-r from-violet-600 to-purple-600 text-white font-semibold py-3 rounded-xl hover:opacity-90 transition-opacity mb-2 disabled:opacity-50"
                disabled>
                Submit Rating
            </button>
            <button onclick="skipRating()" class="w-full text-sm text-gray-400 hover:text-gray-600 py-1">
                Skip
            </button>
        </div>
    </div>
</div>

<script>
    var selectedRating = 0;
    var ratingIsAnonymous = false;
    var ratingLabels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
    // USER_NAME is already declared above as a const from the template

    function showRatingPopup() {
        fetch('/api/appointments/' + APPOINTMENT_ID + '/rating-status')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.rated) {
                    window.location.href = '/app';
                } else {
                    document.getElementById('ratingOverlay').classList.remove('hidden');
                }
            })
            .catch(function () {
                document.getElementById('ratingOverlay').classList.remove('hidden');
            });
    }

    function selectStar(star) {
        selectedRating = star;
        document.querySelectorAll('.star-btn').forEach(function (btn) {
            var s = parseInt(btn.getAttribute('data-star'));
            btn.style.color = s <= star ? '#f59e0b' : '#d1d5db';
        });
        document.getElementById('ratingLabel').textContent = ratingLabels[star] + ' (' + star + '/5)';
        document.getElementById('submitRatingBtn').disabled = false;
    }

    function toggleAnonymous(makeAnon) {
        ratingIsAnonymous = makeAnon;
        var namedPill = document.getElementById('pill-named');
        var anonPill = document.getElementById('pill-anon');
        if (makeAnon) {
            anonPill.classList.remove('bg-gray-100', 'text-gray-600');
            anonPill.classList.add('bg-purple-600', 'text-white');
            namedPill.classList.remove('bg-purple-600', 'text-white');
            namedPill.classList.add('bg-gray-100', 'text-gray-600');
            document.getElementById('anonPreview').textContent = 'Will post as: Anonymous User';
        } else {
            namedPill.classList.remove('bg-gray-100', 'text-gray-600');
            namedPill.classList.add('bg-purple-600', 'text-white');
            anonPill.classList.remove('bg-purple-600', 'text-white');
            anonPill.classList.add('bg-gray-100', 'text-gray-600');
            document.getElementById('anonPreview').textContent = 'Will post as: ' + USER_NAME;
        }
    }

    function submitRating() {
        if (!selectedRating) return;
        var btn = document.getElementById('submitRatingBtn');
        btn.disabled = true;
        btn.textContent = 'Saving…';

        var feedback = document.getElementById('ratingFeedback').value.trim();
        var displayName = ratingIsAnonymous ? 'Anonymous User' : USER_NAME;

        fetch('/api/appointments/' + APPOINTMENT_ID + '/rate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                rating: selectedRating,
                feedback: feedback,
                is_anonymous: ratingIsAnonymous,
                display_name: displayName
            })
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.success) {
                    document.getElementById('ratingCard').innerHTML = '<div class="p-8 text-center"><div class="text-5xl mb-4">🙏</div><h2 class="text-xl font-bold text-gray-900 mb-2">Thank you!</h2><p class="text-gray-600 text-sm">Your feedback has been saved.</p></div>';
                    setTimeout(function () { window.location.href = '/app'; }, 1800);
                } else {
                    window.location.href = '/app';
                }
            })
            .catch(function () {
                window.location.href = '/app';
            });
    }

    function skipRating() {
        window.location.href = '/app';
    }
</script>
