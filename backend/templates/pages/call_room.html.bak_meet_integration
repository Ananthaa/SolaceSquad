                PRE_START_VIDEO = true;
            } catch (err) {
                console.error('[Lobby] Camera access failed:', err);
                alert('Could not access camera: ' + err.message);
            }
        } else {
            if (lobbyStream) {
                lobbyStream.getVideoTracks().forEach(t => { t.stop(); lobbyStream.removeTrack(t); });
            }
            videoEl.srcObject = null;
            videoEl.classList.add('hidden');
            avatarEl.classList.remove('hidden');
            btn.classList.remove('bg-blue-600');
            btn.classList.add('bg-slate-800/90');
            icon.setAttribute('data-lucide', 'video-off');
