<!-- 5-Minute Warning Banner -->
<div id="warning-banner" role="alert" aria-live="assertive">
    <span class="warn-pulse"></span>
    <span id="warning-banner-text">⏰ 5 minutes remaining in this session</span>
    <button class="dismiss-btn" onclick="dismissWarning()">Dismiss</button>
</div>

<!-- WebRTC & Socket.IO Logic -->
<script>

    const ROOM_ID = '{{ call_session.room_id }}';
    const USER_TYPE = '{{ user.user_type }}';
    const USER_NAME = {{ user.name | tojson }};
    const APPOINTMENT_ID = {{ appointment.id }};
    const DURATION_MINUTES = {{ appointment.duration_minutes }};
    const CONSENT_TO_RECORD = {{ 'true' if consent_to_record_allowed else 'false' }};
    let bypassRating = false;

    // Scheduled end time for 5-min warning
    const SCHEDULED_START_MS = new Date('{{ appointment.appointment_date.strftime("%Y-%m-%dT%H:%M:%SZ") }}').getTime();
    const SCHEDULED_END_MS = SCHEDULED_START_MS + (DURATION_MINUTES * 60 * 1000);

    const APPOINTMENT = {
        id: {{ appointment.id }},
    user_id: {{ appointment.user_id }}
    };


    // WebRTC ICE configuration — fetched from backend (supports Metered.ca API keys)
    // Fallback hardcoded in case the fetch fails
    let ICE_SERVERS = {
        iceServers: [
            { urls: 'stun:stun.l.google.com:19302' },
            { urls: 'stun:stun1.l.google.com:19302' },
        ],
        iceCandidatePoolSize: 10
    };

    async function fetchIceServers() {
        try {
            const resp = await fetch('/api/call/ice-servers');
            const data = await resp.json();
            if (data.iceServers && data.iceServers.length > 0) {
                ICE_SERVERS = { iceServers: data.iceServers, iceCandidatePoolSize: 10 };
                console.log('[ICE] Fetched', data.iceServers.length, 'servers from backend');
            }
        } catch(e) {
            console.warn('[ICE] Could not fetch ICE config, using fallback:', e);
        }
    }

    // Global variables
    let socket;
    let peerConnection;
    let localStream;
    let videoTrack = null;    // local camera track (null = camera off)
    let videoSender = null;   // RTCRtpSender for the video track
    
    // Lobby State Variables
    let lobbyStream = null;
    let lobbyAudioContext = null;
    let lobbyAnalyser = null;
    let lobbyMicMuted = false;
    let lobbyCamMuted = true;
    let selectedMicId = null;
    let selectedCameraId = null;
    let PRE_START_VIDEO = false;
    let PRE_START_MIC_MUTED = false;
    let cameraEnabled = false;
    let pendingCandidates = []; // ICE candidates buffered until remoteDescription is set
    let isMuted = false;
    let callStartTime;
    let timerInterval;
    let vitalsChart = null;
    let moodChart = null;
    let endWatcherTimeout = null;    // handle for the 5-min warning timer
    let warningDismissed = false;    // prevent re-showing after dismiss
    let iceRestartAttempts = 0;      // track ICE restart retries (max 3)

    // ── 5-Minute End-Time Warning ─────────────────────────────────────────
    function startEndTimeWatcher() {
        if (endWatcherTimeout) return; // already running

        const now = Date.now();
        const FIVE_MIN_MS = 5 * 60 * 1000;
        const warnAt = SCHEDULED_END_MS - FIVE_MIN_MS; // fire at T-5 min

        if (now >= SCHEDULED_END_MS) return; // session already over

        const delay = Math.max(0, warnAt - now);

        endWatcherTimeout = setTimeout(function () {
            // Only show if call is still active (not on break / ended)
            if (!warningDismissed) {
                showWarningBanner();
            }
        }, delay);

        // Also set up a countdown refresh every 30 s once visible
        if (now >= warnAt) {
            // Already inside the 5-min window when page was loaded
            showWarningBanner();
        }
    }

    function showWarningBanner() {
        const banner = document.getElementById('warning-banner');
        if (!banner || warningDismissed) return;

        banner.classList.add('visible');

        // Live countdown text
        function updateCountdown() {
            const remaining = Math.max(0, SCHEDULED_END_MS - Date.now());
            const mins = Math.floor(remaining / 60000);
            const secs = Math.floor((remaining % 60000) / 1000);
            const text = document.getElementById('warning-banner-text');
            if (text) {
                if (remaining <= 0) {
                    text.textContent = '⏰ Scheduled session time has ended';
                } else {
                    text.textContent = `⏰ ${mins}:${secs.toString().padStart(2, '0')} remaining in this session`;
                }
            }
        }

        updateCountdown();
        const cdInterval = setInterval(function () {
            if (warningDismissed) { clearInterval(cdInterval); return; }
            updateCountdown();
            if (Date.now() >= SCHEDULED_END_MS) clearInterval(cdInterval);
        }, 1000);

        // Play a subtle beep if the browser supports it
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.frequency.value = 880;
            osc.type = 'sine';
            gain.gain.setValueAtTime(0.15, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.0);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 1.0);
        } catch (_) { } // audio not available — silent fallback
    }

    function dismissWarning() {
        warningDismissed = true;
        const banner = document.getElementById('warning-banner');
        if (banner) banner.classList.remove('visible');
    }

    // Initialize on page load
    window.addEventListener('DOMContentLoaded', async function () {
        // Load patient health data if consultant
        if (USER_TYPE === 'consultant') {
            loadPatientHealthData();
        }

        // Show lobby overlay (ensure it's visible)
        const lobbyOverlay = document.getElementById('lobby-overlay');
        if (lobbyOverlay) {
            lobbyOverlay.classList.remove('hidden');
        }

        if (typeof lucide !== 'undefined') lucide.createIcons();
        
        // Start lobby preflight check and device enumeration
        runPreflightChecks();
    });

    // Lobby Preflight Logic
    async function runPreflightChecks() {
        await populateLobbyDevices();

        // Start testing with microphone
        try {
            const constraints = { audio: true, video: false };
            lobbyStream = await navigator.mediaDevices.getUserMedia(constraints);
            
            // Re-enumerate to get device labels now that permission is granted
            await populateLobbyDevices();
            
            // Start audio level meter
            startLobbyAudioVisualizer(lobbyStream);
        } catch (e) {
            console.error('[Lobby] Microphone access failed:', e);
            const checkMicText = document.getElementById('lobby-mic-select');
            if (checkMicText) {
                const opt = document.createElement('option');
                opt.text = '⚠️ Microphone blocked/disabled';
                checkMicText.appendChild(opt);
                checkMicText.disabled = true;
            }
        }
    }

    async function populateLobbyDevices() {
        const micSelect = document.getElementById('lobby-mic-select');
        const camSelect = document.getElementById('lobby-camera-select');
        if (!micSelect || !camSelect) return;

        try {
            const devices = await navigator.mediaDevices.enumerateDevices();
            micSelect.innerHTML = '';
            camSelect.innerHTML = '';

            let micCount = 0;
            let camCount = 0;

            devices.forEach(device => {
                const option = document.createElement('option');
                option.value = device.deviceId;

                if (device.kind === 'audioinput') {
                    option.text = device.label || `Microphone ${++micCount}`;
                    if (selectedMicId === device.deviceId) option.selected = true;
                    micSelect.appendChild(option);
                } else if (device.kind === 'videoinput') {
                    option.text = device.label || `Camera ${++camCount}`;
                    if (selectedCameraId === device.deviceId) option.selected = true;
                    camSelect.appendChild(option);
                }
            });

            if (micSelect.options.length === 0) {
                const opt = document.createElement('option');
