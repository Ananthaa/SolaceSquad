@app.post("/api/appointments/{appointment_id}/rate")
async def rate_consultant(appointment_id: int, request: Request, db: Session = Depends(get_db)):
    """Submit a star rating for a consultant after a call."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)

    try:
        data = await request.json()
        rating_value = float(data.get("rating", 0))
        feedback = data.get("feedback", "")

        if not (1.0 <= rating_value <= 5.0):
            return JSONResponse({"success": False, "error": "Rating must be between 1 and 5"}, status_code=400)

        # Verify appointment belongs to this user
        appointment = db.query(Appointment).filter(
            Appointment.id == appointment_id,
            Appointment.user_id == user_id
        ).first()
        if not appointment:
            return JSONResponse({"success": False, "error": "Appointment not found"}, status_code=404)

        # Check if already rated
        existing = db.query(ConsultantRating).filter(
            ConsultantRating.appointment_id == appointment_id
        ).first()
        if existing:
            return JSONResponse({"success": False, "error": "Already rated"}, status_code=400)

        # Save rating
        rating_entry = ConsultantRating(
            appointment_id=appointment_id,
            consultant_id=appointment.consultant_id,
            user_id=user_id,
            rating=rating_value,
            feedback=feedback
        )
        db.add(rating_entry)

        # Recompute consultant's average rating
        all_ratings = db.query(ConsultantRating).filter(
            ConsultantRating.consultant_id == appointment.consultant_id
        ).all()
        # Include the new one
        total = sum(r.rating for r in all_ratings) + rating_value
        count = len(all_ratings) + 1
        new_avg = round(total / count, 2)

        consultant = db.query(ConsultantProfile).filter(
            ConsultantProfile.id == appointment.consultant_id
        ).first()
        if consultant:
            consultant.rating = new_avg

        db.commit()
        return JSONResponse({"success": True, "new_avg_rating": new_avg})
    except Exception as e:
        db.rollback()
        import traceback
        print(f"Rating error: {traceback.format_exc()}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


