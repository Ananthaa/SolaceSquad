# â”€â”€ Shared helper: generate bio via Gemini â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async def _auto_generate_bio(profile) -> str | None:
    """
    Generate a professional bio from the consultant's profile + CV using Gemini.
    Returns the bio string on success, or None on failure.
    Called automatically on profile save and also by the manual /generate-summary endpoint.
    """
    import io, json as _json, os
    import requests as _req
    import vertexai as _vertexai
    from vertexai.generative_models import GenerativeModel as _VXModel

    # Extract CV text â€” detect format by CONTENT magic bytes, not URL extension
    cv_text = ""
    if profile.cv_url:
        try:
            resp = _req.get(profile.cv_url, timeout=10)
            if resp.status_code == 200:
                data = resp.content
                # Magic byte detection: PDF = %PDF, DOCX/ZIP = PK
                if data[:4] == b'%PDF':
                    import PyPDF2
                    reader = PyPDF2.PdfReader(io.BytesIO(data))
                    pages_text = [page.extract_text() or "" for page in reader.pages[:4]]
                    cv_text = "\n".join(pages_text)[:2000]
                    print(f"[Bio] PDF extracted: {len(cv_text)} chars")
                elif data[:2] == b'PK':
                    import docx as _docx
                    doc = _docx.Document(io.BytesIO(data))
                    paras = [p.text for p in doc.paragraphs if p.text.strip()]
                    cv_text = "\n".join(paras)[:2000]
                    print(f"[Bio] DOCX extracted: {len(cv_text)} chars")
                else:
                    print(f"[Bio] Unknown file format, magic: {data[:4]!r}")
            else:
                print(f"[Bio] CV download failed: HTTP {resp.status_code}")
        except Exception as cv_err:
            print(f"[Bio] CV read error ({profile.cv_url[-40:]}): {cv_err}")

    def safe_list(field):
        if not field:
            return ""
        try:
            items = _json.loads(field)
            return ", ".join(items) if isinstance(items, list) else str(field)
        except Exception:
            return str(field)

    expertise = safe_list(profile.expertise_areas)
    methods   = safe_list(profile.counselling_methods)
    languages = safe_list(profile.languages)

    # Build prompt â€” CV is the PRIMARY source when available
    if cv_text:
        prompt = f"""You are writing a professional third-person bio for a wellness consultant's profile page.
Use the consultant's CV as your PRIMARY source. Write 120-160 words of flowing prose (no bullet points).
Be specific â€” mention the consultant's actual background, qualifications, and focus areas as found in the CV.
Tone: warm, credible, authoritative. Do NOT invent anything not in the CV or profile data.

=== CV (primary source) ===
{cv_text}

=== Profile data (use to fill any gaps) ===
Name: {profile.full_name or 'the consultant'}
Specialization: {profile.specialization or ''}
Experience: {profile.experience_years or 0} years
Expertise: {expertise}
Approaches: {methods}
Languages: {languages}
Location: {profile.city or ''}
QACP Certified: {'Yes' if profile.qacp_certified else 'No'}"""
    else:
        prompt = f"""Write a professional third-person bio for a wellness consultant profile.
120-160 words, flowing prose, no bullet points. Tone: warm, credible, authoritative.
Do not invent facts not present in the data below.

Name: {profile.full_name or 'the consultant'}
Specialization: {profile.specialization or ''}
Clinical experience: {profile.clinical_experience or ''} ({profile.experience_years or 0} years)
Highest qualification: {profile.highest_qualification or ''} â€” Education: {profile.education or ''}
Expertise: {expertise}
Approaches: {methods}
Serves: {profile.target_audience or ''}
Languages: {languages}
Location: {profile.city or ''}
QACP Certified: {'Yes' if profile.qacp_certified else 'No'}"""

    try:
        _gcp_project  = os.getenv("GCP_PROJECT_ID", "abiding-idea-485817-k2")
        _gcp_location = os.getenv("GCP_LOCATION",   "us-central1")
        _vertexai.init(project=_gcp_project, location=_gcp_location)
        _bio_model = _VXModel("gemini-2.0-flash-001")
        response = _bio_model.generate_content(
            prompt,
            generation_config={
                "max_output_tokens": 400,
                "temperature": 0.4,
            }
        )
        return response.text.strip()
    except Exception as e:
        import traceback, sys
        traceback.print_exc()
        print(f"[Bio] Vertex AI error: {type(e).__name__}: {e}", file=sys.stderr)
        raise  # Re-raise so batch handler shows the real error message


