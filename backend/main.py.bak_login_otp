@app.get("/api/messages/conversations")
async def get_conversations(request: Request, db: Session = Depends(get_db)):
    """
    Returns the list of conversation partners for the logged-in user.
    - Regular users: only consultants they've had (or have upcoming) appointments with.
    - Consultants: all users who have messaged them or who have appointments with them.
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)

    user_type = request.session.get("user_type", "user")
    if user_type == "user":
        from subscription_routes import get_active_subscription
        sub = get_active_subscription(user_id, db)
        if not sub or not sub.plan or sub.plan.is_free:
            return JSONResponse({"success": False, "error": "Messaging is only available on the White plan and above."}, status_code=403)

    try:
        if user_type == "user":
            uid = int(user_id)  # ensure int for DB comparisons

            # â”€â”€ Source 1: Appointments (consultant_id â†’ consultant_profiles.id) â”€â”€
            consultant_profile_ids = (
                db.query(Appointment.consultant_id)
                .filter(Appointment.user_id == uid)
                .distinct()
                .all()
            )
            c_profile_ids = [r[0] for r in consultant_profile_ids]

            eligible_consultant_user_ids = set()
            if c_profile_ids:
                profiles = (
                    db.query(ConsultantProfile)
                    .filter(ConsultantProfile.id.in_(c_profile_ids))
                    .all()
                )
                eligible_consultant_user_ids = {p.user_id for p in profiles}

            # â”€â”€ Source 2: Call sessions (consultant_id is directly users.id) â”€â”€â”€â”€â”€
            call_consultant_ids = (
                db.query(CallSession.consultant_id)
                .filter(CallSession.user_id == uid)
                .distinct()
                .all()
            )
            for (cid,) in call_consultant_ids:
                eligible_consultant_user_ids.add(cid)

            # â”€â”€ Source 3: Existing messages already exchanged (graceful fallback) â”€â”€
            messaged_partner_ids = set()
            try:
                for msg in (
                    db.query(Message)
                    .filter(
                        (Message.sender_id == uid) | (Message.receiver_id == uid)
                    )
                    .all()
                ):
                    other = msg.receiver_id if msg.sender_id == uid else msg.sender_id
                    messaged_partner_ids.add(other)
            except Exception as _msg_err:
                print(f"[WARN] messages table query failed (may not exist yet): {_msg_err}")
                db.rollback()

            all_partner_ids = list(eligible_consultant_user_ids | messaged_partner_ids)

            # â”€â”€ Build conversation summaries â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            conversations = []
            for pid in all_partner_ids:
                partner = db.query(User).filter(User.id == pid).first()
                if not partner:
                    continue

                # Latest message in this thread (graceful fallback if table missing)
                latest_msg = None
                unread_count = 0
                try:
                    latest_msg = (
                        db.query(Message)
                        .filter(
                            ((Message.sender_id == uid) & (Message.receiver_id == pid))
                            | ((Message.sender_id == pid) & (Message.receiver_id == uid))
                        )
                        .order_by(Message.timestamp.desc())
                        .first()
                    )
                    unread_count = (
                        db.query(Message)
                        .filter(
                            Message.sender_id == pid,
                            Message.receiver_id == uid,
                            Message.is_read == False,
                        )
                        .count()
                    )
                except Exception as _m:
                    print(f"[WARN] message thread query failed: {_m}")
                    db.rollback()

                conversations.append({
                    "partner_id": pid,
                    "partner_name": partner.name,
                    "latest_message": latest_msg.content[:80] if latest_msg else "Start a conversation",
                    "latest_timestamp": latest_msg.timestamp.isoformat() if latest_msg else None,
                    "unread_count": unread_count,
                })

            # Sort by latest message time (newest first), then alphabetically
            conversations.sort(
                key=lambda c: c["latest_timestamp"] or "0000",
                reverse=True,
            )

        else:
            # â”€â”€ Consultant view: all clients who have appointments, call sessions, or messages â”€â”€
            uid = int(user_id)
            consultant_profile = (
                db.query(ConsultantProfile)
                .filter(ConsultantProfile.user_id == uid)
                .first()
            )

            client_ids_from_appointments = set()
            if consultant_profile:
                rows = (
                    db.query(Appointment.user_id)
                    .filter(Appointment.consultant_id == consultant_profile.id)
                    .distinct()
                    .all()
                )
                client_ids_from_appointments = {r[0] for r in rows}

            # Also include clients from call sessions
            call_client_rows = (
                db.query(CallSession.user_id)
                .filter(CallSession.consultant_id == uid)
                .distinct()
                .all()
            )
            for (cuid,) in call_client_rows:
                client_ids_from_appointments.add(cuid)

            messaged_partner_ids = set()
            for msg in (
                db.query(Message)
                .filter(
                    (Message.sender_id == user_id) | (Message.receiver_id == user_id)
                )
                .all()
            ):
                other = msg.receiver_id if msg.sender_id == user_id else msg.sender_id
                messaged_partner_ids.add(other)

            all_partner_ids = list(client_ids_from_appointments | messaged_partner_ids)

            conversations = []
            for pid in all_partner_ids:
                partner = db.query(User).filter(User.id == pid).first()
                if not partner:
                    continue

                latest_msg = (
                    db.query(Message)
                    .filter(
                        ((Message.sender_id == user_id) & (Message.receiver_id == pid))
                        | ((Message.sender_id == pid) & (Message.receiver_id == user_id))
                    )
                    .order_by(Message.timestamp.desc())
                    .first()
                )

                unread_count = (
                    db.query(Message)
                    .filter(
                        Message.sender_id == pid,
                        Message.receiver_id == user_id,
                        Message.is_read == False,
                    )
                    .count()
                )

                conversations.append({
                    "partner_id": pid,
                    "partner_name": partner.name,
                    "latest_message": latest_msg.content[:80] if latest_msg else "Start a conversation",
                    "latest_timestamp": latest_msg.timestamp.isoformat() if latest_msg else None,
                    "unread_count": unread_count,
                })

            conversations.sort(
                key=lambda c: c["latest_timestamp"] or "0000",
                reverse=True,
            )

        return JSONResponse({"success": True, "conversations": conversations})

    except Exception as e:
        print(f"[ERROR] get_conversations: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


