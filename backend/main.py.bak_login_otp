                ("razorpay_payment_id on user_subscriptions",
                 "ALTER TABLE user_subscriptions ADD COLUMN IF NOT EXISTS razorpay_payment_id VARCHAR(100)"),
                ("payment_status on user_subscriptions",
                 "ALTER TABLE user_subscriptions ADD COLUMN IF NOT EXISTS payment_status VARCHAR(30)"),
                ("widen month_key on feature_usage_logs",
                 "ALTER TABLE feature_usage_logs ALTER COLUMN month_key TYPE VARCHAR(25)"),
                ("widen month_key on feature_usage_top_ups",
                 "ALTER TABLE feature_usage_top_ups ALTER COLUMN month_key TYPE VARCHAR(25)"),
                ("wellness_category on consultant_profiles",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS wellness_category VARCHAR(20) DEFAULT NULL"),
                ("reschedule_free on appointments",
                 "ALTER TABLE appointments ADD COLUMN IF NOT EXISTS reschedule_free BOOLEAN DEFAULT FALSE"),
                ("refund_status on appointments",
                 "ALTER TABLE appointments ADD COLUMN IF NOT EXISTS refund_status VARCHAR(50)"),
            ]

            # Migrations that require superuser (postgres) - run separately
            _pg_migrations = [
                ("grant Admin on consultant_profiles",
                 'GRANT ALL PRIVILEGES ON TABLE consultant_profiles TO "Admin"'),
                ("wellness_category on consultant_profiles (pg)",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS wellness_category VARCHAR(20) DEFAULT NULL"),
                ("bank_account_name on consultant_profiles (pg)",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS bank_account_name VARCHAR(255)"),
                ("bank_account_number on consultant_profiles (pg)",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS bank_account_number VARCHAR(50)"),
                ("bank_ifsc on consultant_profiles (pg)",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS bank_ifsc VARCHAR(20)"),
                ("bank_name on consultant_profiles (pg)",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS bank_name VARCHAR(100)"),
                ("upi_id on consultant_profiles (pg)",
                 "ALTER TABLE consultant_profiles ADD COLUMN IF NOT EXISTS upi_id VARCHAR(100)"),
                ("reschedule_free on appointments (pg)",
                 "ALTER TABLE appointments ADD COLUMN IF NOT EXISTS reschedule_free BOOLEAN DEFAULT FALSE"),
                ("refund_status on appointments (pg)",
                 "ALTER TABLE appointments ADD COLUMN IF NOT EXISTS refund_status VARCHAR(50)"),
            ]

            # Open a direct psycopg2 connection - NOT from SQLAlchemy pool
            _direct = _pg2.connect(
                user=_db_user, password=_db_pass, dbname=_db_name, host=_host
            )
            _direct.autocommit = True  # Each statement is fully independent
            _dcur = _direct.cursor()

            # Also open a postgres superuser connection for tables not owned by Admin
            try:
                _direct_pg = _pg2.connect(
                    user="postgres", password=_db_pass, dbname=_db_name, host=_host
                )
                _direct_pg.autocommit = True
                _dcur_pg = _direct_pg.cursor()
            except Exception as _pge:
                _direct_pg = None
                _dcur_pg = None
                print(f"[DDL-WARN] postgres fallback connection failed: {_pge}")

            for _label, _sql in _migrations:
                try:
                    _dcur.execute(_sql)
                    print(f"[DDL-OK] {_label}")
                except Exception as _e:
                    if "must be owner" in str(_e) and _dcur_pg:
                        try:
                            _dcur_pg.execute(_sql)
                            print(f"[DDL-OK-PG] {_label}")
                        except Exception as _e2:
                            print(f"[DDL-SKIP] {_label}: {_e2}")
                    else:
                        print(f"[DDL-SKIP] {_label}: {_e}")

            # Run pg-only migrations (require superuser)
            if _dcur_pg:
                for _label, _sql in _pg_migrations:
                    try:
                        _dcur_pg.execute(_sql)
                        print(f"[DDL-OK-PG] {_label}")
                    except Exception as _e:
                        print(f"[DDL-SKIP-PG] {_label}: {_e}")
            else:
                print("[DDL-WARN] postgres connection unavailable - skipping pg_migrations")
            _dcur.close()
            _direct.close()  # Truly closed, not returned to pool
            if _dcur_pg:
                _dcur_pg.close()
                _direct_pg.close()
            print("[OK] Startup DDL migrations complete")

            # Auto-classify consultants from onboarding data
            try:
                from consultant_classifier import bulk_classify
                _cdb = next(get_db())
                _n = bulk_classify(_cdb)
                _cdb.close()
                print(f"[OK] Auto-classified {_n} consultant(s)" if _n else "[OK] All consultants already classified")
            except Exception as _ce:
                print(f"[WARN] Auto-classify skipped: {_ce}")

            # Consolidate week1 usage keys so the Emora message counter never resets
            # across sessions.  This is idempotent — safe to run on every startup.
            try:
                import fix_week1_keys as _fwk
                _fwk.run()
