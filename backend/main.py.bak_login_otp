@app.post("/api/auth/email-otp/send")
async def send_email_otp_route(request: Request, db: Session = Depends(get_db)):
    """Generate and email a 6-digit OTP to verify the signup email address."""
    try:
        data = await request.json()
        email = (data.get("email") or "").strip().lower()
        name  = (data.get("name")  or "there").strip()

        if not email or "@" not in email:
            return {"success": False, "error": "Valid email is required"}

        # Check if email is already registered
        existing = db.query(User).filter(User.email == email).first()
        if existing:
            requested_role = (data.get("role") or "user").strip().lower()
            if existing.user_type != requested_role:
                existing_label = "Wellbeing Consultant" if existing.user_type == "consultant" else "User"
                return {
                    "success": False,
                    "code": "ROLE_MISMATCH",
                    "existing_role": existing.user_type,
                    "error": (
                        f"This email is already registered as a {existing_label}. "
                        f"Please sign in to your {existing_label} account instead."
                    )
                }
            # Inactive (rejected) accounts are allowed to re-register â€” let OTP through
            if existing.is_active:
                return {"success": False, "code": "LOGIN_EXISTING",
                        "error": "This email is already registered. Please log in."}
            # else: inactive/rejected â€” fall through and send OTP normally

        # Generate cryptographically secure 6-digit OTP
        import secrets as _sec
        otp = "".join(str(_sec.randbelow(10)) for _ in range(6))

        # Invalidate any old email OTP for this address, then store new one
        db.query(OTPVerification).filter(OTPVerification.otp_email == email).delete()
        db.add(OTPVerification(
            otp_email=email,
            otp_code=otp,
            expires_at=datetime.utcnow() + timedelta(minutes=10),
        ))
        db.commit()

        # Send email (non-blocking failure is fine â€” log and continue)
        sent = send_email_otp(email, name, otp)
        if not sent:
            import sys
            print(f"[EMAIL-OTP] âš ï¸ SendGrid failed â€” OTP for {email}: {otp}", file=sys.stderr, flush=True)

        return {"success": True, "email_sent": sent}

    except Exception as exc:
        import traceback; traceback.print_exc()
        return {"success": False, "error": "Server error. Please try again."}


