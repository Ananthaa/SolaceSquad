@app.post("/api/messages/send")
async def send_message(request: Request, db: Session = Depends(get_db)):
    """
    Send a message from the logged-in user to receiver_id.
    Rejects messages containing phone numbers or email addresses.
    For users, the receiver must be a consultant they've had an appointment with
    (or who has already messaged them).
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)

    user_type = request.session.get("user_type", "user")
    if user_type == "user":
        from subscription_routes import get_active_subscription
        sub = get_active_subscription(user_id, db)
        if not sub or not sub.plan or sub.plan.is_free:
            return JSONResponse({"success": False, "error": "Messaging is only available on the White plan and above."}, status_code=403)

    try:
        body = await request.json()
        receiver_id = int(body.get("receiver_id", 0))
        content = (body.get("content", "") or "").strip()

        if not content:
            return JSONResponse({"success": False, "error": "Message cannot be empty."}, status_code=400)

        if len(content) > 2000:
            return JSONResponse({"success": False, "error": "Message too long (max 2000 characters)."}, status_code=400)

        # â”€â”€ PII filter: block phone numbers and email addresses â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if _contains_pii(content):
            return JSONResponse(
                {
                    "success": False,
                    "error": (
                        "For safety, sharing phone numbers or email addresses in messages "
                        "is not allowed. Please keep communication on this platform."
                    ),
                },
                status_code=400,
            )

        # â”€â”€ Verify receiver exists â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        receiver = db.query(User).filter(User.id == receiver_id).first()
        if not receiver:
            return JSONResponse({"success": False, "error": "Recipient not found."}, status_code=404)

        # â”€â”€ Access control for regular users â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        user_type = request.session.get("user_type", "user")
        if user_type == "user":
            # Receiver must be a consultant the user has an appointment with,
            # OR must have already messaged this user.
            receiver_profile = db.query(ConsultantProfile).filter(
                ConsultantProfile.user_id == receiver_id
            ).first()

            if receiver_profile:
                has_appointment = (
                    db.query(Appointment)
                    .filter(
                        Appointment.user_id == user_id,
                        Appointment.consultant_id == receiver_profile.id,
                    )
                    .first()
                )
            else:
                has_appointment = None

            existing_thread = (
                db.query(Message)
                .filter(
                    ((Message.sender_id == user_id) & (Message.receiver_id == receiver_id))
                    | ((Message.sender_id == receiver_id) & (Message.receiver_id == user_id))
                )
                .first()
            )

            if not has_appointment and not existing_thread:
                return JSONResponse(
                    {
                        "success": False,
                        "error": "You can only message consultants you've had sessions with.",
                    },
                    status_code=403,
                )

        # â”€â”€ Save message â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        new_msg = Message(
            sender_id=user_id,
            receiver_id=receiver_id,
            content=content,
            timestamp=datetime.utcnow(),
            is_read=False,
        )
        db.add(new_msg)
        db.commit()
        db.refresh(new_msg)

        return JSONResponse({
            "success": True,
            "message": {
                "id": new_msg.id,
                "content": new_msg.content,
                "timestamp": new_msg.timestamp.isoformat(),
                "is_mine": True,
                "is_read": False,
            }
        })

    except Exception as e:
        print(f"[ERROR] send_message: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


