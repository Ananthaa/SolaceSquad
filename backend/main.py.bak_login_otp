        )
        # Any ratings referencing the appointments (already anonymized â€” cpid-based)
        if appt_ids:
            db.execute(text(f"DELETE FROM consultant_ratings WHERE appointment_id IN ({aids})"))

        # Schedule breaks and schedules
        db.execute(
            text("DELETE FROM consultant_schedule_breaks WHERE consultant_id = :cpid"),
            {"cpid": cp_id}
        )
        db.execute(
            text("DELETE FROM consultant_schedules WHERE consultant_id = :cpid"),
            {"cpid": cp_id}
        )

        # Consultant profile row
        db.execute(
            text("DELETE FROM consultant_profiles WHERE id = :cpid"),
            {"cpid": cp_id}
        )

        # â”€â”€ 3. Clean up remaining FK refs to users.id (skip session tables) â”€â”€
        _SKIP_TABLES = {
            "appointments", "call_sessions", "prescriptions",
            "prescription_items", "call_transcriptions",
            "consultant_ratings", "consultant_schedules",
            "consultant_schedule_breaks", "consultant_profiles",
        }
        fk_tables = db.execute(text("""
            SELECT kcu.table_name, kcu.column_name
            FROM information_schema.table_constraints AS tc
            JOIN information_schema.key_column_usage AS kcu
                ON tc.constraint_name = kcu.constraint_name
            JOIN information_schema.referential_constraints AS rc
                ON tc.constraint_name = rc.constraint_name
            JOIN information_schema.key_column_usage AS ccu
                ON rc.unique_constraint_name = ccu.constraint_name
            WHERE tc.constraint_type = 'FOREIGN KEY'
              AND ccu.table_name = 'users'
              AND ccu.column_name = 'id'
        """)).fetchall()

        for fk_table, fk_col in fk_tables:
            if fk_table == "users" or fk_table in _SKIP_TABLES:
                continue
            try:
                db.execute(text(f"DELETE FROM {fk_table} WHERE {fk_col} = :uid"), {"uid": user_id})
            except Exception as fk_err:
                print(f"[delete_consultant] skipped {fk_table}.{fk_col}: {fk_err}")
                db.rollback()

        # Handle otp_verification (uses email, not user_id FK)
        try:
            db.execute(text("DELETE FROM otp_verification WHERE otp_email = (SELECT email FROM users WHERE id = :uid)"), {"uid": user_id})
        except Exception:
            pass

        # Finally delete the user account
        db.execute(text("DELETE FROM users WHERE id = :uid"), {"uid": user_id})
        db.commit()


        return JSONResponse({"success": True, "message": "Consultant account fully deleted."})

    except Exception as e:
        db.rollback()
        import traceback
        print(f"Error removing consultant profile for user {user_id}: {traceback.format_exc()}")
        return JSONResponse({"success": False, "error": f"Error: {str(e)}"}, status_code=500)

