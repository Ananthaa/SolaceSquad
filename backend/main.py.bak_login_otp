@app.post("/api/calls/{room_id}/recording")
async def upload_call_recording(
    room_id: str,
    request: Request,
    file: UploadFile = File(...),
    appointment_id: int = Form(...),
    db: Session = Depends(get_db)
):
    """Receive audio recording from browser after call ends, upload to GCS, save URL."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)

    try:
        # Verify the call session exists and user is part of it
        session = db.query(CallSession).filter(CallSession.room_id == room_id).first()
        if not session:
            return JSONResponse({"success": False, "error": "Call session not found"}, status_code=404)

        if session.user_id != user_id and session.consultant_id != user_id:
            return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=403)

        # Read audio/video bytes
        audio_bytes = await file.read()
        if not audio_bytes:
            return JSONResponse({"success": False, "error": "Empty file"}, status_code=400)

        is_video = "video" in (file.content_type or "").lower()
        content_type = "video/webm" if is_video else "audio/webm"

        # Upload to GCS using existing helper
        from gcs_uploads import upload_to_gcs
        filename = f"recording-{appointment_id}-{room_id[:8]}.webm"
        gcs_url = upload_to_gcs(audio_bytes, filename, content_type, "recordings")

        if not gcs_url:
            return JSONResponse({"success": False, "error": "GCS upload failed"}, status_code=500)

        # Save URL + file size to CallSession
        session.recording_url = gcs_url
        session.recording_size_bytes = len(audio_bytes)
        session.has_video = is_video
        if not session.actual_end:
            session.actual_end = datetime.utcnow()
        db.commit()

        print(f"[Recording] Saved for room {room_id}, appointment {appointment_id} â†’ {gcs_url}")
        return JSONResponse({"success": True, "url": gcs_url})

    except Exception as e:
        print(f"[Recording] Upload error for room {room_id}: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


@app.get("/api/recordings/{room_id}/access")
async def get_recording_access(room_id: str, request: Request, db: Session = Depends(get_db)):
    """Return a playback URL for a recording â€” only accessible to the user/consultant of that session."""
    user_id = request.session.get("user_id")
    if not user_id:
        raise HTTPException(status_code=401, detail="Not authenticated")

    session = db.query(CallSession).filter(CallSession.room_id == room_id).first()
    if not session:
        raise HTTPException(status_code=404, detail="Recording not found")

    is_authorized = (session.user_id == user_id or session.consultant_id == user_id)
    if not is_authorized:
        # Check if user is admin and the appointment was red flagged
        user = db.query(User).filter(User.id == user_id).first()
        if user and user.user_type == "admin" and session.appointment_id:
            appt = db.query(Appointment).filter(Appointment.id == session.appointment_id).first()
            if appt and appt.red_flagged:
                is_authorized = True

    if not is_authorized:
        raise HTTPException(status_code=403, detail="Access denied")

    if not session.recording_url:
        raise HTTPException(status_code=404, detail="No recording for this session")

    # GCS public URL is already stored â€” return it directly
    return JSONResponse({"success": True, "url": session.recording_url})



@app.get("/api/user/recordings")
async def get_user_recordings(request: Request, db: Session = Depends(get_db)):

    """Get all recordings for the logged-in user"""
    try:
        user_id = request.session.get("user_id")
        if not user_id:
            raise HTTPException(status_code=401, detail="Not authenticated")
        
        # ── Plan-based recording access gate ────────────────────────────────
        recording_days_limit = None   # None = no date restriction
        try:
            from subscription_routes import get_user_plan_caps
            p_caps   = get_user_plan_caps(user_id, db)
            rec_cap  = p_caps.get("recording_access")
            if rec_cap is not None:
                rv = int(rec_cap.limit_value)
                if rv == 0:
                    # Fully blocked — return empty
                    return {"success": True, "recordings": [], "access_blocked": True,
                            "message": rec_cap.limit_hit_message or "Upgrade your plan to access recordings."}
                elif rv > 0:          # e.g. 30 → last 30 days
                    recording_days_limit = rv
                # rv == -1 → unlimited (no filter)
        except Exception:
            pass

        from datetime import timedelta
        cutoff = (datetime.utcnow() - timedelta(days=recording_days_limit)) if recording_days_limit else None

        from sqlalchemy import or_

        # Fetch all call sessions for this user/consultant that have a recording
        call_sessions = db.query(CallSession).filter(
            or_(CallSession.user_id == user_id, CallSession.consultant_id == user_id),
            CallSession.recording_url.isnot(None),
        ).order_by(CallSession.actual_start.desc()).all()

        recordings = []
        for session in call_sessions:
            consultant = db.query(User).filter(User.id == session.consultant_id).first()
            transcription = db.query(CallTranscription).filter(
                CallTranscription.call_session_id == session.id
            ).first()

            session_date = session.actual_start or session.scheduled_start
            is_locked    = bool(cutoff and session_date and session_date < cutoff)

            recordings.append({
                "id":               session.id,
                "call_date":        session_date.isoformat() if session_date else None,
                "duration_seconds": session.duration_seconds,
                "consultant_name":  consultant.name if consultant else "Unknown",
                "has_transcription": transcription is not None and transcription.summary is not None,
                "locked":           is_locked,
                "lock_message":     "This recording is older than your plan allows. Upgrade to access all recordings." if is_locked else None,
            })

        return {"success": True, "recordings": recordings}
    except Exception as e:
        print(f"Error getting user recordings: {e}")
        return {"success": False, "error": str(e)}


