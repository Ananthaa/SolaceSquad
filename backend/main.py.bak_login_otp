@app.post("/api/appointments/{appointment_id}/reschedule-free")
async def reschedule_free(appointment_id: int, request: Request, db: Session = Depends(get_db)):
    """Reschedule an appointment for free (used when consultant didn't join)."""
    uid = request.session.get("user_id")
    if not uid:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)

    try:
        form = await request.form()
        appointment_date = form.get("appointment_date", "").strip()
        duration_minutes = int(form.get("duration_minutes", 60))
        notes = form.get("notes", "")
        consent_to_record = form.get("consent_to_record", "false").lower() == "true"
        consent_to_share_data = form.get("consent_to_share_data", "false").lower() == "true"
    except Exception as e:
        return JSONResponse({"success": False, "error": f"Invalid form data: {str(e)}"}, status_code=400)

    try:
        appt = db.query(Appointment).filter(Appointment.id == appointment_id).first()
        if not appt:
            return JSONResponse({"success": False, "error": "Appointment not found"}, status_code=404)

        if appt.user_id != uid:
            return JSONResponse({"success": False, "error": "Not authorized"}, status_code=403)

        if not appt.reschedule_free and appt.status != "reschedule_pending":
            return JSONResponse({"success": False, "error": "This appointment is not eligible for free rescheduling."}, status_code=400)

        # Parse date and validate slot
        from finance_routes import _parse_appt_date, _validate_booking
        user_tz = request.session.get("timezone")
        if not user_tz or user_tz == "UTC":
            user = db.query(User).filter(User.id == uid).first()
            user_tz = user.timezone if (user and user.timezone and user.timezone != "UTC") else "Asia/Kolkata"

        try:
            appt_dt = _parse_appt_date(appointment_date, user_tz)
        except Exception:
            return JSONResponse({"success": False, "error": "Invalid date format. Please re-select the date and time."}, status_code=400)

        is_paid = (appt.consultant.consultation_fee or 0) > 0
        err = _validate_booking(db, uid, appt.consultant_id, appt_dt, duration_minutes, is_paid, request=request)
        if err:
            return JSONResponse(err, status_code=400)

        # Perform reschedule updates
        appt.appointment_date = appt_dt
        appt.duration_minutes = duration_minutes
        appt.notes = notes
        appt.consent_to_record = consent_to_record
        appt.consent_to_share_data = consent_to_share_data
        appt.status = "scheduled"
        appt.reschedule_free = False
        appt.reminder_sent = False
        appt.mirror_reminder_sent = False

        # Reset call session
        call_session = db.query(CallSession).filter(CallSession.appointment_id == appointment_id).first()
        if call_session:
            call_session.scheduled_start = appt_dt
            call_session.scheduled_end = appt_dt + timedelta(minutes=duration_minutes)
            call_session.actual_start = None
            call_session.actual_end = None
            call_session.duration_seconds = None
            call_session.status = "pending"

        db.commit()
        return JSONResponse({"success": True})

    except Exception as e:
        db.rollback()
        print(f"[ERROR] reschedule_free: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)

