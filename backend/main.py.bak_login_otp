@app.patch("/api/appointments/{appointment_id}/status")
async def update_appointment_status(appointment_id: int, request: Request, db: Session = Depends(get_db)):
    """Update appointment status (in_progress / completed) from the call room."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)

    try:
        data = await request.json()
        new_status = data.get("status", "").strip()

        allowed = {"in_progress", "completed"}
        if new_status not in allowed:
            return JSONResponse({"success": False, "error": f"Invalid status. Allowed: {allowed}"}, status_code=400)

        appt = db.query(Appointment).filter(Appointment.id == appointment_id).first()
        if not appt:
            return JSONResponse({"success": False, "error": "Appointment not found"}, status_code=404)

        # Auth: must be the patient OR the consultant for this appointment
        consultant_profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == user_id).first()
        is_patient    = appt.user_id == user_id
        is_consultant = consultant_profile and appt.consultant_id == consultant_profile.id
        if not (is_patient or is_consultant):
            return JSONResponse({"success": False, "error": "Not authorized"}, status_code=403)

        # Patients are not allowed to mark appointments as completed
        if new_status == "completed" and not is_consultant:
            return JSONResponse({"success": False, "error": "Patients are not authorized to mark appointments as completed."}, status_code=403)

        # Guard: don't downgrade a completed call back to in_progress
        if appt.status == "completed" and new_status == "in_progress":
            return JSONResponse({"success": True, "status": appt.status})  # silently ignore

        appt.status = new_status

        # When both parties are confirmed in the room, stamp actual_start on the CallSession
        if new_status == "in_progress":
            call_session = db.query(CallSession).filter(
                CallSession.appointment_id == appointment_id
            ).first()
            if call_session and call_session.actual_start is None:
                call_session.actual_start = datetime.utcnow()
                call_session.status = "active"
                print(f"[CALL SESSION] actual_start stamped for appointment {appointment_id}")

        db.commit()
        print(f"[APPT STATUS] Appointment {appointment_id} â†’ {new_status} (by user {user_id})")
        return JSONResponse({"success": True, "status": new_status})

    except Exception as e:
        db.rollback()
        print(f"[APPT STATUS] Error: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


