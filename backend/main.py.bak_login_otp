        def _str(key): return (form.get(key) or "").strip()
        def _list(key): return _json.dumps(form.getlist(key) or [])
        def _int(key, default=0):
            try: return int(_str(key))
            except ValueError: return default
        def _float(key):
            try: return float(_str(key))
            except (ValueError, TypeError): return None
        def _bool_radio(key):
            v = _str(key).lower()
            return True if v == "yes" else (False if v == "no" else None)

        # â”€â”€ Parse form fields â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # S1: Personal Details
