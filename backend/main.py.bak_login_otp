@app.post("/api/settings/delete-account")
async def delete_user_account(request: Request, db: Session = Depends(get_db)):
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)
        
    try:
        user = db.query(User).filter(User.id == user_id).first()
        if not user:
            return JSONResponse({"success": False, "error": "User not found"}, status_code=404)
            
        # Log deletion attempt in audit log BEFORE deletion so the record exists
        AuditLogger.log_event(
            db,
            user_id=user_id,
            event_type="account_deleted",
            resource_type="user",
            resource_id=str(user_id),
            details=f"User '{user.name}' ({user.email}) requested account deletion. Cascade erasure initiated.",
            request=request
        )
        
        # Invalidate/clear session first
        request.session.clear()
        
        # Cascade DB cleanup
        from models import UserProfile, ConsultantProfile, Appointment, Prescription, Message, CallSession, AIChatHistory
        db.query(UserProfile).filter(UserProfile.user_id == user_id).delete()
        db.query(Appointment).filter(Appointment.user_id == user_id).delete()
        db.query(Prescription).filter(Prescription.user_id == user_id).delete()
        db.query(Message).filter((Message.sender_id == user_id) | (Message.receiver_id == user_id)).delete()
        db.query(CallSession).filter(CallSession.user_id == user_id).delete()
        db.query(AIChatHistory).filter(AIChatHistory.user_id == user_id).delete()
        
        # If user is a consultant, clean up their ConsultantProfile
        cp = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == user_id).first()
        if cp:
            from models import ConsultantSchedule, ScheduleBreak, ConsultantRating
            db.query(ConsultantSchedule).filter(ConsultantSchedule.consultant_id == cp.id).delete()
            db.query(ScheduleBreak).filter(ScheduleBreak.consultant_id == cp.id).delete()
            db.query(ConsultantRating).filter(ConsultantRating.consultant_id == cp.id).delete()
            db.delete(cp)
            
        db.delete(user)
        db.commit()
        
        return {"success": True}
    except Exception as e:
        import traceback; traceback.print_exc()
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)

