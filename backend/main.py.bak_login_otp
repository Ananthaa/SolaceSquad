@app.post("/api/admin/assistants/create")
async def api_assistant_create(request: Request, db: Session = Depends(get_db)):
    user_id = request.session.get("user_id")
    caller  = db.query(User).filter(User.id == user_id).first()
    if not caller or caller.user_type != "admin":
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=403)
    body     = await request.json()
    name     = (body.get("name") or "").strip()
    # Support both username (preferred) and legacy email
    username = (body.get("username") or "").strip().lower()
    email    = (body.get("email") or "").strip().lower()
    password = (body.get("password") or "").strip()

    if username:
        # Validate username: alphanumeric + underscores only
        import re as _re
        if not _re.match(r'^[a-zA-Z0-9_]+$', username):
            return JSONResponse({"success": False, "error": "Username may only contain letters, numbers and underscores"})
        # Store internally as username@assistant.internal
        email = f"{username}@assistant.internal"
    
    if not name or not email or not password:
        return JSONResponse({"success": False, "error": "Name, username and password are required"})
    if len(password) < 8:
        return JSONResponse({"success": False, "error": "Password must be at least 8 characters"})
    existing = db.query(User).filter(User.email == email).first()
    if existing:
        return JSONResponse({"success": False, "error": f"Username already taken"})
    import datetime as _dt
    new_asst = User(email=email, name=name, user_type="admin_assistant",
                    is_active=True, email_verified=True, created_at=_dt.datetime.utcnow())
    new_asst.set_password(password)
    db.add(new_asst)
    db.commit()
    db.refresh(new_asst)
    # Derive username for display
    display_username = username or email.split("@")[0]
    return JSONResponse({"success": True, "username": display_username, "id": new_asst.id})


