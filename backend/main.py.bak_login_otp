        total_mins_today = existing_mins + new_duration
        ls_score = rate_workout(total_mins_today)

        log = WorkoutLog(
            user_id         = user_id,
            log_date        = log_date_val,
            workout_type    = data.get("workout_type", "Other"),
            duration_min    = new_duration,
            step_count      = int(data.get("step_count", 0)),
            calories        = int(data.get("calories", 0)),
            notes           = data.get("notes", ""),
            lifestyle_score = ls_score,
        )
        db.add(log)
        db.commit()
        db.refresh(log)

        # Refresh overall wellness score
        try:
            compute_and_save_wellness(user_id, db, for_date=log_date_val)
        except Exception as _we:
            print(f"[WARN] wellness compute failed after workout save: {_we}")

        print(f"[INFO] Workout log saved: user={user_id}, date={log_date_val}, "
              f"new={new_duration}min, total_today={total_mins_today}min, score={ls_score}")
        return {"success": True, "id": log.id,
                "lifestyle_score": ls_score,
                "total_mins_today": total_mins_today}
    except Exception as e:
        db.rollback()
        return {"success": False, "error": str(e)}


