@app.get("/canvas-preview", response_class=HTMLResponse)
async def canvas_preview_page(request: Request, db: Session = Depends(get_db)):
    """
    Renders the homepage with the Canvas Editor script already embedded.
    Used by the Canvas Editor iframe (frame.src='/canvas-preview').
    The editor script is part of the HTML response, so no post-load injection needed.
    """
    import os as _os

    user_id = request.session.get("user_id")
    if not user_id:
        return HTMLResponse("<html><body><p style='padding:20px'>Please log in to use the canvas editor.</p></body></html>")

    # Render home.html with the same context as the main home route
    try:
        published = (
            db.query(HomePageSection)
            .filter(
                HomePageSection.is_published == True,
                HomePageSection.title != "__canvas_snapshot__"
            )
            .order_by(HomePageSection.order_index)
            .all()
        )
    except Exception:
        db.rollback()
        published = []

    try:
        if published:
            resp = templates.TemplateResponse(
                "pages/home_published.html",
                {
                    "request": request,
                    "page_title": "SolaceSquadÂ® â€” With You Always",
                    "active_page": "home",
                    "sections_css": "\n".join(s.css_content or "" for s in published),
                    "sections_html": "\n".join(s.html_content for s in published),
                }
            )
        else:
            resp = templates.TemplateResponse(
                "pages/home.html",
                {"request": request, "page_title": "SolaceSquadÂ® â€” With You Always", "active_page": "home"}
            )

        # Inject the editor script before </body>
        body_bytes = resp.body
        html = body_bytes.decode("utf-8") if isinstance(body_bytes, bytes) else str(body_bytes)
        if "</body>" in html:
            html = html.replace("</body>", CANVAS_EDITOR_SCRIPT + "\n</body>", 1)
        elif "</html>" in html:
            html = html.replace("</html>", CANVAS_EDITOR_SCRIPT + "\n</html>", 1)
        else:
            html += CANVAS_EDITOR_SCRIPT

        return HTMLResponse(content=html)

    except Exception as e:
        return HTMLResponse(f"<html><body><p style='color:red;padding:20px'>Error: {e}</p></body></html>")




