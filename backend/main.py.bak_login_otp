@app.get("/api/admin/email-diagnostics")
async def admin_email_diagnostics(request: Request, to: str = ""):
    """Admin-only: test SendGrid delivery and check/fix suppression lists."""
    import json as _json, urllib.request, urllib.error, urllib.parse
    admin_id = request.session.get("user_id")
    from database import get_db_session as _get_db
    with _get_db() as _db:
        _admin = _db.query(User).filter(User.id == admin_id).first()
    if not _admin or _admin.user_type != "admin":
        return JSONResponse({"error": "Unauthorized"}, status_code=403)

    api_key   = (os.getenv("SENDGRID_API_KEY") or "").strip()
    from_addr = os.getenv("FROM_EMAIL", "noreply@solacesquad.com")
    results   = {"from_email": from_addr, "api_key_set": bool(api_key)}

    if not api_key:
        return JSONResponse({"error": "SENDGRID_API_KEY not set"}, status_code=500)

    def _sg_get(path):
        req = urllib.request.Request(
            f"https://api.sendgrid.com/v3{path}",
            headers={"Authorization": f"Bearer {api_key}"},
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                body = r.read()
                return _json.loads(body) if body else {}
        except urllib.error.HTTPError as e:
            return {"_http_error": e.code, "_body": e.read().decode("utf-8", "replace")}

    def _sg_delete(path):
        req = urllib.request.Request(
            f"https://api.sendgrid.com/v3{path}",
            headers={"Authorization": f"Bearer {api_key}"},
            method="DELETE",
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as r:
                return {"status": r.status}
        except urllib.error.HTTPError as e:
            return {"_http_error": e.code}

    if to:
        enc = urllib.parse.quote(to, safe="")
        results["target"] = to
        results["suppressed_bounces"] = _sg_get(f"/suppression/bounces/{enc}")
        results["suppressed_blocks"]  = _sg_get(f"/suppression/blocks/{enc}")
        results["suppressed_invalid"] = _sg_get(f"/suppression/invalid_emails/{enc}")
        results["suppressed_spam"]    = _sg_get(f"/suppression/spam_reports/{enc}")
        # Remove from all suppression lists automatically
        removed = []
        for path, label in [
            (f"/suppression/bounces/{enc}", "bounce"),
            (f"/suppression/blocks/{enc}", "block"),
            (f"/suppression/invalid_emails/{enc}", "invalid"),
            (f"/suppression/spam_reports/{enc}", "spam"),
        ]:
            r = _sg_delete(path)
            if r.get("status") in (200, 204):
                removed.append(label)
        if removed:
            results["removed_from_suppression"] = removed
        # Live test
        from sendgrid_email import send_email_otp as _send_otp
        sent = _send_otp(to, "Test User", "999999")
        results["test_email_sent"] = sent

    return JSONResponse(results)


