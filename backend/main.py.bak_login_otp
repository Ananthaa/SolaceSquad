        dm = ", ".join(form.getlist("delivery_methods") or [])
        if dm: profile.delivery_methods = dm
        if _str("psychometric_tests"): profile.psychometric_tests = _bool_radio("psychometric_tests")
        if _str("clinical_experience"): profile.clinical_experience = _str("clinical_experience")
        dob_raw = _str("date_of_birth")
