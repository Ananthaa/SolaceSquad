@app.post("/assistant/consultant/{profile_id}/save-draft")
async def assistant_save_draft(profile_id: int, request: Request, db: Session = Depends(get_db)):
    uid = _assistant_guard(request)
    if not uid:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=403)
    profile = db.query(ConsultantProfile).filter(ConsultantProfile.id == profile_id).first()
    if not profile:
        return JSONResponse({"success": False, "error": "Profile not found"}, status_code=404)
    import json as _json
    form = await request.form()
    def _g(k, d=""): return (form.get(k) or d).strip()
    def _pfloat(v):
        try: return float(v) if v else None
        except: return None
    def _pint(v):
        try: return int(v) if v else None
        except: return None
    if _g("full_name"): profile.full_name = _g("full_name")
    if _g("city"): profile.city = _g("city")
    if _g("gender"): profile.gender = _g("gender")
    if _g("experience_years"): profile.experience_years = _pint(_g("experience_years"))
    if _g("highest_qualification"): profile.highest_qualification = _g("highest_qualification")
    if _g("education_specialization"): profile.education = _g("education_specialization")
    if _g("referral_source"): profile.referral_source = _g("referral_source")
    if _g("preferred_time"): profile.preferred_time = _g("preferred_time")
    if _g("preferred_days"): profile.preferred_days = _g("preferred_days")
    if _g("availability_notes"): profile.availability_notes = _g("availability_notes")
    if _g("bio"): profile.bio = _g("bio")
    if _g("linkedin_url"): profile.linkedin_url = _g("linkedin_url")
    qacp = _g("qacp_certified")
    if qacp == "yes": profile.qacp_certified = True
    elif qacp == "no": profile.qacp_certified = False
    if _g("expected_hourly_fee"): profile.hourly_rate = _pfloat(_g("expected_hourly_fee"))
    methods = form.getlist("counselling_methods")
    if methods: profile.counselling_methods = _json.dumps(methods)
    areas = form.getlist("expertise_areas")
    if areas: profile.expertise_areas = _json.dumps(areas)
    db.commit()

    # Fire admin alert email (non-blocking)
    try:
        assistant_user = db.query(User).filter(User.id == uid).first()
        consultant_user = db.query(User).filter(User.id == profile.user_id).first()
        admin_email = os.getenv("ADMIN_EMAIL", "admin@solacesquad.com")
        from sendgrid_email import send_admin_assistant_form_saved_alert
        import threading
        threading.Thread(
            target=send_admin_assistant_form_saved_alert,
            args=(
                admin_email,
                consultant_user.name if consultant_user else "Unknown",
                consultant_user.email if consultant_user else "",
                assistant_user.name if assistant_user else "Assistant",
                profile_id,
            ),
            daemon=True,
        ).start()
    except Exception as _e:
        print(f"[EMAIL] assistant form alert failed: {_e}")

    return JSONResponse({"success": True, "message": "Saved - pending Admin approval"})


