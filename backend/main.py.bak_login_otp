def get_initials(name: str) -> str:
    """Generate initials from a name"""
    name_parts = name.split()
    if len(name_parts) >= 2:
        return f"{name_parts[0][0]}{name_parts[-1][0]}".upper()
    elif len(name_parts) == 1:
        return name_parts[0][:2].upper()
    else:
        return "U"

