@app.post("/api/appointments/{appointment_id}/complete")
async def complete_appointment(
    appointment_id: int,
    request: Request,
    db: Session = Depends(get_db)
):
    """
    Mark a call as completed.
    Completion criteria enforced: CallSession.actual_start must be set,
    meaning both parties joined and had a conversation.
    Increments calls_completed on ConsultantProfile (stored in Cloud SQL).
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)

    try:
        appointment = db.query(Appointment).filter(Appointment.id == appointment_id).first()
        if not appointment:
            return JSONResponse({"success": False, "error": "Appointment not found"}, status_code=404)

        # Load the call session
        call_session = db.query(CallSession).filter(
            CallSession.appointment_id == appointment_id
        ).first()

        # Enforce that consultation notes are written and not empty
        if not appointment.notes or not appointment.notes.strip():
            return JSONResponse(
                {"success": False, "error": "Please write session notes before completing the consultation."},
                status_code=400
            )

        # Enforce completion criteria:
        # Block ONLY if nobody ever joined the call (actual_start never set).
        # If the call started and the user left early, the consultant can still complete.
        if not call_session or not call_session.actual_start:
            return JSONResponse(
                {"success": False,
                 "error": "Cannot complete â€” the call was never connected. "
                          "At least one participant must have joined before a session can be marked complete."},
                status_code=400
            )

        # Mark appointment completed
        appointment.status = "completed"

        # Update call session end time + duration
        call_session.actual_end = datetime.utcnow()
        call_session.status = "completed"
        delta = call_session.actual_end - call_session.actual_start
        call_session.duration_seconds = int(delta.total_seconds())

        # Increment calls_completed counter on ConsultantProfile
        consultant_profile = db.query(ConsultantProfile).filter(
            ConsultantProfile.id == appointment.consultant_id
        ).first()
        if consultant_profile:
            if consultant_profile.calls_completed is None:
                consultant_profile.calls_completed = 0
            consultant_profile.calls_completed += 1

        db.commit()
        return JSONResponse({"success": True, "message": "Call marked as completed"})

    except Exception as e:
        db.rollback()
        print(f"[ERROR] complete_appointment: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


@app.post("/api/appointments/{appointment_id}/rate")
async def rate_appointment(
    appointment_id: int,
    request: Request,
    db: Session = Depends(get_db)
):
    """
    Submit a star rating + feedback for a completed appointment.
    Payload: { rating: 1-5, feedback: str, is_anonymous: bool, display_name: str }
    All ratings/feedback stored in Cloud SQL consultant_ratings table.
    Also recalculates the aggregate rating on ConsultantProfile.
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)

    try:
        data = await request.json()
        rating_value = float(data.get("rating", 0))
        feedback_text = data.get("feedback", "").strip()
        is_anonymous = bool(data.get("is_anonymous", False))
        display_name_req = data.get("display_name", "").strip()

        if not (1.0 <= rating_value <= 5.0):
            return JSONResponse({"success": False, "error": "Rating must be between 1 and 5"}, status_code=400)

        appointment = db.query(Appointment).filter(Appointment.id == appointment_id).first()
        if not appointment:
            return JSONResponse({"success": False, "error": "Appointment not found"}, status_code=404)

        if appointment.user_id != user_id:
            return JSONResponse({"success": False, "error": "Forbidden"}, status_code=403)

        # Prevent duplicate rating
        existing = db.query(ConsultantRating).filter(
            ConsultantRating.appointment_id == appointment_id
        ).first()
        if existing:
            return JSONResponse({"success": False, "error": "Already rated"}, status_code=409)

        # Resolve display name (anonymous â†’ "Anonymous User", else use provided or user's real name)
        if is_anonymous:
            resolved_name = "Anonymous User"
        elif display_name_req:
            resolved_name = display_name_req
        else:
            user_obj = db.query(User).filter(User.id == user_id).first()
            resolved_name = user_obj.name if user_obj else "SolaceSquad User"

        # Save to Cloud SQL
        new_rating = ConsultantRating(
            appointment_id=appointment_id,
            consultant_id=appointment.consultant_id,
            user_id=user_id,
            rating=rating_value,
            feedback=feedback_text if feedback_text else None,
            is_anonymous=is_anonymous,
            display_name=resolved_name,
        )
        db.add(new_rating)

        # Recompute aggregate rating on ConsultantProfile
        consultant_profile = db.query(ConsultantProfile).filter(
            ConsultantProfile.id == appointment.consultant_id
        ).first()
        if consultant_profile:
            prev_ratings = db.query(ConsultantRating).filter(
                ConsultantRating.consultant_id == appointment.consultant_id
            ).all()
            total = len(prev_ratings)
            current_sum = sum(r.rating for r in prev_ratings)
            new_avg = (current_sum + rating_value) / (total + 1)
            consultant_profile.rating = round(new_avg, 2)

        db.commit()
        return JSONResponse({"success": True, "message": "Rating submitted successfully"})

    except Exception as e:
        db.rollback()
        print(f"[ERROR] rate_appointment: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


