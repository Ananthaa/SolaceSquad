@app.post("/api/messages/send")
async def send_message(request: Request, db: Session = Depends(get_db)):
    """Send a message - with PII filter and access control."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)
    try:
        data = await request.json()
        receiver_id = int(data.get("receiver_id", 0))
        content = (data.get("content", "") or "").strip()
        if not content:
            return JSONResponse({"success": False, "error": "Message cannot be empty."}, status_code=400)
        if len(content) > 2000:
            return JSONResponse({"success": False, "error": "Message too long (max 2000 characters)."}, status_code=400)
        if _contains_pii(content):
            return JSONResponse({"success": False, "error": "For safety, sharing phone numbers or email addresses in messages is not allowed. Please keep communication on this platform."}, status_code=400)
        receiver = db.query(User).filter(User.id == receiver_id).first()
        if not receiver:
            return JSONResponse({"success": False, "error": "Recipient not found."}, status_code=404)
        uid = int(user_id)
        user_type = request.session.get("user_type", "user")
        if user_type == "user":
            receiver_profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == receiver_id).first()
            has_appointment = None
            if receiver_profile:
                has_appointment = db.query(Appointment).filter(Appointment.user_id == uid, Appointment.consultant_id == receiver_profile.id).first()
            has_call = db.query(CallSession).filter(CallSession.user_id == uid, CallSession.consultant_id == receiver_id).first()
            existing_thread = db.query(Message).filter(((Message.sender_id == uid) & (Message.receiver_id == receiver_id)) | ((Message.sender_id == receiver_id) & (Message.receiver_id == uid))).first()
            if not has_appointment and not has_call and not existing_thread:
                return JSONResponse({"success": False, "error": "You can only message consultants you've had sessions with."}, status_code=403)
        new_msg = Message(sender_id=uid, receiver_id=receiver_id, content=content, timestamp=datetime.utcnow(), is_read=False)
        db.add(new_msg)
        db.commit()
        db.refresh(new_msg)
        return JSONResponse({"success": True, "message": {"id": new_msg.id, "content": new_msg.content, "timestamp": new_msg.timestamp.isoformat() + "Z", "is_mine": True, "is_read": False}})
    except Exception as e:
        print(f"[ERROR] send_message: {e}")
        db.rollback()
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


@app.get("/api/messages/conversations")
async def get_conversations(request: Request, db: Session = Depends(get_db)):
    """Get all conversations for logged-in user.
    Users see consultants they've had appointments OR call sessions with.
    Consultants see all their clients."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)
    user_type = request.session.get("user_type", "user")
    try:
        uid = int(user_id)
        if user_type == "user":
            # Source 1: appointments
            cp_ids = [r[0] for r in db.query(Appointment.consultant_id).filter(Appointment.user_id == uid).distinct().all()]
            eligible = set()
            if cp_ids:
                for p in db.query(ConsultantProfile).filter(ConsultantProfile.id.in_(cp_ids)).all():
                    eligible.add(p.user_id)
            # Source 2: call sessions
            for (cid,) in db.query(CallSession.consultant_id).filter(CallSession.user_id == uid).distinct().all():
                eligible.add(cid)
            # Source 3: existing messages
            try:
                for msg in db.query(Message).filter((Message.sender_id == uid) | (Message.receiver_id == uid)).all():
                    other = msg.receiver_id if msg.sender_id == uid else msg.sender_id
                    eligible.add(other)
            except Exception:
                db.rollback()
            all_partner_ids = list(eligible)
        else:
            uid_c = uid
            consultant_profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == uid_c).first()
            eligible = set()
            if consultant_profile:
                for r in db.query(Appointment.user_id).filter(Appointment.consultant_id == consultant_profile.id).distinct().all():
                    eligible.add(r[0])
            for r in db.query(CallSession.user_id).filter(CallSession.consultant_id == uid_c).distinct().all():
                eligible.add(r[0])
            try:
                for msg in db.query(Message).filter((Message.sender_id == uid_c) | (Message.receiver_id == uid_c)).all():
                    other = msg.receiver_id if msg.sender_id == uid_c else msg.sender_id
                    eligible.add(other)
            except Exception:
                db.rollback()
            all_partner_ids = list(eligible)

        conversations = []
        for pid in all_partner_ids:
            partner = db.query(User).filter(User.id == pid).first()
            if not partner:
                continue
            latest_msg = None
            unread_count = 0
            try:
                latest_msg = db.query(Message).filter(((Message.sender_id == uid) & (Message.receiver_id == pid)) | ((Message.sender_id == pid) & (Message.receiver_id == uid))).order_by(Message.timestamp.desc()).first()
                unread_count = db.query(Message).filter(Message.sender_id == pid, Message.receiver_id == uid, Message.is_read == False).count()
            except Exception:
                db.rollback()
            conversations.append({"partner_id": pid, "partner_name": partner.name, "latest_message": latest_msg.content[:80] if latest_msg else "Start a conversation", "latest_timestamp": (latest_msg.timestamp.isoformat() + "Z") if latest_msg else None, "unread_count": unread_count})

        conversations.sort(key=lambda c: c["latest_timestamp"] or "0000", reverse=True)
        return JSONResponse({"success": True, "conversations": conversations})
    except Exception as e:
        print(f"[ERROR] get_conversations: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


