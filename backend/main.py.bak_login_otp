@app.get("/consultant/reports", response_class=HTMLResponse)
async def consultant_reports(request: Request, db: Session = Depends(get_db)):
    """Consultant reports & analytics page"""
    user_id = request.session.get("user_id")
    if not user_id:
        return RedirectResponse(url="/login", status_code=302)

    user = db.query(User).filter(User.id == user_id).first()
    if not user or user.user_type != "consultant":
        return RedirectResponse(url="/app", status_code=302)

    consultant_profile = db.query(ConsultantProfile).filter(
        ConsultantProfile.user_id == user_id
    ).first()
    if not consultant_profile:
        return RedirectResponse(url="/consultant/profile", status_code=302)

    user_name = request.session.get("user_name", user.name)
    name_parts = user_name.split()
    initials = (name_parts[0][0] + (name_parts[1][0] if len(name_parts) > 1 else name_parts[0][1])).upper()

    # All appointments for this consultant
    appointments = db.query(Appointment).filter(
        Appointment.consultant_id == consultant_profile.id
    ).order_by(Appointment.appointment_date.desc()).all()

    completed = [a for a in appointments if a.status == "completed"]
    scheduled = [a for a in appointments if a.status == "scheduled"]
    cancelled = [a for a in appointments if a.status == "cancelled"]

    payout = float(consultant_profile.consultant_payout or 0)
    total_earnings = len(completed) * payout

    # Unique clients
    unique_clients = len(set(a.user_id for a in appointments))

    # Ratings
    from models import ConsultantRating
    ratings = db.query(ConsultantRating).filter(
        ConsultantRating.consultant_id == consultant_profile.id
    ).order_by(ConsultantRating.created_at.desc()).all()
    avg_rating = round(sum(r.rating for r in ratings) / len(ratings), 1) if ratings else 0.0
    rating_counts = {i: sum(1 for r in ratings if round(r.rating) == i) for i in range(1, 6)}

    # Monthly session data (last 6 months)
    from collections import defaultdict
    monthly = defaultdict(int)
    for a in completed:
        key = a.appointment_date.strftime("%b %Y")
        monthly[key] += 1

    # Per-client stats
    client_map = defaultdict(lambda: {"name": "", "sessions": 0, "last": None})
    for a in appointments:
        cid = a.user_id
        client_map[cid]["sessions"] += 1
        dt = a.appointment_date
        if client_map[cid]["last"] is None or dt > client_map[cid]["last"]:
            client_map[cid]["last"] = dt
    # Enrich with user names
    user_ids = list(client_map.keys())
    users_list = db.query(User).filter(User.id.in_(user_ids)).all() if user_ids else []
    uname = {u.id: u.name for u in users_list}
    for uid, info in client_map.items():
        info["name"] = uname.get(uid, f"User #{uid}")

    client_stats = sorted(client_map.values(), key=lambda x: -x["sessions"])[:10]
    for c in client_stats:
        if c["last"]:
            c["last"] = c["last"].strftime("%d %b %Y")

    def format_inr(amount):
        return f"₹{int(amount):,}" if amount > 0 else "₹0"

    return templates.TemplateResponse(
        "pages/consultant_reports.html",
        {
            "request": request,
            "page_title": "Reports & Analytics - SolaceSquad",
            "user_name": user_name,
            "user_initials": initials,
            "user_type": "consultant",
            "active_page": "reports",
            "stats": {
                "total_sessions":    len(appointments),
                "completed":         len(completed),
                "scheduled":         len(scheduled),
                "cancelled":         len(cancelled),
                "unique_clients":    unique_clients,
                "total_earnings":    format_inr(total_earnings),
                "payout_per_session": format_inr(payout),
                "avg_rating":        avg_rating,
                "total_ratings":     len(ratings),
            },
            "rating_counts": rating_counts,
            "client_stats":  client_stats,
            "monthly":       dict(monthly),
        }
    )



from pydantic import BaseModel
from typing import List, Optional

class PrescriptionItemModel(BaseModel):
    medication_name: str
    dosage: Optional[str]
    frequency: Optional[str]
    duration: Optional[str]
    instructions: Optional[str]

class PrescriptionModel(BaseModel):
    user_id: int
    diagnosis: Optional[str]
    notes: Optional[str]
    items: List[PrescriptionItemModel]

@app.post("/api/consultant/prescriptions")
async def create_prescription(data: PrescriptionModel, request: Request, db: Session = Depends(get_db)):
    user_id = request.session.get("user_id")
    if not user_id:
        raise HTTPException(status_code=401, detail="Unauthorized")
        
    user = db.query(User).filter(User.id == user_id).first()
    if not user or user.user_type != "consultant":
        raise HTTPException(status_code=403, detail="Not a consultant")

    try:
        # Create prescription
        prescription = Prescription(
            consultant_id=user_id,
            user_id=data.user_id,
            diagnosis=data.diagnosis,
            notes=data.notes
        )
        db.add(prescription)
        db.flush() # get ID
        
        # Add items
        for item in data.items:
            db_item = PrescriptionItem(
                prescription_id=prescription.id,
                medication_name=item.medication_name,
                dosage=item.dosage,
                frequency=item.frequency,
                duration=item.duration,
                instructions=item.instructions
            )
            db.add(db_item)
            
        db.commit()
        
        # Audit Log
        AuditLogger.log_event(
            db,
            event_type="prescription_created",
            user_id=user_id,
            resource_type="prescription",
            resource_id=str(prescription.id),
            details=f"Prescription created for user {data.user_id}"
        )
        
        return {"success": True, "id": prescription.id}
    except Exception as e:
        db.rollback()
        print(f"Error creating prescription: {e}")
        return {"success": False, "error": str(e)}

