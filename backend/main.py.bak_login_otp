        return JSONResponse({"success": False, "error": str(e)})


def _seed_schedule_from_onboarding(profile, db):
    """Auto-create ConsultantSchedule rows from onboarding preferred_days/time.
    Only runs if NO schedule rows exist yet — never overwrites manual settings."""
    from models import ConsultantSchedule
    existing = db.query(ConsultantSchedule).filter(
        ConsultantSchedule.consultant_id == profile.id
    ).count()
    if existing > 0:
        return  # Manual schedule already set — don't overwrite
    if not profile.preferred_days and not profile.preferred_time:
        return  # No onboarding data to seed from

    DAY_MAP = {
        "Weekdays": [0, 1, 2, 3, 4],
        "Weekends": [5, 6],
        "Any Day":  [0, 1, 2, 3, 4, 5, 6],
    }
    TIME_MAP = {
        "Morning (6am\u201312pm)":   ("06:00", "12:00"),
        "Afternoon (12pm\u20135pm)": ("12:00", "17:00"),
        "Evening (5pm\u201310pm)":   ("17:00", "22:00"),
        "Any Time":               ("06:00", "22:00"),
    }
    days  = DAY_MAP.get(profile.preferred_days, [0, 1, 2, 3, 4])
    start, end = TIME_MAP.get(profile.preferred_time, ("09:00", "17:00"))

    for d in days:
        db.add(ConsultantSchedule(
            consultant_id=profile.id,
            day_of_week=d,
            start_time=start,
            end_time=end,
            is_active=True,
        ))
    try:
        db.commit()
        print(f"[SCHEDULE] Seeded {len(days)} rows for consultant {profile.id} "
              f"({profile.preferred_days} / {profile.preferred_time})")
    except Exception as e:
        db.rollback()
        print(f"[SCHEDULE] Seed failed: {e}")


@app.post("/consultant/onboarding")
async def consultant_onboarding_post(request: Request, db: Session = Depends(get_db)):
