        video_id = None
        patterns = [
            r'(?:youtube\.com\/watch\?v=)([a-zA-Z0-9_-]{11})',
            r'(?:youtu\.be\/)([a-zA-Z0-9_-]{11})',
            r'(?:youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})',
        ]
        
        for pattern in patterns:
            match = re.search(pattern, video_url)
            if match:
                video_id = match.group(1)
                break
        
        # Convert to embed URL format
        if video_id:
            video_url = f"https://www.youtube.com/embed/{video_id}"
    
    video = Video(
        folder_id=video_data.folder_id,
        title=video_data.title,
        description=video_data.description or "",
        video_url=video_url,
        thumbnail_url=video_data.thumbnail_url if video_data.thumbnail_url else None,
        duration_seconds=video_data.duration_seconds or 0,
        is_youtube=is_youtube
    )
    db.add(video)
    db.commit()
    db.refresh(video)
    
    return JSONResponse({"success": True, "video_id": video.id})

