async def update_phone_post(request: Request, db: Session = Depends(get_db)):
    """Update phone number in DB and redirect to next destination"""
    user_id = request.session.get("user_id")
    if not user_id:
        return RedirectResponse(url="/login", status_code=303)
        
    form_data = await request.form()
    phone_number = form_data.get("phone_number", "").strip()
    
    if not phone_number:
        return templates.TemplateResponse(
            "pages/auth/update_phone.html",
            {
                "request": request,
                "page_title": "Verify Phone Number - SolaceSquad",
                "error": "Phone number is required."
            }
        )
        
    # Basic phone format validation
    import re
    if not re.match(r'^\+?[0-9\s\-()]{7,20}$', phone_number):
        return templates.TemplateResponse(
            "pages/auth/update_phone.html",
            {
                "request": request,
                "page_title": "Verify Phone Number - SolaceSquad",
                "error": "Invalid phone number format. Please check the number and try again.",
                "phone_number": phone_number
            }
        )
        
    # Check if verified in session
    session_verified = request.session.get("phone_otp_verified")
    clean_phone = phone_number.replace(" ", "").replace("-", "")
    if clean_phone.startswith("+91"):
        clean_phone = clean_phone[3:]
    elif clean_phone.startswith("91") and len(clean_phone) == 12:
        clean_phone = clean_phone[2:]
        
    clean_verified = (session_verified or "").replace(" ", "").replace("-", "")
    if clean_verified.startswith("+91"):
        clean_verified = clean_verified[3:]
    elif clean_verified.startswith("91") and len(clean_verified) == 12:
        clean_verified = clean_verified[2:]

    if not session_verified or clean_phone != clean_verified:
        return templates.TemplateResponse(
            "pages/auth/update_phone.html",
            {
                "request": request,
                "page_title": "Verify Phone Number - SolaceSquad",
                "error": "Phone number not verified. Please verify with OTP first.",
                "phone_number": phone_number
            }
        )

    # Check if this phone is already registered to another account
    existing_user = db.query(User).filter(User.phone_number == phone_number, User.id != user_id).first()
    if existing_user:
        return templates.TemplateResponse(
            "pages/auth/update_phone.html",
            {
                "request": request,
                "page_title": "Verify Phone Number - SolaceSquad",
                "error": "This phone number is already registered to another account.",
                "phone_number": phone_number
            }
        )
        
    user = db.query(User).filter(User.id == user_id).first()
    if user:
        user.phone_number = phone_number
        db.commit()
        
    request.session.pop("phone_otp_verified", None)
    next_url = request.session.pop("google_signup_next_url", None)
    if not next_url:
        if user and user.user_type == "consultant":
            # Check if profile is completed
            cp = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == user_id).first()
            next_url = "/consultant/onboarding" if not cp or not cp.is_profile_completed else "/consultant"
        else:
            next_url = "/app"
            
    return RedirectResponse(url=next_url, status_code=303)


