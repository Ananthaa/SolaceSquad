@app.get("/api/profile-photo/{user_id}")
async def serve_profile_photo(user_id: int, db: Session = Depends(get_db)):
    """Proxy: stream a consultant's profile photo from GCS.
    The GCS bucket uses uniform access (not public), so photos are served via
    this backend endpoint which authenticates with GCS using the service account.
    """
    try:
        import asyncio
        from google.cloud import storage as gcs_storage
        from fastapi.responses import Response as BinaryResponse

        profile = db.query(ConsultantProfile).filter(
            ConsultantProfile.user_id == user_id
        ).first()
        if not profile or not profile.photo_url:
            raise HTTPException(status_code=404, detail="No photo")

        photo_url = profile.photo_url
        if "storage.googleapis.com/" not in photo_url:
            raise HTTPException(status_code=404, detail="Invalid photo URL")

        after = photo_url.split("storage.googleapis.com/", 1)[1]
        bucket_name, blob_path = after.split("/", 1)

        def _download():
            client = gcs_storage.Client()
            blob = client.bucket(bucket_name).blob(blob_path)
            return blob.download_as_bytes(), blob.content_type or "image/jpeg"

        img_bytes, content_type = await asyncio.get_event_loop().run_in_executor(None, _download)
        return BinaryResponse(
            content=img_bytes,
            media_type=content_type,
            headers={"Cache-Control": "public, max-age=86400"},  # cache 24h
        )
    except HTTPException:
        raise
    except Exception as e:
        print(f"[ProfilePhoto] Error for user {user_id}: {e}")
        raise HTTPException(status_code=404, detail="Photo not available")


@app.get("/api/admin/view-cv/{profile_id}")
async def admin_view_cv(profile_id: int, request: Request, db: Session = Depends(get_db)):
    """Admin-only: stream a consultant's CV PDF from private GCS bucket."""
    admin_id = request.session.get("user_id")
    admin = db.query(User).filter(User.id == admin_id).first()
    if not admin or admin.user_type != "admin":
        raise HTTPException(status_code=403, detail="Forbidden")

    profile = db.query(ConsultantProfile).filter(ConsultantProfile.id == profile_id).first()
    if not profile or not profile.cv_url:
        raise HTTPException(status_code=404, detail="CV not found")

    cv_url = profile.cv_url
    if "storage.googleapis.com/" not in cv_url:
        # Already a direct/signed URL â€” just redirect
        return RedirectResponse(cv_url)

    try:
        import asyncio
        from google.cloud import storage as gcs_storage
        from fastapi.responses import Response as BinaryResponse

        after = cv_url.split("storage.googleapis.com/", 1)[1]
        bucket_name, blob_path = after.split("/", 1)

        def _download():
            client = gcs_storage.Client()
            blob = client.bucket(bucket_name).blob(blob_path)
            data = blob.download_as_bytes()
            ct = blob.content_type or "application/pdf"
            return data, ct

        cv_bytes, content_type = await asyncio.get_event_loop().run_in_executor(None, _download)
        filename = blob_path.split("/")[-1] or "cv.pdf"
        return BinaryResponse(
            content=cv_bytes,
            media_type=content_type,
            headers={
                "Content-Disposition": f'inline; filename="{filename}"',
                "Cache-Control": "private, max-age=300",
            },
        )
    except Exception as e:
        print(f"[AdminCV] Error for profile {profile_id}: {e}")
        raise HTTPException(status_code=404, detail="CV not available")


@app.get("/api/call/ice-servers")
async def get_ice_servers(request: Request):
    """
    Return ICE server configuration for WebRTC.
    Priority:
      1. Self-hosted Coturn (TURN_HOST + TURN_SECRET env vars) â€” HMAC credentials
      2. Metered.ca API (METERED_API_KEY) â€” managed TURN
      3. Free openrelay fallback (unreliable, development only)
    """
    import urllib.request
    import json as jsonlib
    import hmac
    import hashlib
    import base64
    import time as time_mod

    stun_servers = [
        {"urls": "stun:stun.l.google.com:19302"},
        {"urls": "stun:stun1.l.google.com:19302"},
        {"urls": "stun:stun.cloudflare.com:3478"},
    ]

    # â”€â”€ Option 1: Self-hosted Coturn with HMAC time-limited credentials â”€â”€
    turn_host = os.environ.get("TURN_HOST", "")
    turn_secret = os.environ.get("TURN_SECRET", "")

    if turn_host and turn_secret:
        # Generate RFC-5766 HMAC-SHA1 time-limited credentials (Coturn REST API format)
        # CRITICAL: username MUST be "timestamp:user" — Coturn's use-auth-secret requires
        # a colon-separated "timestamp:username" value. Sending only the timestamp causes
        # silent auth failure and no relay candidates are ever issued.
        ttl = 24 * 3600  # 24 hours
        timestamp = int(time_mod.time()) + ttl
        username = f"{timestamp}:solacesquad"  # Format: timestamp:anystring
        credential = base64.b64encode(
            hmac.new(turn_secret.encode("utf-8"), username.encode("utf-8"), hashlib.sha1).digest()
        ).decode("utf-8")

        coturn_servers = [
            {
                "urls": f"turn:{turn_host}:3478",
                "username": username,
                "credential": credential
            },
            {
                "urls": f"turn:{turn_host}:3478?transport=tcp",
                "username": username,
                "credential": credential
            },
            {
                "urls": f"turns:{turn_host}:5349",
                "username": username,
                "credential": credential
            },
            {
                "urls": f"turns:{turn_host}:5349?transport=tcp",
                "username": username,
                "credential": credential
            },
            {
                "urls": f"turns:{turn_host}:443",
                "username": username,
                "credential": credential
            },
            {
                "urls": f"turns:{turn_host}:443?transport=tcp",
                "username": username,
                "credential": credential
            },
        ]
        print(f"[ICE] Using self-hosted Coturn at {turn_host}")
        return {"iceServers": stun_servers + coturn_servers}

    # â”€â”€ Option 2: Metered.ca managed TURN â”€â”€
    metered_api_key = os.environ.get("METERED_API_KEY", "")
    metered_app_name = os.environ.get("METERED_APP_NAME", "solacesquad")

    if metered_api_key:
        try:
            url = f"https://{metered_app_name}.metered.live/api/v1/turn/credentials?apiKey={metered_api_key}"
            req = urllib.request.urlopen(url, timeout=5)
            metered_servers = jsonlib.loads(req.read())
            return {"iceServers": stun_servers + metered_servers}
        except Exception as e:
            print(f"[ICE] Metered.ca fetch failed: {e}, using fallback TURN")

    # â”€â”€ Option 3: Free fallback (development only, unreliable) â”€â”€
    fallback_turn = [
        {"urls": "turn:openrelay.metered.ca:80",
         "username": "openrelayproject", "credential": "openrelayproject"},
        {"urls": "turn:openrelay.metered.ca:443?transport=tcp",
         "username": "openrelayproject", "credential": "openrelayproject"},
    ]
    print("[ICE] WARNING: Using free openrelay TURN â€” set TURN_HOST+TURN_SECRET for production")
    return {"iceServers": stun_servers + fallback_turn}


@app.get("/app/call/{appointment_id}", response_class=HTMLResponse)
async def call_room(
    appointment_id: int,
    request: Request,
    db: Session = Depends(get_db)
):
    """Call room page for voice calling"""
    try:
        # Check if user is logged in
        user_id = request.session.get("user_id")
        if not user_id:
            return RedirectResponse(url="/login", status_code=303)
            
        try:
            user_id = int(str(user_id))
        except (ValueError, TypeError):
            request.session.clear()
            return RedirectResponse(url="/login", status_code=303)
        
        # Get user
        user = db.query(User).filter(User.id == user_id).first()
        if not user:
            request.session.clear()
            return RedirectResponse(url="/login", status_code=303)
        
        # Get appointment
        appointment = db.query(Appointment).filter(Appointment.id == appointment_id).first()
        if not appointment:
            raise HTTPException(status_code=404, detail="Appointment not found")

        # Block if not active
        if appointment.status in ("completed", "cancelled", "reschedule_pending"):
            return RedirectResponse(url="/app?error=appointment_not_active", status_code=303)

        # Late join check
        now_utc = datetime.utcnow()
        if user.user_type == "user" and now_utc > appointment.appointment_date + timedelta(minutes=10):
            # Check if call session already started
            call_session = db.query(CallSession).filter(CallSession.appointment_id == appointment_id).first()
            if not call_session or call_session.actual_start is None:
                appointment.status = "cancelled"
                appointment.refund_status = "forfeited"
                if call_session:
                    call_session.status = "cancelled"
                db.commit()
                print(f"[LATE JOIN] Appointment {appointment_id} cancelled (no show after 10 mins).")
                return RedirectResponse(url="/app?error=late_join", status_code=303)
        
        # Verify user is part of this appointment
        if user.user_type == "user" and appointment.user_id != user_id:
            raise HTTPException(status_code=403, detail="Not authorized")
        elif user.user_type == "consultant":
            # For consultants, check if their consultant profile matches the appointment
            consultant_profile = db.query(ConsultantProfile).filter(
                ConsultantProfile.user_id == user_id
            ).first()
            if not consultant_profile or appointment.consultant_id != consultant_profile.id:
                raise HTTPException(status_code=403, detail="Not authorized")
        
        # Get or create call session
        call_session = db.query(CallSession).filter(
            CallSession.appointment_id == appointment_id
        ).first()
        
        if not call_session:
            # Get consultant profile to get user_id
            consultant_profile = db.query(ConsultantProfile).filter(
                ConsultantProfile.id == appointment.consultant_id
            ).first()
            
            if not consultant_profile:
                raise HTTPException(status_code=404, detail="Consultant not found")
            
            # Create new call session
            room_id = f"call_{appointment_id}_{uuid.uuid4().hex[:8]}"
            call_session = CallSession(
                appointment_id=appointment_id,
                room_id=room_id,
                user_id=appointment.user_id,
                consultant_id=consultant_profile.user_id,  # Use consultant's user_id, not profile id
                scheduled_start=appointment.appointment_date,
                scheduled_end=appointment.appointment_date + timedelta(minutes=appointment.duration_minutes),
                status="pending"
            )
            db.add(call_session)
            db.commit()
            db.refresh(call_session)

        # Mark appointment as in_progress immediately when the first participant enters the call page
        if appointment.status == "scheduled":
            appointment.status = "in_progress"
            if call_session:
                if call_session.actual_start is None:
                    call_session.actual_start = datetime.utcnow()
                call_session.status = "active"
            db.commit()
            db.refresh(appointment)
            if call_session:
                db.refresh(call_session)
        
        # Get consultant info (appointment.consultant_id is the ConsultantProfile ID)
        consultant_profile_obj = db.query(ConsultantProfile).filter(
            ConsultantProfile.id == appointment.consultant_id
        ).first()
        
        # Get user info for context
        user_name = user.name
        # Check profile for name preference
        user_profile = db.query(UserProfile).filter(UserProfile.user_id == user.id).first()
        if user_profile and user_profile.preferred_name:
            user_name = user_profile.preferred_name
        elif user_profile and user_profile.full_name:
            user_name = user_profile.full_name
            
        initials = get_initials(user_name)
        
        # Get patient info
        patient = db.query(User).filter(User.id == appointment.user_id).first()
        
        # Build navigation items based on user type
        if user.user_type == "consultant":
            nav_items = [
                {"icon": "layout-dashboard", "label": "Dashboard", "href": "/app/consultant", "key": "dashboard"},
                {"icon": "calendar", "label": "Appointments", "href": "/app/consultant/appointments", "key": "appointments"},
                {"icon": "users", "label": "Patients", "href": "/app/consultant/patients", "key": "patients"},
                {"icon": "message-square", "label": "Messages", "href": "/app/messages", "key": "messages"}
            ]
        else:
            nav_items = [
                {"icon": "layout-dashboard", "label": "Dashboard", "href": "/app", "key": "dashboard"},
                {"icon": "activity", "label": "Vitals", "href": "/app/vitals", "key": "vitals"},
                {"icon": "smile", "label": "Mood", "href": "/app/mood", "key": "mood"},
                {"icon": "users", "label": "Consultants", "href": "/app/consultants", "key": "consultants"},
                {"icon": "message-square", "label": "Messages", "href": "/app/messages", "key": "messages"},
                {"icon": "bot", "label": "Emora - Your buddy", "href": "/app/chat", "key": "chat"}
            ]
        
        # Check if the user's plan supports recording
        from subscription_routes import get_user_plan_caps
