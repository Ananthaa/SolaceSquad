    Accepts the full edited HTML from the Canvas Editor.
    Writes to home_published.html on disk and saves a DB snapshot.
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)
    user = db.query(User).filter(User.id == user_id).first()
    if not user or user.user_type != "admin":
        return JSONResponse({"success": False, "error": "Admin only"}, status_code=403)

    import os as _os
    try:
        data = await request.json()
        html = data.get("html", "").strip()
        if not html:
            return JSONResponse({"success": False, "error": "No HTML provided"})

        # â”€â”€ Strip canvas-editor artifacts before saving â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        import re as _re
        # Use the unique id="canvas-editor-injected" to strip only the exact script block
        html = _re.sub(
            r'<script\s+id=["\']canvas-editor-injected["\'][^>]*>[\s\S]*?</script>',
            '',
            html,
            flags=_re.IGNORECASE
        )
        # Fallback: also strip by [CanvasEditor] marker WITHIN a single script block only
        html = _re.sub(
            r'<script(?:\s[^>]*)?>(?:(?!</script>).)*\[CanvasEditor\](?:(?!</script>).)*</script>',
            '',
            html,
            flags=_re.DOTALL | _re.IGNORECASE
        )
        # 2. Remove editor selection attribute from all elements
        html = html.replace(' data-ce-selected="1"', '').replace(' data-ce-selected=""', '')
        # 3. Remove inline outline styles added by the editor hover/select
        html = _re.sub(r'(?<=style=")[^"]*outline:\s*2px\s+(?:dashed|solid)\s+#[0-9a-fA-F]{6}[^"]*', 
                       lambda m: m.group(0).replace(m.group(0)[m.group(0).find('outline:'):m.group(0).find('outline:')+50].split(';')[0]+';', '').strip(), 
                       html)
        # â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

        # Write to disk
        pub_path = _os.path.join(_os.path.dirname(__file__), "templates", "pages", "home_published.html")
        with open(pub_path, "w", encoding="utf-8") as f:
            f.write(html)

        # Upsert canvas snapshot record
        snap = db.query(HomePageSection).filter(HomePageSection.title == "__canvas_snapshot__").first()
        if snap:
            snap.html_content = html
            snap.is_published = True
            snap.updated_at = datetime.utcnow()
        else:
            snap = HomePageSection(
                title="__canvas_snapshot__",
                html_content=html,
                css_content="",
                order_index=0,
                is_published=True,
                created_by=user_id,
            )
            db.add(snap)
        db.commit()

        return JSONResponse({"success": True, "message": "Page saved"})
    except Exception as e:
        db.rollback()
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)



