def rate_heart_rate(hr: int, gender: str, age: int) -> tuple:
    """
    Rate heart rate per the SolaceSquad reference table.
    Returns (rating_label, score) e.g. ('Best', 100)

    Table:
    Male 18+  : Best 50-60 | Better 60-70 | Good 70-80 | Poor <50 or >80
    Male <18  : Best 60-70 | Better 70-80 | Good 80-110 | Poor <60 or >110
    Female 18+: Best 45-65 | Better 65-75 | Good 75-90 | Poor <45 or >90
    Female <18: Best 60-70 | Better 70-80 | Good 80-110 | Poor <60 or >110
    """
    g = (gender or "").strip().lower()   # 'male', 'female', or ''
    is_adult = (age is None) or (age >= 18)   # default to adult if unknown
    is_female = g in ("female", "f", "woman", "girl")
    is_male   = g in ("male",   "m", "man",  "boy")

    if is_male and is_adult:
        # Male 18+
        if 50 <= hr <= 60:   return ("Best",   100)
        if 60 <  hr <= 70:   return ("Better",  80)
        if 70 <  hr <= 80:   return ("Good",    60)
        return ("Poor", 50)

    elif is_male and not is_adult:
        # Male <18
        if 60 <= hr <= 70:   return ("Best",   100)
        if 70 <  hr <= 80:   return ("Better",  80)
        if 80 <  hr <= 110:  return ("Good",    60)
        return ("Poor", 50)

    elif is_female and is_adult:
        # Female 18+
        if 45 <= hr <= 65:   return ("Best",   100)
        if 65 <  hr <= 75:   return ("Better",  80)
        if 75 <  hr <= 90:   return ("Good",    60)
        return ("Poor", 50)

    elif is_female and not is_adult:
        # Female <18
        if 60 <= hr <= 70:   return ("Best",   100)
        if 70 <  hr <= 80:   return ("Better",  80)
        if 80 <  hr <= 110:  return ("Good",    60)
        return ("Poor", 50)

    else:
        # Gender unknown -- use generic adult ranges as fallback
        if 50 <= hr <= 90:   return ("Good",    60)
        if 60 <= hr <= 80:   return ("Better",  80)
        return ("Poor", 50)


def rate_blood_pressure(sys: int, dia: int, age: int = None) -> tuple:
    """
    Rate blood pressure per the SolaceSquad reference table.
    Returns (rating_label, score) e.g. ('Best', 100)

    Table (Gender=Any, same for 18+ and <18):
      Best   (100): Systolic 116-120  AND  Diastolic 76-80
      Better  (80): Systolic <=115    AND  Diastolic <=75
      Good    (60): Systolic 120-139  AND  Diastolic 80-90
      Poor    (50): Systolic >140     OR   Diastolic >90
    """
    # Check Poor first (highest risk -- either reading in danger zone)
    if sys > 140 or dia > 90:
        return ("Poor", 50)

    # Good: elevated / Stage 1 hypertension
    if 120 <= sys <= 139 and 80 <= dia <= 90:
        return ("Good", 60)

    # Best: ideal normal range
    if 116 <= sys <= 120 and 76 <= dia <= 80:
        return ("Best", 100)

    # Better: optimal / low-normal (<=115 / <=75)
    if sys <= 115 and dia <= 75:
        return ("Better", 80)

    # Edge cases (e.g. sys=118, dia=70 -- systolic normal, diastolic low)
    # Use the more conservative individual rating
    if sys > 140 or dia > 90:
        return ("Poor", 50)
    if sys >= 120 or dia >= 80:
        return ("Good", 60)
    return ("Better", 80)


def rate_spo2(spo2: int) -> tuple:
    """
    Rate SpO2 per the SolaceSquad reference table.
    Returns (rating_label, score)  e.g. ('Best', 100)

    Table (Gender=Any, Age=Any):
      Best   (100): 99-100%
      Better  (80): 97-98%
      Good    (60): 90-96%
      Poor    (50): <90%
    """
    if spo2 >= 99:              return ("Best",   100)
    if 97 <= spo2 <= 98:        return ("Better",  80)
    if 90 <= spo2 <= 96:        return ("Good",    60)
    return ("Poor", 50)


def rate_respiration(rr: int, age: int = None) -> tuple:
    """
    Rate respiration rate per the SolaceSquad reference table.
    Returns (rating_label, score)  e.g. ('Best', 100)

    18+ (Adult) table  -- Gender=Any:
      Best   (100): 10-12 breaths/min
      Better  (80): 13-14 breaths/min
      Good    (60): 15-20 breaths/min
      Poor    (50): >20 OR <10 breaths/min

    <18 (Child) table  -- Gender=Any:
      Best   (100): 18-20 breaths/min
      Better  (80): 21-24 breaths/min
      Good    (60): 24-30 breaths/min   (25-30 to avoid tie with Better)
      Poor    (50): >30 OR <18 breaths/min
    """
    is_adult = (age is None or age >= 18)   # default adult when unknown

    if is_adult:
        if 10 <= rr <= 12:  return ("Best",   100)
        if 13 <= rr <= 14:  return ("Better",  80)
        if 15 <= rr <= 20:  return ("Good",    60)
        return ("Poor", 50)   # >20 or <10
    else:
        # Children (<18) have naturally higher respiratory rates
        if 18 <= rr <= 20:  return ("Best",   100)
        if 21 <= rr <= 24:  return ("Better",  80)
        if 25 <= rr <= 30:  return ("Good",    60)
        return ("Poor", 50)   # >30 or <18



def compute_and_save_wellness(user_id: int, db, for_date: date = None) -> float:
    """
    Calculate and upsert DailyWellnessScore for today.

    Formula:  Overall Wellness = 50% * Health + 35% * Emotional Wellness + 15% * Lifestyle

    Data sources:
      health_score            - latest vitals_records.health_score  (fallback: 0)
      emotional_wellness_score- latest mood_entries.emotional_wellness_score (fallback: 0)
      lifestyle_score         - today's total workout mins â†’ rate_workout() (0 if no log today)
    """
    today = for_date or datetime.utcnow().date()

    # 1. Latest health score
    latest_vitals = (
        db.query(VitalsRecord)
        .filter(VitalsRecord.user_id == user_id, VitalsRecord.health_score.isnot(None))
        .order_by(VitalsRecord.timestamp.desc())
        .first()
    )
    hs = float(latest_vitals.health_score) if latest_vitals else 0.0

    # 2. Latest emotional wellness score
    latest_mood = (
        db.query(MoodEntry)
        .filter(MoodEntry.user_id == user_id, MoodEntry.emotional_wellness_score.isnot(None))
        .order_by(MoodEntry.timestamp.desc())
        .first()
    )
    ews = int(latest_mood.emotional_wellness_score) if latest_mood else 0

    # 3. Today's lifestyle score (0 if no workout logged today)
    today_mins = (
        db.query(func.coalesce(func.sum(WorkoutLog.duration_min), 0))
        .filter(WorkoutLog.user_id == user_id, WorkoutLog.log_date == today)
        .scalar() or 0
    )
    ls = rate_workout(int(today_mins))

    # 4. Weighted composite
    overall = round(0.50 * hs + 0.35 * ews + 0.15 * ls, 1)

    # 5. Upsert into daily_wellness_scores
    row = (
        db.query(DailyWellnessScore)
        .filter(DailyWellnessScore.user_id == user_id,
                DailyWellnessScore.score_date == today)
        .first()
    )
    if row:
        row.health_score             = hs
        row.emotional_wellness_score = ews
        row.lifestyle_score          = ls
        row.overall_wellness_score   = overall
        row.updated_at               = datetime.utcnow()
    else:
        row = DailyWellnessScore(
            user_id=user_id,
            score_date=today,
            health_score=hs,
            emotional_wellness_score=ews,
            lifestyle_score=ls,
            overall_wellness_score=overall,
        )
        db.add(row)
    db.commit()
    print(f"[WELLNESS] user={user_id} date={today}: "
          f"H={hs} EW={ews} L={ls} => Overall={overall}")
    return overall


def rate_workout(total_minutes: int) -> int:
    """
    Calculate lifestyle score from total workout minutes for the day.
    Returns an integer score: 0 / 25 / 50 / 75 / 100.

    Table (Gender=Any, Age=Any):
      > 30 min  => 100
      15-30 min =>  75
      10-15 min =>  50
       5-10 min =>  25
      <  5 min  =>   0  (includes 0 = no workout logged)
    """
    if total_minutes > 30:   return 100
    if total_minutes >= 15:  return  75
    if total_minutes >= 10:  return  50
    if total_minutes >=  5:  return  25
    return 0


def rate_mood(mood: str) -> int:
    """
    Calculate emotional wellness score from mood label.
    Returns an integer score (0-100).

    Table (Gender=Any, Age=Any):
      HAPPY    => 100
      NEUTRAL  =>  80
      SAD      =>  75
      ANXIOUS  =>  70
      ANGRY    =>  50
    """
    return {
        "happy":   100,
        "neutral":  80,
        "sad":      75,
        "anxious":  70,
        "angry":    50,
    }.get(mood.strip().lower(), 75)   # default 75 (SAD) for unmapped values


def rate_temperature(temp_c: float, age: int = None) -> tuple:
    """
    Rate body temperature per the SolaceSquad reference table.
    Table values are in Fahrenheit (Gender=Any, Age=Any).
    Input is Celsius (as stored in DB); converted to Fahrenheit internally.

    Reference table (Fahrenheit):
      Best   (100): 98.6 degF          => ~37.0 degC
      Better  (80): 98.2-98.5 degF     => 36.8-36.9 degC
      Good    (60): 98.7-100.4 degF    => 37.1-38.0 degC
      Poor    (50): >100.4 or <97.7 degF => >38.0 or <36.5 degC
    """
    temp_f = round((temp_c * 9 / 5) + 32, 1)   # convert C -> F, 1 decimal

    if temp_f > 100.4 or temp_f < 97.7:   return ("Poor",   50)
    if 98.55 <= temp_f <= 98.65:           return ("Best",  100)  # 98.6 degF
    if 98.2  <= temp_f <= 98.5:            return ("Better",  80)
    if 98.7  <= temp_f <= 100.4:           return ("Good",    60)
    # Remaining gap 97.7-98.2 (slightly cool but not poor)
    return ("Good", 60)


def calculate_health_score(
    vitals_data: dict,
    db: Session = None,
    user_id: int = None,
    gender: str = None,
    age: int = None
) -> float:
    """
    Calculate an overall health score (0-100) based on vitals data.
    Heart rate is rated using gender/age-specific ranges per the SolaceSquad table.
    Other vitals use standard clinical reference ranges.
    If db and user_id are provided, fetches missing data from history.
    """
    merged_data = vitals_data.copy()

    # Resolve gender/age from UserProfile if not supplied
    if db and user_id and (gender is None or age is None):
        try:
            prof = db.query(UserProfile).filter(UserProfile.user_id == user_id).first()
            if prof:
                if gender is None: gender = prof.gender
                if age    is None: age    = prof.age
        except Exception:
            pass

    if db and user_id:
        try:
            missing_keys = [k for k in ["heart_rate", "spo2", "respiratory_rate",
                                        "temperature", "blood_pressure_systolic"]
                            if k not in merged_data or merged_data[k] is None]
            if missing_keys:
                records = db.query(VitalsRecord).filter(
                    VitalsRecord.user_id == user_id
                ).order_by(VitalsRecord.timestamp.desc()).limit(20).all()
                for r in records:
                    if merged_data.get("heart_rate")              is None and r.heart_rate:              merged_data["heart_rate"]              = r.heart_rate
                    if merged_data.get("spo2")                    is None and r.spo2:                    merged_data["spo2"]                    = r.spo2
                    if merged_data.get("respiratory_rate")        is None and r.respiratory_rate:        merged_data["respiratory_rate"]        = r.respiratory_rate
                    if merged_data.get("temperature")             is None and r.temperature:             merged_data["temperature"]             = r.temperature
                    if merged_data.get("blood_pressure_systolic") is None and r.blood_pressure_systolic: merged_data["blood_pressure_systolic"] = r.blood_pressure_systolic
                    if merged_data.get("blood_pressure_diastolic")is None and r.blood_pressure_diastolic:merged_data["blood_pressure_diastolic"]= r.blood_pressure_diastolic
        except Exception as e:
            print(f"Error fetching historical vitals for score: {e}")

    # â”€â”€ Weighted health score â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    # Formula: 20%*HR + 35%*BP + 25%*SpO2 + 15%*RR + 5%*Temp
    # If a vital is missing its weight is redistributed proportionally.
    WEIGHTS = {
        "hr":   0.20,
        "bp":   0.35,
        "spo2": 0.25,
        "rr":   0.15,
        "temp": 0.05,
    }
    vital_scores = {}

    hr = merged_data.get("heart_rate")
    if hr:
        _, s = rate_heart_rate(int(hr), gender, age)
        vital_scores["hr"] = s

    spo2 = merged_data.get("spo2")
    if spo2:
        _, s = rate_spo2(int(spo2))
        vital_scores["spo2"] = s

    rr = merged_data.get("respiratory_rate")
    if rr:
        _, s = rate_respiration(int(rr), age)
        vital_scores["rr"] = s

    temp = merged_data.get("temperature")
    if temp:
        _, s = rate_temperature(float(temp), age)
        vital_scores["temp"] = s

    sys = merged_data.get("blood_pressure_systolic")
    dia = merged_data.get("blood_pressure_diastolic")
    if sys and dia:
        _, s = rate_blood_pressure(int(sys), int(dia), age)
        vital_scores["bp"] = s

    if not vital_scores:
        return 0.0

    # Redistribute weights for missing vitals proportionally
    available_weight = sum(WEIGHTS[k] for k in vital_scores)
    weighted_sum = sum(vital_scores[k] * WEIGHTS[k] for k in vital_scores)
    return round(weighted_sum / available_weight, 1)



@app.post("/app/vitals/save")
async def save_vitals(request: Request, db: Session = Depends(get_db)):
    """Save comprehensive vitals reading to database"""
    try:
        # Check if user is logged in
        user_id = request.session.get("user_id")
        if not user_id:
            return {"success": False, "error": "User not logged in"}
        
        data = await request.json()
        
        # Create vitals record in database with all available measurements
        # -- Resolve user gender/age for ratings --
        _gender = None
        _age    = None
        try:
            _prof = db.query(UserProfile).filter(UserProfile.user_id == user_id).first()
            if _prof:
                _gender = _prof.gender
                _age    = _prof.age
        except Exception:
            pass

        # -- Compute individual vital ratings (with historical fallback) --------
        # Extract values from current scan first
        _hr   = int(data.get("heart_rate"))       if data.get("heart_rate")       else None
        _spo2 = int(data.get("spo2"))             if data.get("spo2")             else None
        _rr   = int(data.get("respiratory_rate")) if data.get("respiratory_rate") else None
        _temp = float(data.get("temperature"))    if data.get("temperature")      else None
        _sys  = int(data.get("blood_pressure_systolic"))  if data.get("blood_pressure_systolic")  else None
        _dia  = int(data.get("blood_pressure_diastolic")) if data.get("blood_pressure_diastolic") else None

        # Fall back to latest available DB record for any missing vital
        if any(v is None for v in [_hr, _spo2, _rr, _temp, _sys, _dia]):
            try:
                latest = (db.query(VitalsRecord)
                          .filter(VitalsRecord.user_id == user_id)
                          .order_by(VitalsRecord.timestamp.desc())
                          .first())
                if latest:
                    if _hr   is None and latest.heart_rate:              _hr   = latest.heart_rate
                    if _spo2 is None and latest.spo2:                    _spo2 = latest.spo2
                    if _rr   is None and latest.respiratory_rate:        _rr   = latest.respiratory_rate
                    if _temp is None and latest.temperature:             _temp = latest.temperature
                    if _sys  is None and latest.blood_pressure_systolic: _sys  = latest.blood_pressure_systolic
                    if _dia  is None and latest.blood_pressure_diastolic:_dia  = latest.blood_pressure_diastolic
                    print(f"[INFO] save_vitals: filled missing vitals from record id={latest.id} "
                          f"(hr={_hr}, spo2={_spo2}, rr={_rr}, temp={_temp}, sys={_sys}, dia={_dia})")
            except Exception as e:
                print(f"[WARN] save_vitals: could not fetch historical vitals: {e}")

        # Rate each vital (None â†’ rating stays NULL if still missing after fallback)
        _hr_label,   _hr_score   = rate_heart_rate(_hr, _gender, _age)    if _hr             else (None, None)
