            ConsultantProfile.is_available == True
        ).first()

        if not consultant:
            return JSONResponse({"success": False, "error": "No consultants available right now. Please try again shortly."})

        # Book appointment 5 minutes from now for 30 minutes
        from datetime import timedelta
        appointment_time = datetime.utcnow() + timedelta(minutes=5)

        appointment = Appointment(
            user_id=user_id,
            consultant_id=consultant.id,
