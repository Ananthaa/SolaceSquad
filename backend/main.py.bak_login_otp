        # In production, tables already exist - startup DB check failure is non-fatal
        print(f"[WARN] startup init_db failed (tables may already exist): {e}")

    # ── Run startup DDL migrations via a DIRECT psycopg2 connection ──────────
    # CRITICAL: Never use SQLAlchemy ORM sessions or engine.raw_connection() for
    # DDL migrations. Both interact with the connection pool. A failed DDL inside
    # the pool leaves connections in InFailedSqlTransaction state, breaking ALL
    # subsequent requests. Instead, open a brand-new psycopg2 connection here,
    # set autocommit=True, run all DDL, then close it. Pool is never touched.
