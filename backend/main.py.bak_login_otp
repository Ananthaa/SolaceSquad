@app.get("/sitemap.xml", include_in_schema=False)
async def sitemap(db_gen=Depends(get_db)):
    """Dynamic XML sitemap for all public pages including blog posts."""
    # Resolve generator to session
    db = next(db_gen) if hasattr(db_gen, '__next__') else db_gen
    public_paths = [
        # ── Core public pages (highest priority) ──────────────────────────
        ("/",                       "1.0", "daily"),
        # ── Service / condition pages ──────────────────────────────────────
        ("/mental-wellness",        "0.9", "weekly"),
        ("/physical-wellness",      "0.9", "weekly"),
        ("/professional-wellness",  "0.9", "weekly"),
        # ── Discovery & info pages ─────────────────────────────────────────
        ("/faq",                    "0.8", "monthly"),
        ("/our-story",              "0.8", "monthly"),
        ("/blog",                   "0.8", "weekly"),
        # ── Legal pages ───────────────────────────────────────────────────
        ("/privacy",                "0.4", "yearly"),
        ("/terms",                  "0.4", "yearly"),
        ("/refund",                 "0.4", "yearly"),
        ("/cookies",                "0.3", "yearly"),
    ]
    today = _dt.date.today().isoformat()
    base = "https://www.solacesquad.com"
    xml = '<?xml version="1.0" encoding="UTF-8"?>\n'
    xml += '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n'
    for path, priority, freq in public_paths:
        xml += f'  <url>\n'
        xml += f'    <loc>{base}{path}</loc>\n'
        xml += f'    <lastmod>{today}</lastmod>\n'
        xml += f'    <changefreq>{freq}</changefreq>\n'
        xml += f'    <priority>{priority}</priority>\n'
        xml += f'  </url>\n'
    # Dynamically add all published blog posts
    try:
        from models import BlogPost as _BP
        posts = db.query(_BP.slug, _BP.updated_at).filter(_BP.status == "published").all()
        for slug, updated_at in posts:
            lastmod = updated_at.date().isoformat() if updated_at else today
            xml += f'  <url>\n'
            xml += f'    <loc>{base}/blog/{slug}</loc>\n'
            xml += f'    <lastmod>{lastmod}</lastmod>\n'
            xml += f'    <changefreq>weekly</changefreq>\n'
            xml += f'    <priority>0.7</priority>\n'
            xml += f'  </url>\n'
    except Exception:
        pass
    xml += '</urlset>'
    return _Response(content=xml, media_type="application/xml",
                     headers={"Cache-Control": "public, max-age=3600"})


