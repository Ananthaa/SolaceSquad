        if _str("engagement_type"): profile.engagement_type = _str("engagement_type")
        if _str("intended_hours"): profile.intended_hours = _str("intended_hours")
        if _str("availability_notes"): profile.availability_notes = _str("availability_notes")
        cms = form.getlist("counselling_methods")
        if cms: profile.counselling_methods = _json.dumps(cms)
        eas = form.getlist("expertise_areas")
        if eas: profile.expertise_areas = _json.dumps(eas)
        if _str("qacp_certified"): profile.qacp_certified = _bool_radio("qacp_certified")
        if _str("expected_hourly_fee"): profile.hourly_rate = _float("expected_hourly_fee")
        ta = ", ".join(form.getlist("target_audience") or [])
