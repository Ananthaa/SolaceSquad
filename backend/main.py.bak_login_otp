@app.post("/api/auth/phone-otp/send")
async def send_phone_otp_api(request: Request, db: Session = Depends(get_db)):
    """Generate and send an OTP via SMS (MSG91)"""
    try:
        data = await request.json()
        phone = (data.get("phone") or "").strip().replace(" ", "")
        
        if not phone:
            return JSONResponse({"success": False, "error": "Phone number is required"}, status_code=400)

        # Generate secure random 6-digit OTP
        import secrets as _sec
        otp = "".join(str(_sec.randbelow(10)) for _ in range(6))
        
        # Store in DB
        db.query(OTPVerification).filter(OTPVerification.phone_number == phone).delete()
        db.add(OTPVerification(
            phone_number=phone,
            otp_code=otp,
            expires_at=datetime.utcnow() + timedelta(minutes=10),
        ))
        db.commit()

        # Send via MSG91
        provider = FallbackOTP()
        result = provider.send_otp(phone, otp)
        
        if result.get("success"):
            return {"success": True, "message": "OTP sent successfully"}
        else:
            return JSONResponse({"success": False, "error": result.get("message", "Failed to send SMS")}, status_code=500)

    except Exception as e:
        print(f"Phone OTP Send error: {e}")
        return JSONResponse({"success": False, "error": "Internal server error"}, status_code=500)

