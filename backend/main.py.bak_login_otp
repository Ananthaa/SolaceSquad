# ============================================================================
# MESSAGING FEATURE
# Users can message consultants they've had appointments with.
# All messages are filtered to strip phone numbers and email addresses (PII).
# ============================================================================

import re as _msg_re

# Regex patterns to detect phone numbers and email addresses in message content
_PHONE_PATTERN = _msg_re.compile(
    r'(?<!\w)(\+?[\d\s\-().]{7,15}\d)(?!\w)',
)
_EMAIL_PATTERN = _msg_re.compile(
    r'[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}',
)


def _contains_pii(text: str) -> bool:
    """Return True if the text contains a phone number or email address."""
    if _EMAIL_PATTERN.search(text):
        return True
    # Only flag if 7+-digit sequences exist (avoid false positives on short numbers)
    phone_match = _PHONE_PATTERN.search(text)
    if phone_match:
        digits = _msg_re.sub(r'\D', '', phone_match.group())
        if len(digits) >= 7:
            return True
    return False


