@app.get("/api/homepage/import-from-file")
async def import_homepage_from_file(request: Request, db: Session = Depends(get_db)):
    """
    Extract the {% block content %} from home.html, render it through Jinja2
    (expanding all {% for %} loops and {{ variables }}), then return each
    <section> block as an importable builder section.

    Avoids rendering base.html so url_for / static assets aren't needed.
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return {"success": False, "error": "Unauthorized"}
    user = db.query(User).filter(User.id == user_id).first()
    if not user or user.user_type != "admin":
        return {"success": False, "error": "Admin access required"}

    import re, os
    from jinja2 import Environment, BaseLoader

    template_path = os.path.join(os.path.dirname(__file__), "templates", "pages", "home.html")
    try:
        with open(template_path, "r", encoding="utf-8") as f:
            raw = f.read()
    except Exception as e:
        return {"success": False, "error": f"Could not read home.html: {e}"}

    # -- Step 1: Pull just the content between {% block content %} and {% endblock %}
    block_match = re.search(
        r'\{%[-\s]*block\s+content\s*[-\s]*%\}(.*?)\{%[-\s]*endblock\s*[-\s]*%\}',
        raw, re.DOTALL | re.IGNORECASE
    )
    if not block_match:
        return {"success": False, "error": "Could not find {% block content %} in home.html"}

    content_snippet = block_match.group(1)

    # Remove {% include "..." %} tags (header/footer) -- not needed for section extraction
    content_snippet = re.sub(r'\{%-?\s*include\s+["\'][^"\']+["\']\s*-?%\}', '', content_snippet)

    # -- Step 2: Render the snippet through Jinja2 (expands loops, variables, etc.)
    try:
        jinja_env = Environment(loader=BaseLoader(), autoescape=False)
        tmpl = jinja_env.from_string(content_snippet)
        rendered = tmpl.render()
    except Exception as e:
        return {"success": False, "error": f"Template render error: {e}"}

    # -- Step 3: Extract <section> blocks from the rendered output
    section_names = {
        "why-us":       "Why Us Section",
        "services":     "Services Section",
        "testimonials": "Testimonials Section",
    }

    pattern = re.compile(
        r'(?:<!--\s*([^>]+?)\s*-->\s*)?(<section[^>]*>.*?</section>)',
        re.DOTALL | re.IGNORECASE
    )

    sections = []
    for match in pattern.finditer(rendered):
        comment_label = match.group(1)
        html_block    = match.group(2)

        name = None
        if comment_label:
            stripped = comment_label.strip()
            # Skip Jinja meta-comments
            if not any(stripped.lower().startswith(k) for k in ("block ", "end", "#")):
                name = stripped
        if not name:
            id_match = re.search(r'id=["\']([^"\']+)["\']', html_block)
            if id_match:
                sid = id_match.group(1)
                name = section_names.get(sid) or sid.replace("-", " ").replace("_", " ").title()
        if not name:
            name = f"Section {len(sections) + 1}"

        sections.append({"name": name, "html": html_block.strip(), "css": ""})

    return {"success": True, "sections": sections}



