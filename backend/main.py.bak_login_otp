@app.get("/api/consultants/{consultant_id}/schedule")
async def get_consultant_schedule(consultant_id: int, request: Request, db: Session = Depends(get_db)):
    """Get consultant schedule with buffer-aware blocked windows and booking rules."""
    BUFFER_MINUTES = 15
    try:
        consultant = db.query(ConsultantProfile).filter(
            ConsultantProfile.id == consultant_id
        ).first()
        if not consultant:
            return {"success": False, "error": "Consultant not found"}

        is_paid = (consultant.consultation_fee or 0) > 0

        schedules = db.query(ConsultantSchedule).filter(
            ConsultantSchedule.consultant_id == consultant_id,
            ConsultantSchedule.is_active     == True,
        ).all()

        schedule_data = [
            {"id": s.id, "day_of_week": s.day_of_week, "start_time": s.start_time, "end_time": s.end_time}
            for s in schedules
        ]

        # Booked slots for next 30 days — include buffer windows so UI can grey correctly
        start_date = datetime.utcnow()
        end_date   = start_date + timedelta(days=30)

        appointments = db.query(Appointment).filter(
            Appointment.consultant_id    == consultant_id,
            Appointment.appointment_date >= start_date,
            Appointment.appointment_date <= end_date,
            Appointment.status           == "scheduled",
        ).all()

        booked_slots = []
        for appt in appointments:
            dur = appt.duration_minutes or 60
            a_start = appt.appointment_date.replace(tzinfo=None) if getattr(appt.appointment_date, "tzinfo", None) else appt.appointment_date
            a_end   = a_start + timedelta(minutes=dur)
            booked_slots.append({
                "date":          a_start.isoformat(),
                "duration":      dur,
                "blocked_start": (a_start - timedelta(minutes=BUFFER_MINUTES)).isoformat(),
                "blocked_end":   (a_end   + timedelta(minutes=BUFFER_MINUTES)).isoformat(),
            })

        # For paid consultants: earliest bookable = now (IST) + 24 hours, rounded up to
        # the current hour. Format as "YYYY-MM-DDTHH:MM" (no TZ suffix) so the frontend
        # can assign it directly to input.min without any Date() timezone conversion.
        # Bypassed if booked by an admin on behalf of a user (impersonating).
        is_impersonating = "impersonate_user_id" in request.session
        min_booking_date = None
        if is_paid and not is_impersonating:
            now_ist      = datetime.utcnow() + timedelta(hours=5, minutes=30)
            min_appt_ist = now_ist + timedelta(hours=24)
            # Round up to the next hour so the picker shows a clean time
            min_booking_date = min_appt_ist.replace(minute=0, second=0, microsecond=0).strftime("%Y-%m-%dT%H:%M")

        return {
            "success":           True,
            "consultant_name":   consultant.user.name,
            "is_paid":           is_paid,
            "consultation_fee":  consultant.consultation_fee or 0,
            "allowed_durations": [30, 60, 90] if is_paid else [15],
            "min_booking_date":  min_booking_date,   # None for free consultants
            "buffer_minutes":    BUFFER_MINUTES,
            "schedule":          schedule_data,
            "booked_slots":      booked_slots,
        }
    except Exception as e:
        print(f"Error getting consultant schedule: {str(e)}")
        return {"success": False, "error": str(e)}


@app.get("/api/consultants/{consultant_id}/day-timeline")
async def consultant_day_timeline(
    consultant_id: int,
    date: str = "",        # YYYY-MM-DD
    duration: int = 30,    # minutes
    db: Session = Depends(get_db)
):
    """
    Returns a 30-minute-resolution timeline for a given consultant and date.
    Each interval has a status: available | booked | buffer | break | overflow | outside
    """
    from models import ConsultantProfile, ConsultantSchedule, ScheduleBreak, Appointment
    from datetime import datetime, timedelta, date as date_type
    import math

    # Parse date
    try:
        target_date = date_type.fromisoformat(date) if date else date_type.today()
    except ValueError:
        return JSONResponse({"error": "Invalid date format. Use YYYY-MM-DD."}, status_code=400)

    day_of_week = target_date.weekday()  # 0=Monday

    # Get consultant profile
    profile = db.query(ConsultantProfile).filter(ConsultantProfile.id == consultant_id).first()
    if not profile:
        return JSONResponse({"error": "Consultant not found"}, status_code=404)

    # Try to seed from onboarding if no schedule exists
    _seed_schedule_from_onboarding(profile, db)

    # Get schedule for this day
    schedule = db.query(ConsultantSchedule).filter(
        ConsultantSchedule.consultant_id == consultant_id,
        ConsultantSchedule.day_of_week   == day_of_week,
        ConsultantSchedule.is_active     == True,
    ).first()

    if not schedule:
        # Check what days ARE available
        all_schedules = db.query(ConsultantSchedule).filter(
            ConsultantSchedule.consultant_id == consultant_id,
            ConsultantSchedule.is_active     == True,
        ).all()
        day_names = ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]
        working_days = sorted(set(s.day_of_week for s in all_schedules))
        return {
            "working": False,
            "working_days": [day_names[d] for d in working_days],
            "message": f"Not available on {day_names[day_of_week]}."
                       + (f" Works on: {', '.join(day_names[d] for d in working_days)}." if working_days else " No schedule set yet."),
        }

    work_start_str = schedule.start_time  # "HH:MM"
    work_end_str   = schedule.end_time

    def hhmm_to_minutes(s):
        h, m = map(int, s.split(":"))
        return h * 60 + m

    def minutes_to_hhmm(m):
        return f"{m//60:02d}:{m%60:02d}"

    work_start_min = hhmm_to_minutes(work_start_str)
    work_end_min   = hhmm_to_minutes(work_end_str)

    # Get breaks for this day
    breaks = db.query(ScheduleBreak).filter(
        ScheduleBreak.consultant_id == consultant_id,
        ScheduleBreak.day_of_week   == day_of_week,
    ).all()
    break_ranges = [(hhmm_to_minutes(b.break_start), hhmm_to_minutes(b.break_end)) for b in breaks]

    # Get existing appointments for this date
    BUFFER = 15
    day_start_dt = datetime(target_date.year, target_date.month, target_date.day, 0, 0, 0)
    day_end_dt   = day_start_dt + timedelta(days=1)
    existing_appts = db.query(Appointment).filter(
        Appointment.consultant_id    == consultant_id,
        Appointment.status.in_(["scheduled", "in_progress"]),
        Appointment.appointment_date >= day_start_dt,
        Appointment.appointment_date <  day_end_dt,
    ).all()

    # Build booked ranges (with buffer) in minutes-since-midnight
    booked_ranges = []
    booked_display = []
    for a in existing_appts:
        # Convert UTC stored appointment date to IST for schedule calculation
        appt_ist = a.appointment_date + timedelta(hours=5, minutes=30)
        a_start = appt_ist.hour * 60 + appt_ist.minute
        a_end   = a_start + (a.duration_minutes or 60)
        buf_start = a_start - BUFFER
        buf_end   = a_end   + BUFFER
        booked_ranges.append((buf_start, buf_end, a_start, a_end))
        booked_display.append({
            "start":        minutes_to_hhmm(a_start),
            "end":          minutes_to_hhmm(a_end),
            "buffer_start": minutes_to_hhmm(max(0, buf_start)),
            "buffer_end":   minutes_to_hhmm(min(23*60+59, buf_end)),
        })

    # Current IST time — used to grey out past slots when date is today
    IST_OFFSET   = timedelta(hours=5, minutes=30)
    now_ist      = datetime.utcnow() + IST_OFFSET
    is_today     = (target_date == now_ist.date())
    now_ist_min  = now_ist.hour * 60 + now_ist.minute  # minutes since midnight IST

    # Build 30-minute grid intervals
    intervals = []
    slot = work_start_min
    while slot < work_end_min:
        slot_end = slot + duration
        time_str = minutes_to_hhmm(slot)

        # Determine status
        if is_today and slot_end <= now_ist_min:
            # Entire slot is in the past — grey it out
            status   = "past"
            can_book = False
        elif slot_end > work_end_min:
            status   = "overflow"   # starts OK but runs past end of day
            can_book = False
        else:
            # Check break overlap
            in_break = any(bs < slot_end and be > slot for bs, be in break_ranges)
            if in_break:
                status   = "break"
                can_book = False
            else:
                # Check booked/buffer overlap
                in_booked = False
                in_buffer = False
                for (buf_s, buf_e, appt_s, appt_e) in booked_ranges:
                    if appt_s < slot_end and appt_e > slot:
                        in_booked = True
                        break
                    elif buf_s < slot_end and buf_e > slot:
                        in_buffer = True
                if in_booked:
                    status   = "booked"
                    can_book = False
                elif in_buffer:
                    status   = "buffer"
                    can_book = False
                else:
                    status   = "available"
                    can_book = True

        intervals.append({"time": time_str, "status": status, "can_book": can_book})
        slot += 30  # always step by 30 regardless of duration

    # Find next available slot (skips past, booked, overflow etc.)
    next_available = None
    for iv in intervals:
        if iv["can_book"]:
            next_available = iv["time"]
            break

    return {
        "working": True,
        "working_hours": {"start": work_start_str, "end": work_end_str},
        "breaks": [{"start": b.break_start, "end": b.break_end} for b in breaks],
        "booked_ranges": booked_display,
        "intervals": intervals,
        "next_available": next_available,
        "date": date,
        "duration": duration,
    }


@app.post("/api/appointments/book")
async def book_appointment(request: Request, db: Session = Depends(get_db)):
    """Book an appointment — enforces 15-min buffers, 24h advance rule, free=15min, race-lock."""
    BUFFER_MINUTES = 15

    try:
        user_id = request.session.get("user_id")
        if not user_id:
            return {"success": False, "error": "User not logged in"}

        data = await request.json()
        if not all(k in data for k in ["consultant_id", "appointment_date"]):
            return {"success": False, "error": "Missing required fields"}

        # -- Parse appointment time -------------------------------------------
        raw_dt = datetime.fromisoformat(data["appointment_date"].replace("Z", "+00:00"))
        appointment_date = raw_dt.replace(tzinfo=None)

        # -- Fetch consultant --------------------------------------------------
        consultant = db.query(ConsultantProfile).filter(
            ConsultantProfile.id == data["consultant_id"]
        ).first()
        if not consultant:
            return {"success": False, "error": "Consultant not found"}

        is_paid = (consultant.consultation_fee or 0) > 0

        # -- Rule 1: Free consultant => 15-min session ONLY -------------------
        if not is_paid:
            duration_minutes = 15
        else:
            duration_minutes = int(data.get("duration_minutes", 60))
            if duration_minutes not in (30, 60, 90):
                duration_minutes = 60

        appt_end = appointment_date + timedelta(minutes=duration_minutes)

        # -- Rule 2: Paid consultants need 24-hour advance booking ------------
        is_impersonating = "impersonate_user_id" in request.session
        if is_paid and not is_impersonating:
            now_ist  = datetime.utcnow() + timedelta(hours=5, minutes=30)
            tomorrow = (now_ist + timedelta(days=1)).replace(
                hour=0, minute=0, second=0, microsecond=0)
            appt_ist = appointment_date + timedelta(hours=5, minutes=30)
            if appt_ist < tomorrow:
                earliest = tomorrow.strftime("%d %b %Y")
                return {
                    "success":       False,
                    "error":         f"Paid consultations must be booked at least 24 hours in advance. Earliest available date: {earliest}.",
                    "conflict_type": "advance_booking_required",
                    "earliest_date": tomorrow.isoformat(),
                }

        # -- Blocked zone for the NEW appointment (with buffers) --------------
        new_blocked_start = appointment_date - timedelta(minutes=BUFFER_MINUTES)
        new_blocked_end   = appt_end          + timedelta(minutes=BUFFER_MINUTES)

        print(f"[BOOKING] user={user_id} consultant={data['consultant_id']} "
              f"date={appointment_date} dur={duration_minutes}min "
              f"blocked={new_blocked_start}-->{new_blocked_end}")

        # -- Rule 3: Consultant overlap (with SELECT FOR UPDATE row-lock) -----
        wide_start = new_blocked_start - timedelta(hours=2)
        wide_end   = new_blocked_end   + timedelta(hours=2)

        try:
            consultant_appts = (
                db.query(Appointment)
                .filter(
                    Appointment.consultant_id    == data["consultant_id"],
                    Appointment.status           == "scheduled",
                    Appointment.appointment_date >= wide_start,
                    Appointment.appointment_date <  wide_end,
                )
                .with_for_update()
                .all()
            )
        except Exception:
            consultant_appts = db.query(Appointment).filter(
                Appointment.consultant_id    == data["consultant_id"],
                Appointment.status           == "scheduled",
                Appointment.appointment_date >= wide_start,
                Appointment.appointment_date <  wide_end,
            ).all()

        conflict_end = None
        for c in consultant_appts:
            c_dur   = c.duration_minutes if c.duration_minutes is not None else 60
            c_start = c.appointment_date.replace(tzinfo=None) if getattr(c.appointment_date, "tzinfo", None) else c.appointment_date
            c_end   = c_start + timedelta(minutes=c_dur)
            c_blocked_start = c_start - timedelta(minutes=BUFFER_MINUTES)
            c_blocked_end   = c_end   + timedelta(minutes=BUFFER_MINUTES)
            overlap = max(c_blocked_start, new_blocked_start) < min(c_blocked_end, new_blocked_end)
            print(f"[BOOKING]   existing id={c.id} blocked={c_blocked_start}-->{c_blocked_end} overlap={overlap}")
            if overlap:
                if conflict_end is None or c_blocked_end > conflict_end:
                    conflict_end = c_blocked_end

        if conflict_end is not None:
            next_slot = _find_next_slot(db, data["consultant_id"], conflict_end, duration_minutes, BUFFER_MINUTES)
            next_msg  = f" Next available: {next_slot['label']}." if next_slot else " Please check the schedule."
            return {
                "success":        False,
                "error":          f"This consultant is unavailable at {appointment_date.strftime('%I:%M %p')} (including 15-min buffer).{next_msg}",
                "conflict_type":  "consultant_busy",
                "next_available": next_slot,
            }

        # -- Rule 4: User double-booking check --------------------------------
        user_appts = db.query(Appointment).filter(
            Appointment.user_id  == user_id,
            Appointment.status   == "scheduled",
            Appointment.appointment_date >= wide_start,
            Appointment.appointment_date <  wide_end,
        ).all()

        for c in user_appts:
            c_dur   = c.duration_minutes if c.duration_minutes is not None else 60
            c_start = c.appointment_date.replace(tzinfo=None) if getattr(c.appointment_date, "tzinfo", None) else c.appointment_date
            c_end   = c_start + timedelta(minutes=c_dur)
            if max(c_start, appointment_date) < min(c_end, appt_end):
                return {
                    "success":       False,
                    "error":         f"You already have an appointment at {c_start.strftime('%I:%M %p')}--{c_end.strftime('%I:%M %p')}. Please cancel it first or choose a different time.",
                    "conflict_type": "user_busy",
                }

        # -- Create appointment -----------------------------------------------
        appointment = Appointment(
            user_id=user_id,
            consultant_id=data["consultant_id"],
            appointment_date=appointment_date,
            duration_minutes=duration_minutes,
            notes=data.get("notes", ""),
        )
        db.add(appointment)
        db.commit()
        db.refresh(appointment)

        # -- Confirmation emails (non-fatal) ----------------------------------
        try:
            user_obj  = db.query(User).filter(User.id == user_id).first()
            user_email       = user_obj.email        if user_obj else ""
            user_name        = user_obj.name         if user_obj else "User"
            consultant_email = consultant.user.email if consultant.user else ""
            consultant_name  = consultant.user.name  if consultant.user else "Consultant"
            shared_kwargs = dict(
                action="booked", appointment_id=appointment.id,
                user_name=user_name, consultant_name=consultant_name,
                appointment_date=appointment_date, duration_minutes=duration_minutes,
                notes=data.get("notes", ""),
                organiser_email=user_email, organiser_name=user_name,
                attendee_emails=[e for e in [user_email, consultant_email] if e],
            )
            if user_email:
                send_appointment_email(to_email=user_email, to_name=user_name, **shared_kwargs)
            if consultant_email:
                send_appointment_email(to_email=consultant_email, to_name=consultant_name, **shared_kwargs)
        except Exception as mail_err:
            print(f"[Appointment email] non-fatal error: {mail_err}")

        return {
            "success": True,
            "appointment": {
                "id":               appointment.id,
                "consultant_name":  consultant.user.name,
                "appointment_date": appointment.appointment_date.isoformat() + "Z",
                "duration_minutes": appointment.duration_minutes,
                "status":           appointment.status,
            },
        }
    except Exception as e:
        print(f"Error booking appointment: {str(e)}")
        db.rollback()
        return {"success": False, "error": str(e)}


def _find_next_slot(db, consultant_id: int, search_from, duration_minutes: int, buffer: int):
    """Find earliest free slot after search_from, respecting buffers."""
    import datetime as _dt
    from models import ConsultantSchedule as CS
    schedules = db.query(CS).filter(CS.consultant_id == consultant_id, CS.is_active == True).all()
    if not schedules:
        return None

    for day_offset in range(14):
        candidate_day = search_from.date() + timedelta(days=day_offset)
        dow_name = candidate_day.strftime("%A")
        for sched in schedules:
            if sched.day_of_week.strip().title() != dow_name:
                continue
            try:
                sh, sm = map(int, sched.start_time.split(":"))
                eh, em = map(int, sched.end_time.split(":"))
            except Exception:
                continue
            sched_start = _dt.datetime.combine(candidate_day, _dt.time(sh, sm))
            sched_end   = _dt.datetime.combine(candidate_day, _dt.time(eh, em))
            tick = max(sched_start, search_from.replace(second=0, microsecond=0))
            rem = tick.minute % 15
            if rem:
                tick += timedelta(minutes=(15 - rem))
                tick = tick.replace(second=0, microsecond=0)
            while tick + timedelta(minutes=duration_minutes) <= sched_end:
                cand_end  = tick + timedelta(minutes=duration_minutes)
                cb_start  = tick     - timedelta(minutes=buffer)
                cb_end    = cand_end + timedelta(minutes=buffer)
                day_appts = db.query(Appointment).filter(
                    Appointment.consultant_id    == consultant_id,
                    Appointment.status           == "scheduled",
                    Appointment.appointment_date >= cb_start - timedelta(hours=1),
                    Appointment.appointment_date <  cb_end   + timedelta(hours=1),
                ).all()
                free = True
                for appt in day_appts:
                    a_start = appt.appointment_date.replace(tzinfo=None) if getattr(appt.appointment_date, "tzinfo", None) else appt.appointment_date
                    a_end   = a_start + timedelta(minutes=(appt.duration_minutes or 60))
                    if max(a_start - timedelta(minutes=buffer), cb_start) < min(a_end + timedelta(minutes=buffer), cb_end):
                        free = False
                        break
                if free and tick >= _dt.datetime.utcnow() + timedelta(minutes=5):
                    return {"date": tick.isoformat(), "label": tick.strftime("%a, %d %b at %I:%M %p")}
                tick += timedelta(minutes=15)
    return None


@app.get("/api/appointments/user")
async def get_user_appointments(request: Request, db: Session = Depends(get_db)):
    """Get all appointments for the logged-in user, auto-completing elapsed ones."""
    try:
        user_id = request.session.get("user_id")
        if not user_id:
            return {"success": False, "error": "User not logged in", "appointments": []}
        
        appointments = db.query(Appointment).filter(
            Appointment.user_id == user_id
        ).order_by(Appointment.appointment_date.desc()).all()

        now = datetime.utcnow()
        changed = False
        appointment_list = []
        for appt in appointments:
            # Auto-expire: slot fully over AND call never started (status still 'scheduled')
            appt_end = appt.appointment_date + timedelta(minutes=appt.duration_minutes)
            if appt.status == "scheduled" and appt_end < now:
                appt.status = "expired"
                changed = True

            # Reset future 'in_progress' to 'scheduled' if it's in the future
            if appt.status == "in_progress" and appt.appointment_date > now + timedelta(minutes=15):
                appt.status = "scheduled"
                changed = True

            appointment_list.append({
                "id":                       appt.id,
                "consultant_id":            appt.consultant_id,
                "consultant_name":          appt.consultant.user.name,
                "consultant_specialization": appt.consultant.specialization,
                "appointment_date":         appt.appointment_date.isoformat() + "Z",
                "duration_minutes":         appt.duration_minutes,
                "status":                   appt.status,
                "notes":                    appt.notes,
                "reschedule_free":          appt.reschedule_free,
                "refund_status":            appt.refund_status,
            })

        if changed:
            db.commit()
        
        return {"success": True, "appointments": appointment_list}
    except Exception as e:
        print(f"Error getting user appointments: {str(e)}")
        return {"success": False, "error": str(e), "appointments": []}


