@app.post("/api/consultant/schedule")
async def save_consultant_schedule(request: Request, db: Session = Depends(get_db)):
    """Replace all schedule slots and breaks for the logged-in consultant."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)

    try:
        data = await request.json()
        slots  = data.get("schedules", [])  # [{day_of_week, start_time, end_time}, ...]
        breaks = data.get("breaks",    [])  # [{day_of_week, break_start, break_end}, ...]

        # Verify consultant profile exists
        profile = db.query(ConsultantProfile).filter(
            ConsultantProfile.user_id == user_id
        ).first()
        if not profile:
            return JSONResponse({"success": False, "error": "Consultant profile not found"}, status_code=404)

        # Delete existing schedule rows and breaks for this consultant
        db.query(ConsultantSchedule).filter(
            ConsultantSchedule.consultant_id == profile.id
        ).delete()
        db.query(ScheduleBreak).filter(
            ScheduleBreak.consultant_id == profile.id
        ).delete()

        day_names = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']

        # Insert new slots
        for slot in slots:
            day   = int(slot.get("day_of_week", 0))
            start = str(slot.get("start_time", "")).strip()
            end   = str(slot.get("end_time",   "")).strip()
            if not start or not end:
                db.rollback()
                return JSONResponse({"success": False, "error": f"Please set start and end times for {day_names[day]}"}, status_code=400)
            if start >= end:
                db.rollback()
                return JSONResponse({"success": False, "error": f"Start time must be before end time for {day_names[day]}"}, status_code=400)
            db.add(ConsultantSchedule(
                consultant_id = profile.id,
                day_of_week   = day,
                start_time    = start,
                end_time      = end,
                is_active     = True,
            ))

        # Insert new break periods
        for brk in breaks:
            day   = int(brk.get("day_of_week", 0))
            bk_s  = str(brk.get("break_start", "")).strip()
            bk_e  = str(brk.get("break_end",   "")).strip()
            if not bk_s or not bk_e:
                continue  # skip incomplete break entries silently
            if bk_s >= bk_e:
                db.rollback()
                return JSONResponse({"success": False, "error": f"Break start must be before break end for {day_names[day]}"}, status_code=400)
            db.add(ScheduleBreak(
                consultant_id = profile.id,
                day_of_week   = day,
                break_start   = bk_s,
                break_end     = bk_e,
            ))

        db.commit()
        print(f"[SCHEDULE] Saved {len(slots)} slots + {len(breaks)} breaks for consultant {profile.id}")
        return JSONResponse({"success": True, "saved": len(slots), "breaks": len(breaks)})

    except Exception as e:
        db.rollback()
        import traceback
        print(f"[SCHEDULE] Error: {traceback.format_exc()}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


