@app.delete("/api/admin/users/{user_id}")
async def delete_user_route(user_id: int, request: Request, db: Session = Depends(get_db)):
    """Delete a user or consultant"""
    admin_id = request.session.get("user_id")
    admin = db.query(User).filter(User.id == admin_id).first()
    if not admin or admin.user_type != "admin":
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=403)
    
    # Prevent deleting yourself
    if user_id == admin_id:
        return JSONResponse({"success": False, "error": "Cannot delete your own account"}, status_code=400)
    
    # Get the user
    user = db.query(User).filter(User.id == user_id).first()
    if not user:
        return JSONResponse({"success": False, "error": "User not found"}, status_code=404)
    
    try:
        from sqlalchemy import text
        
        # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        # PRE-FETCH ALL IDs then DELETE in order â€” avoids pg8000 issues with
        # repeated named params in complex nested subqueries
        # â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

        # Get consultant profile ID for this user (if consultant)
        cp_row = db.execute(
            text("SELECT id FROM consultant_profiles WHERE user_id = :uid"),
            {"uid": user_id}
        ).fetchone()
        cp_id = cp_row[0] if cp_row else None

        # Get ALL appointment IDs (as user OR as consultant)
        appt_sql = "SELECT id FROM appointments WHERE user_id = :uid"
        appt_rows = db.execute(text(appt_sql), {"uid": user_id}).fetchall()
        if cp_id:
            cp_appt_rows = db.execute(
                text("SELECT id FROM appointments WHERE consultant_id = :cpid"),
                {"cpid": cp_id}
            ).fetchall()
            appt_rows = appt_rows + cp_appt_rows
        appt_ids = list({r[0] for r in appt_rows})  # deduplicate
        aids = ",".join(str(i) for i in appt_ids) if appt_ids else "NULL"

        # Get ALL call_session IDs for this user
        cs_rows = db.execute(
            text("SELECT id FROM call_sessions WHERE user_id = :uid OR consultant_id = :uid"),
            {"uid": user_id}
        ).fetchall()
        if appt_ids:
            cs_appt_rows = db.execute(
                text(f"SELECT id FROM call_sessions WHERE appointment_id IN ({aids})")
            ).fetchall()
            cs_rows = cs_rows + cs_appt_rows
        cs_ids = list({r[0] for r in cs_rows})  # deduplicate
        csids = ",".join(str(i) for i in cs_ids) if cs_ids else "NULL"

        # Get ALL prescription IDs
        pr_rows = db.execute(
            text("SELECT id FROM prescriptions WHERE user_id = :uid OR consultant_id = :uid"),
            {"uid": user_id}
        ).fetchall()
        if appt_ids:
            pr_appt_rows = db.execute(
                text(f"SELECT id FROM prescriptions WHERE appointment_id IN ({aids})")
            ).fetchall()
            pr_rows = pr_rows + pr_appt_rows
        pr_ids = list({r[0] for r in pr_rows})
        prids = ",".join(str(i) for i in pr_ids) if pr_ids else "NULL"

        # â”€â”€ Step 1: prescription_items (child of prescriptions) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if pr_ids:
            db.execute(text(f"DELETE FROM prescription_items WHERE prescription_id IN ({prids})"))

        # â”€â”€ Step 2: call_transcriptions (child of call_sessions) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if cs_ids:
            db.execute(text(f"DELETE FROM call_transcriptions WHERE call_session_id IN ({csids})"))

        # â”€â”€ Step 3: consultant_ratings (FK â†’ appointments) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        db.execute(
            text("DELETE FROM consultant_ratings WHERE user_id = :uid"),
            {"uid": user_id}
        )
        if cp_id:
            db.execute(
                text("DELETE FROM consultant_ratings WHERE consultant_id = :cpid"),
                {"cpid": cp_id}
            )
        if appt_ids:
            db.execute(text(f"DELETE FROM consultant_ratings WHERE appointment_id IN ({aids})"))

        # â”€â”€ Step 4: call_sessions (FK â†’ appointments) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if cs_ids:
            db.execute(text(f"DELETE FROM call_sessions WHERE id IN ({csids})"))

        # â”€â”€ Step 5: prescriptions (FK â†’ appointments) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if pr_ids:
            db.execute(text(f"DELETE FROM prescriptions WHERE id IN ({prids})"))

        # â”€â”€ Step 6: consultant_schedule_breaks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if cp_id:
            db.execute(
                text("DELETE FROM consultant_schedule_breaks WHERE consultant_id = :cpid"),
                {"cpid": cp_id}
            )

        # â”€â”€ Step 7: consultant_schedules â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if cp_id:
            db.execute(
                text("DELETE FROM consultant_schedules WHERE consultant_id = :cpid"),
                {"cpid": cp_id}
            )

        # â”€â”€ Step 8: appointments (all FK children removed above) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        if appt_ids:
            db.execute(text(f"DELETE FROM appointments WHERE id IN ({aids})"))


        # PASS 3: Flat logs and profile records
        db.execute(text("DELETE FROM audit_logs WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM daily_wellness_scores WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM workout_logs WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM vitals_records WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM mood_entries WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM journal_entries WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM ai_chat_history WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM user_exercise_logs WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM messages WHERE sender_id = :uid OR receiver_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM password_reset_tokens WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM patient_notes WHERE patient_id = :uid OR consultant_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM consultant_interactions WHERE user_id = :uid OR consultant_id = :uid"), {"uid": user_id})
        
        # Clear admin links in sections
        db.execute(text("UPDATE homepage_sections SET created_by = NULL WHERE created_by = :uid"), {"uid": user_id})

        # PASS 4: The Profile containers
        db.execute(text("DELETE FROM consultant_profiles WHERE user_id = :uid"), {"uid": user_id})
        db.execute(text("DELETE FROM user_profiles WHERE user_id = :uid"), {"uid": user_id})

        # PASS 5: The User identity (Last one!)
        db.execute(text("DELETE FROM users WHERE id = :uid"), {"uid": user_id})
        
        db.commit()

        
        # Audit Log
        AuditLogger.log_event(
            db, 
            event_type="admin_delete_user", 
            user_id=admin_id,
            resource_type="user",
            resource_id=str(user_id),
            details="User deleted by admin",
            request=request
        )
        
        return JSONResponse({"success": True, "message": "User deleted successfully"})
    except Exception as e:
        db.rollback()
        import traceback
        error_detail = traceback.format_exc()
        print(f"Error deleting user {user_id}: {error_detail}")
        return JSONResponse({"success": False, "error": f"Error deleting user: {str(e)}"}, status_code=500)

