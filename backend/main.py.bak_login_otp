# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
@app.post("/api/auth/email-otp/verify")
async def verify_email_otp_route(request: Request, db: Session = Depends(get_db)):
    """Verify the OTP that was sent to the signup email address."""
    try:
        data = await request.json()
        email    = (data.get("email") or "").strip().lower()
        otp_code = (data.get("otp")   or "").strip()

        if not email or not otp_code:
            return {"success": False, "error": "Email and OTP are required"}

        record = db.query(OTPVerification).filter(
            OTPVerification.otp_email == email,
            OTPVerification.otp_code  == otp_code,
            OTPVerification.expires_at > datetime.utcnow(),
        ).first()

        if not record:
            return {"success": False, "error": "Invalid or expired OTP. Please request a new one."}

        # Mark verified in session so the signup POST can trust it
        request.session["email_otp_verified"] = email

        # Clean up the used OTP
        db.delete(record)
        db.commit()

        return {"success": True}

    except Exception as exc:
        import traceback; traceback.print_exc()
        return {"success": False, "error": "Server error. Please try again."}

@app.post("/api/auth/otp/send")
@limiter.limit("5/minute")
async def send_otp(request: Request, db: Session = Depends(get_db)):
    """Send OTP to phone number and/or email if account doesn't exist - HIPAA Compliant"""
    try:
        data = await request.json()
        phone = data.get("phone_number")
        email = data.get("email")  # NEW: Accept email parameter
        
        # Validate phone number format
        if not phone or len(phone) < 10:
             return {"success": False, "error": "Invalid phone number"}
             
        # HIPAA: Audit log for OTP request
        AuditLogger.log_event(
            db, 
            event_type="otp_requested", 

            details=f"OTP requested for phone number ending in {phone[-4:]}",
            request=request
        )
             
        # Check if user exists
        existing_user = db.query(User).filter(User.phone_number == phone).first()
        if existing_user:
            # HIPAA: Audit failed attempt
            AuditLogger.log_event(
                db, 
                event_type="otp_denied_existing_user", 
                details=f"OTP denied - account exists for phone ending in {phone[-4:]}", 
                status="failure",
                request=request
            )
        # Generate cryptographically secure 6-digit OTP
        import secrets as _sec
        otp = "".join(str(_sec.randbelow(10)) for _ in range(6))

        # Invalidate any old OTP for this phone or email, then store new one
        db.query(OTPVerification).filter(
            (OTPVerification.phone_number == phone) | 
            ((OTPVerification.otp_email == email) if email else False)
        ).delete()
        
        db.add(OTPVerification(
            phone_number=phone,
            otp_email=email,
            otp_code=otp,
            expires_at=datetime.utcnow() + timedelta(minutes=10),
        ))
        db.commit()

        AuditLogger.log_event(
            db, 
            event_type="otp_generated", 
            details=f"OTP generated for phone ending in {phone[-4:]}, expires in 10 minutes",
            request=request
        )
        
        # Send OTP via email and/or SMS
        otp_service = FallbackOTP()
        send_result = otp_service.send_otp(phone, otp, email=email)  # Pass email parameter
        
        # Check if OTP was sent successfully
        if send_result.get("success"):
            providers = send_result.get('providers', [send_result.get('provider', 'Unknown')])
            print(f"[OTP] âœ… OTP sent via {', '.join(providers) if isinstance(providers, list) else providers}")
        else:
            print(f"[OTP] âš ï¸ Failed to send OTP: {send_result.get('message')}")
            # Still print to console as backup
            import sys
            print(f"\n{'='*60}", flush=True, file=sys.stderr)
            print(f"ðŸ” OTP for {phone}: {otp}", flush=True, file=sys.stderr)
            if email:
                print(f"   Email: {email}", flush=True, file=sys.stderr)
            print(f"   Expires: {(datetime.utcnow() + timedelta(minutes=10)).strftime('%H:%M:%S')}", flush=True, file=sys.stderr)
            print(f"{'='*60}\n", flush=True, file=sys.stderr)
        
        # In production, remove otp_debug to comply with HIPAA
        # Never expose sensitive data in API responses
        is_development = os.getenv("ENVIRONMENT", "development") == "development"
        response_data = {"success": True}
        
        if is_development:
            response_data["otp_debug"] = otp  # Only for dev/testing
            response_data["note"] = "OTP visible only in development mode"
        
        # Add info about delivery methods
        if send_result.get("email_sent"):
            response_data["email_sent"] = True
        if send_result.get("sms_sent"):
            response_data["sms_sent"] = True
        
        return response_data
        
    except Exception as e:
        # HIPAA: Audit log error
        AuditLogger.log_event(
            db, 
            event_type="otp_error", 
            details=f"Error during OTP generation: {str(e)}", 
            status="failure",
            request=request
        )
        print(f"Error sending OTP: {e}", flush=True, file=sys.stderr)
        import traceback
        traceback.print_exc()
        return {"success": False, "error": "Internal server error"}

@app.post("/signup")
async def signup_post(request: Request, db: Session = Depends(get_db)):
    """Handle signup form submission â€” requires email OTP verification + optional reCAPTCHA"""

    def _err(msg: str):
        return templates.TemplateResponse(
            "pages/auth/signup_simple.html",
            {"request": request, "page_title": "Sign Up - SolaceSquad",
             "recaptcha_site_key": os.getenv("RECAPTCHA_SITE_KEY", ""),
             "error": msg}
        )

    try:
        form_data = await request.form()
        user_name    = form_data.get("name",         "").strip()
        user_email   = form_data.get("email",        "").strip().lower()
        user_password= form_data.get("password",     "")
        phone_number = form_data.get("phone_number", "").strip()
        user_type    = form_data.get("user_type",    "user")
        captcha_token= form_data.get("g-recaptcha-response", "")

        if not user_name or not user_email or not user_password or not phone_number:
            return _err("Name, email, password, and phone number are required")

        # â”€â”€ 1. reCAPTCHA validation (skipped gracefully if key not configured) â”€
        recaptcha_secret = os.getenv("RECAPTCHA_SECRET_KEY", "")
        if recaptcha_secret:
            if not captcha_token:
                return _err("Please complete the CAPTCHA verification")
            import urllib.request as _ur, json as _j
            try:
                _payload = f"secret={recaptcha_secret}&response={captcha_token}".encode()
                _req = _ur.Request("https://www.google.com/recaptcha/api/siteverify",
                                   data=_payload, method="POST")
                with _ur.urlopen(_req, timeout=10) as _r:
                    _result = _j.loads(_r.read())
                if not _result.get("success"):
                    return _err("CAPTCHA verification failed. Please try again.")
            except Exception as _ce:
                print(f"[reCAPTCHA] verify error: {_ce}")  # non-fatal; allow through

        # â”€â”€ 2. Email OTP session check â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        bypass_otp = os.getenv("BYPASS_OTP_VERIFICATION", "false").lower() == "true"
        verified_email = request.session.get("email_otp_verified", "")

        if not bypass_otp:
            if verified_email != user_email:
                return _err("Email address not verified. Please complete the OTP step above.")

        # â”€â”€ 3. Uniqueness checks â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        existing_email_user = db.query(User).filter(User.email == user_email).first()
        if existing_email_user:
            if existing_email_user.user_type != user_type:
                label = "Wellbeing Consultant" if existing_email_user.user_type == "consultant" else "User"
                return _err(
                    f"This email is already registered as a {label}. "
                    f"Please sign in to your {label} account instead."
                )
            # â”€â”€ Allow re-signup for deactivated/rejected accounts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            # If the existing account with the same email+role is inactive (rejected),
            # silently delete the stale record so the person can start fresh.
            if not existing_email_user.is_active:
                print(f"[SIGNUP] Recycling rejected inactive account for {user_email}")
                db.delete(existing_email_user)
                db.commit()
            else:
                return _err("Email is already registered. Please log in.")
        # Phone uniqueness: block if phone belongs to a fully-active account.
        # Exception: recycle consultant accounts that never completed onboarding
        # (is_active=True but no ConsultantProfile) caused by earlier signup errors.
        existing_phone = db.query(User).filter(User.phone_number == phone_number).first()
        if existing_phone:
            _is_stuck_consultant = (
                existing_phone.user_type == "consultant"
                and db.query(ConsultantProfile).filter(
                    ConsultantProfile.user_id == existing_phone.id
                ).first() is None
            )
            if _is_stuck_consultant:
                # Consultant who never finished onboarding -- recycle regardless of email
                print(f"[SIGNUP] Recycling stuck consultant (no profile) id={existing_phone.id}")
                db.delete(existing_phone)
                db.commit()
            elif not existing_phone.is_active:
                # Inactive/rejected account - silently recycle
                db.delete(existing_phone)
                db.commit()
            else:
                return _err("Phone number is already registered.")

        # ── Purge orphaned user_profiles left by a previous failed signup ─────────
        # Rows with user_id=NULL crash with NotNullViolation when SQLAlchemy picks them up.
        try:
            from sqlalchemy import text as _text
            _d = db.execute(
                _text("DELETE FROM user_profiles WHERE user_id IS NULL AND contact_email = :em"),
                {"em": user_email}
            ).rowcount
            if _d:
                print(f"[SIGNUP] Cleared {_d} orphaned user_profiles row(s) for {user_email}")
            db.commit()
        except Exception as _oe:
            db.rollback()
            print(f"[SIGNUP] Orphan cleanup (non-fatal): {_oe}")

        # â”€â”€ 4. Create User â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        new_user = User(
            email=user_email,
            name=user_name,
            user_type=user_type,
            phone_number=phone_number,
            is_active=True,
            email_verified=True,          # OTP verified above
        )
        new_user.set_password(user_password)
        db.add(new_user)
        db.commit()
        db.refresh(new_user)

        # Clear OTP session flag
        request.session.pop("email_otp_verified", None)

        AuditLogger.log_event(db, event_type="user_signup", user_id=new_user.id,
                              details=f"New user registered. Email OTP verified.", request=request)

        # Send welcome email to regular users
        if user_type != "consultant":
            try: send_welcome_email(user_email, user_name)
            except Exception: pass

        # Store session
        request.session["user_id"]    = new_user.id
        request.session["user_name"]  = new_user.name
        request.session["user_email"] = new_user.email
        request.session["user_type"]  = new_user.user_type

        # â”€â”€ 5. Consultant â€” create pending profile, redirect to questionnaire â”€â”€
        if user_type == "consultant":
            consultant_profile = ConsultantProfile(
                user_id=new_user.id,
                is_approved=False,
                is_available=False,
            )
            db.add(consultant_profile)
            db.commit()
            print(f"[SIGNUP] Consultant profile created for user {new_user.id} â€” pending onboarding")
            return RedirectResponse(url="/consultant/onboarding", status_code=303)
        else:
            return RedirectResponse(url="/app", status_code=303)

    except Exception as e:
        import traceback; traceback.print_exc()
        db.rollback()
        return _err(f"An error occurred: {str(e)}")



