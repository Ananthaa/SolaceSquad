from jinja2 import pass_context
import timezone_utils
@pass_context
def _format_local_filter(context, utc_dt, format_str="%d %b %Y, %H:%M", tz_name=None):
    if not utc_dt:
        return "—"
    request = context.get("request")
    if not tz_name and request:
        tz_name = request.session.get("timezone")
    if not tz_name:
        tz_name = "Asia/Kolkata"
    return timezone_utils.format_dt_local(utc_dt, format_str, tz_name)
