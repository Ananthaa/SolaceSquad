    user_id = request.session.get("user_id")
    if not user_id:
        return {"success": False, "error": "Unauthorized"}
    try:
        data = await request.json()
        log_date_str = data.get("log_date") or date.today().isoformat()
        log_date_val = date.fromisoformat(log_date_str)
        new_duration = int(data.get("duration_min", 0))

        # Sum existing workout minutes for this user on the same day
        existing_mins = (
            db.query(func.coalesce(func.sum(WorkoutLog.duration_min), 0))
            .filter(
                WorkoutLog.user_id == user_id,
                WorkoutLog.log_date == log_date_val
            )
            .scalar() or 0
