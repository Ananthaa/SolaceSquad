@app.get("/api/consultant/patient/{patient_id}/recordings")
async def get_patient_recordings(
    patient_id: int,
    request: Request,
    db: Session = Depends(get_db)
):
    """Get all recordings for a specific patient (consultant view)"""
    try:
        user_id = request.session.get("user_id")
        if not user_id:
            raise HTTPException(status_code=401, detail="Not authenticated")
        
        # Verify user is a consultant
        consultant_profile = db.query(ConsultantProfile).filter(
            ConsultantProfile.user_id == user_id
        ).first()
        
        if not consultant_profile:
            return {"success": False, "error": "Unauthorized"}
            
        has_consent = check_consultant_patient_consent(db, user_id, patient_id)
        
        # Query call sessions with a valid recording URL
        query = db.query(CallSession).filter(
            CallSession.user_id == patient_id,
            CallSession.recording_url.isnot(None)
        )

        if not has_consent:
            # If patient hasn't given general consent, restrict to sessions where this consultant was a participant
            query = query.filter(CallSession.consultant_id.in_([user_id, consultant_profile.id]))

        call_sessions = query.order_by(CallSession.actual_start.desc()).all()
        
        # If no sessions found and no consent, inform frontend of consent requirement
        if not call_sessions and not has_consent:
            return {"success": False, "error": "ConsentNotGivenOrExpired"}
        
        recordings = []
        for session in call_sessions:
            s_date = session.actual_start or session.scheduled_start
            rec_url = (session.recording_url or "").lower()
            has_vid = bool(session.has_video) or any(ext in rec_url for ext in ['.mp4', '.webm', 'video'])
            recordings.append({
                "id": session.id,
                "call_session_id": session.id,
                "call_date": s_date.isoformat() if s_date else None,
                "duration_seconds": session.duration_seconds or 0,
                "has_video": has_vid
            })
        
        return {"success": True, "recordings": recordings}
    except Exception as e:
        print(f"Error getting patient recordings: {e}")
        return {"success": False, "error": str(e)}


