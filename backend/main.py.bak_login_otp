@app.post("/api/appointments/{appointment_id}/exit-call")
async def exit_call(appointment_id: int, request: Request, db: Session = Depends(get_db)):
    """Handle early-exit reason logic from the call room."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Not authenticated"}, status_code=401)

    try:
        data = await request.json()
        reason_key = int(data.get("reason_key", 0))
    except Exception:
        return JSONResponse({"success": False, "error": "Invalid payload"}, status_code=400)

    try:
        appt = db.query(Appointment).filter(Appointment.id == appointment_id).first()
        if not appt:
            return JSONResponse({"success": False, "error": "Appointment not found"}, status_code=404)

        # Auth check
        consultant_profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == user_id).first()
        is_patient = appt.user_id == user_id
        is_consultant = consultant_profile and appt.consultant_id == consultant_profile.id
        if not (is_patient or is_consultant):
            return JSONResponse({"success": False, "error": "Not authorized"}, status_code=403)

        call_session = db.query(CallSession).filter(CallSession.appointment_id == appointment_id).first()

        action = "no-op"
        if reason_key == 1:
            # "Call got over earlier"
            # Marked complete only if both have joined
            if call_session and call_session.actual_start is not None:
                appt.status = "completed"
                call_session.status = "completed"
                call_session.actual_end = datetime.utcnow()
                delta = call_session.actual_end - call_session.actual_start
                call_session.duration_seconds = int(delta.total_seconds())

                # Increment consultant calls counter
                if consultant_profile:
                    if consultant_profile.calls_completed is None:
                        consultant_profile.calls_completed = 0
                    consultant_profile.calls_completed += 1

                action = "completed"
            else:
                action = "exit"

        elif reason_key == 3:
            # Partner didn't join
            if is_patient:
                # "Consultant didn't join" -> reschedule for free
                appt.status = "reschedule_pending"
                appt.reschedule_free = True
                if call_session:
                    call_session.status = "cancelled"
                action = "reschedule_pending"
            elif is_consultant:
                # "User didn't join" -> completed with no refund
                appt.status = "completed"
                if call_session:
                    call_session.status = "completed"
                    call_session.actual_end = datetime.utcnow()
                    if call_session.actual_start:
                        delta = call_session.actual_end - call_session.actual_start
                        call_session.duration_seconds = int(delta.total_seconds())
                if consultant_profile:
                    if consultant_profile.calls_completed is None:
                        consultant_profile.calls_completed = 0
                    consultant_profile.calls_completed += 1
                action = "completed"

        elif reason_key == 5:
            # "I joined early by mistake"
            # If status is in_progress, and both haven't joined yet, revert to scheduled
            if appt.status == "in_progress" and (not call_session or call_session.actual_start is None):
                appt.status = "scheduled"
                if call_session:
                    call_session.status = "pending"
            action = "reverted_to_scheduled"

        else:
            action = "exit"

        db.commit()
        return JSONResponse({"success": True, "action": action, "status": appt.status})

    except Exception as e:
        db.rollback()
        print(f"[ERROR] exit_call: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


