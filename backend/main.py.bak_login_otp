            text("UPDATE call_sessions SET consultant_id = NULL WHERE consultant_id = :uid"),
            {"uid": user_id}
        )

        # Anonymize prescriptions issued by this consultant
        db.execute(
            text("UPDATE prescriptions SET consultant_id = NULL WHERE consultant_id = :uid"),
            {"uid": user_id}
        )

        # â”€â”€ 2. Delete consultant-only data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # Ratings (linked to the consultant profile, not user data)
