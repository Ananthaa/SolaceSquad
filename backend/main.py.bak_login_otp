@app.post("/assistant/login")
async def assistant_login_post(request: Request, db: Session = Depends(get_db)):
    """Handle admin_assistant login via username + password."""
    form = await request.form()
    username = (form.get("username") or "").strip().lower()
    password = (form.get("password") or "")

    def _fail(msg):
        return templates.TemplateResponse(
            "pages/auth/assistant_login.html",
            {"request": request, "page_title": "Assistant Login - SolaceSquad", "error": msg}
        )

    if not username or not password:
        return _fail("Please enter both username and password")

    # Build the internal email from the username
    internal_email = f"{username}@assistant.internal"

    # 1st: look up by internal email (new-style accounts)
    user = db.query(User).filter(
        User.email == internal_email,
        User.user_type == "admin_assistant"
    ).first()

    # 2nd fallback: look up by real email (old-style accounts created before username system)
    if not user:
        user = db.query(User).filter(
            User.email == username,
            User.user_type == "admin_assistant"
        ).first()

    # 3rd fallback: look up by name (case-insensitive) — handles old accounts where
    # admin typed their name as the "username" to log in
    if not user:
        all_assistants = db.query(User).filter(User.user_type == "admin_assistant").all()
        for a in all_assistants:
            if a.name.lower().replace(" ", "_") == username or a.name.lower() == username.replace("_", " "):
                user = a
                break

    if not user:
        return _fail("Username not found. Please check with your admin.")

    if not user.verify_password(password):
        return _fail("Incorrect password")

    if not user.is_active:
        return _fail("Your account has been deactivated. Please contact the Admin.")

    # Update login timestamps
    if not user.first_login:
        user.first_login = datetime.utcnow()
    user.update_last_login()
    db.commit()

    # Set session
    request.session["user_id"]    = user.id
    request.session["user_name"]  = user.name
    request.session["user_email"] = user.email
    request.session["user_type"]  = user.user_type

    return RedirectResponse(url="/assistant", status_code=303)


