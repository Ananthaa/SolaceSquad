@app.get("/api/wellness/summary")
async def get_wellness_summary(request: Request, db: Session = Depends(get_db)):
    """
    Returns overall_wellness_score for 4 periods with comparison to prior period.
    Periods: Latest (today vs yesterday), This Week vs Last Week,
             This Month vs Last Month, This Year vs Last Year.
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return {"success": False, "error": "Unauthorized"}

    try:
        from datetime import date, timedelta
        today = date.today()

        # â”€â”€ Helper: avg score over a date range â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        def avg_score(start: date, end: date):
            rows = (db.query(DailyWellnessScore)
                    .filter(DailyWellnessScore.user_id == user_id,
                            DailyWellnessScore.score_date >= start,
                            DailyWellnessScore.score_date <= end,
                            DailyWellnessScore.overall_wellness_score.isnot(None))
                    .all())
            if not rows:
                return None
            return round(sum(r.overall_wellness_score for r in rows) / len(rows), 1)

        def trend(curr, prev):
            if curr is None:
                return "N/A"
            if prev is None:
                return "New"
            if curr > prev:
                return "Improving"
            if curr == prev:
                return "Stable"
            return "Decreasing"

        # â”€â”€ Period definitions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        yesterday   = today - timedelta(days=1)

        week_start  = today - timedelta(days=today.weekday())          # Monday
        prev_week_start = week_start - timedelta(weeks=1)
        prev_week_end   = week_start - timedelta(days=1)

        month_start = today.replace(day=1)
        prev_month_end   = month_start - timedelta(days=1)
        prev_month_start = prev_month_end.replace(day=1)

        year_start  = today.replace(month=1, day=1)
        prev_year_start = year_start.replace(year=today.year - 1)
        prev_year_end   = year_start - timedelta(days=1)

        # â”€â”€ Compute â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # "Latest" = most recent available row (not strictly today)
        latest_row = (
            db.query(DailyWellnessScore)
            .filter(DailyWellnessScore.user_id == user_id,
                    DailyWellnessScore.overall_wellness_score.isnot(None))
            .order_by(DailyWellnessScore.score_date.desc())
            .first()
        )
        latest_curr = round(float(latest_row.overall_wellness_score), 1) if latest_row else None

        # Prior to that latest row: the row just before its date
        if latest_row:
            prev_row = (
                db.query(DailyWellnessScore)
                .filter(DailyWellnessScore.user_id == user_id,
                        DailyWellnessScore.score_date < latest_row.score_date,
                        DailyWellnessScore.overall_wellness_score.isnot(None))
                .order_by(DailyWellnessScore.score_date.desc())
                .first()
            )
            latest_prev = round(float(prev_row.overall_wellness_score), 1) if prev_row else None
        else:
            latest_prev = None

        week_curr = avg_score(week_start, today)
        week_prev = avg_score(prev_week_start, prev_week_end)

        month_curr = avg_score(month_start, today)
        month_prev = avg_score(prev_month_start, prev_month_end)

        year_curr = avg_score(year_start, today)
        year_prev = avg_score(prev_year_start, prev_year_end)

        # ── Plan-based ThryvQ access gating ──────────────────────────────────
        # Bitmask stored in PlanFeatureCap.limit_value for feature_key='thryveq_access':
        #   1 = Latest,  2 = This Week,  4 = This Month,  8 = This Year
        # Default (no cap configured) = all periods allowed (bitmask 15).
        thryveq_mask = 15  # all periods open by default (no plan = unlimited)
        thryveq_msg  = "Upgrade your plan to unlock this THRYVEQ score period."
        try:
            from subscription_routes import get_user_plan_caps
            plan_caps = get_user_plan_caps(user_id, db)
            tq_cap = plan_caps.get("thryveq_access")
            if tq_cap is not None and tq_cap.limit_value is not None:
                thryveq_mask = int(tq_cap.limit_value) if int(tq_cap.limit_value) >= 0 else 15
                if tq_cap.limit_hit_message:
                    thryveq_msg = tq_cap.limit_hit_message
        except Exception:
            pass

        def _gated(bits, curr, prev, t, label, compare):
            if thryveq_mask & bits:
                return {"score": curr, "prev": prev, "trend": t, "label": label, "compare": compare, "locked": False}
            return {"score": None, "prev": None, "trend": "N/A", "label": label, "compare": compare,
                    "locked": True, "lock_message": thryveq_msg}

        allowed = []
        if thryveq_mask & 1: allowed.append("latest")
        if thryveq_mask & 2: allowed.append("this_week")
        if thryveq_mask & 4: allowed.append("this_month")
        if thryveq_mask & 8: allowed.append("this_year")

        return JSONResponse(
            content={
                "success": True,
                "allowed_periods": allowed,
                "periods": {
                    "latest":     _gated(1, latest_curr, latest_prev, trend(latest_curr, latest_prev), "Latest",     "vs Yesterday"),
                    "this_week":  _gated(2, week_curr,   week_prev,   trend(week_curr,   week_prev),   "This Week",  "vs Last Week"),
                    "this_month": _gated(4, month_curr,  month_prev,  trend(month_curr,  month_prev),  "This Month", "vs Last Month"),
                    "this_year":  _gated(8, year_curr,   year_prev,   trend(year_curr,   year_prev),   "This Year",  "vs Last Year"),
                }
            },
            headers={"Cache-Control": "no-store"}
        )
    except Exception as e:
        return {"success": False, "error": str(e)}


