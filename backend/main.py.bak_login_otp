        gender         = _str("gender")
        experience_yrs = _int("experience_years")

        # S2: Qualifications & Background
        highest_qualification = _str("highest_qualification")
        education             = _str("education_specialization") or _str("education")  # form field is education_specialization
        referral_source       = _str("referral_source")

        # S3: Availability & Engagement
        preferred_time   = _str("preferred_time")
        preferred_days   = _str("preferred_days")
        engagement_type  = _str("engagement_type")
        intended_hours   = _str("intended_hours")
        availability_notes = _str("availability_notes")

        # S4: Counselling Methods  (multi-checkbox â†’ JSON)
        counselling_methods = _list("counselling_methods")

        # S5: Expertise Areas  (multi-checkbox â†’ JSON)
        expertise_areas = _list("expertise_areas")
        ct_list = form.getlist("consultant_type")
        specialization = ", ".join(ct_list) if ct_list else (_str("specialization") or "General Wellbeing")

        # S6: Practice Details
        qacp_certified = _bool_radio("qacp_certified")
        fee_value      = _float("expected_hourly_fee")
        target_audience_list = form.getlist("target_audience") or []
        target_audience = ", ".join(target_audience_list)
        languages = _list("languages")

        # S7: Delivery & Clinical Experience
        delivery_methods_list = form.getlist("delivery_methods") or []
        delivery_methods   = ", ".join(delivery_methods_list)
        psychometric_tests = _bool_radio("psychometric_tests")
        clinical_experience = _str("clinical_experience")

        # S8: Profile
        dob_raw = _str("date_of_birth")
        dob = None
        if dob_raw:
            try: dob = _date.fromisoformat(dob_raw)
            except ValueError: pass
        linkedin_url = _str("linkedin_url") or None
        bio          = _str("bio")

        # S9: Recommendations (combine ref_name[], ref_relation[], ref_contact[])
        ref_names    = form.getlist("ref_name[]") or []
        ref_relations= form.getlist("ref_relation[]") or []
        ref_contacts = form.getlist("ref_contact[]") or []
        refs = []
        for i in range(len(ref_names)):
            name_i = (ref_names[i] if i < len(ref_names) else "").strip()
            if name_i:
                refs.append({
                    "name":     name_i,
                    "relation": (ref_relations[i] if i < len(ref_relations) else "").strip(),
                    "contact":  (ref_contacts[i]  if i < len(ref_contacts)  else "").strip(),
                })
        recommendations = _json.dumps(refs)

        # â”€â”€ Save to ConsultantProfile â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == user_id).first()
        if not profile:
            profile = ConsultantProfile(user_id=user_id, is_approved=False, is_available=False)
            db.add(profile)

        # S1 â€” Personal
        profile.full_name          = full_name
        profile.gender             = gender
        profile.experience_years   = experience_yrs
        profile.city               = city

        # S2 â€” Qualifications
        profile.highest_qualification = highest_qualification
        profile.education             = education
        profile.referral_source       = referral_source

        # S3 â€” Availability
        profile.preferred_time     = preferred_time
        profile.preferred_days     = preferred_days
        profile.engagement_type    = engagement_type
        profile.intended_hours     = intended_hours
        profile.availability_notes = availability_notes

        # S4 â€” Counselling Methods
        profile.counselling_methods = counselling_methods

        # S5 â€” Expertise
        profile.expertise_areas = expertise_areas
        profile.specialization  = specialization
        if ct_list:
            profile.wellness_category = ct_list[0]

        # S6 â€” Practice
        profile.qacp_certified  = qacp_certified
        profile.hourly_rate     = fee_value
        profile.target_audience = target_audience
        profile.languages       = languages

        # S7 â€” Delivery
        profile.delivery_methods   = delivery_methods
        profile.psychometric_tests = psychometric_tests
        profile.clinical_experience = clinical_experience

        # S8 â€” Profile
        profile.date_of_birth = dob
        profile.linkedin_url  = linkedin_url
        profile.bio           = bio

        # S9 â€” Recommendations
        profile.recommendations      = recommendations

        # â”€â”€ S9 complete. Now handle file uploads (AFTER all text fields are read) â”€â”€
        # NOTE: file reads must come AFTER form.get()/getlist() calls to avoid
        # exhausting the Starlette multipart stream before text fields are parsed.
        cv_url = None
        photo_url = None
        try:
            from gcs_uploads import upload_cv, upload_profile_photo
            cv_file = form.get("cv")
            if cv_file and hasattr(cv_file, "filename") and cv_file.filename:
                cv_bytes = await cv_file.read()
                if cv_bytes:
                    cv_url = upload_cv(cv_bytes, cv_file.filename)
                    print(f"[ONBOARDING] CV uploaded â†’ {cv_url}")
            photo_file = form.get("photo")
            if photo_file and hasattr(photo_file, "filename") and photo_file.filename:
                photo_bytes = await photo_file.read()
                if photo_bytes:
                    photo_url = upload_profile_photo(photo_bytes, photo_file.filename)
                    print(f"[ONBOARDING] Photo uploaded â†’ {photo_url}")
        except Exception as _upload_err:
            import sys
            print(f"[ONBOARDING] File upload warning: {_upload_err}", file=sys.stderr)

        # Files â€” only overwrite if a new file was uploaded
        if cv_url:
            profile.cv_url = cv_url
        if photo_url:
            profile.photo_url = photo_url

        profile.is_profile_completed = True

        # Update user name if changed
        if full_name and full_name != user.name:
            user.name = full_name

        db.commit()
        print(f"[ONBOARDING] Full application saved for user {user_id} (city={city}, methods={counselling_methods[:40]}â€¦)")
        _seed_schedule_from_onboarding(profile, db)

        # Alert admin
        admin_email = os.getenv("ADMIN_EMAIL", "admin@solacesquad.com")
        try:
            send_admin_new_consultant_alert(admin_email, user.name, user.email)
        except Exception as _ae:
            print(f"[ONBOARDING] Admin alert failed: {_ae}")

        # â”€â”€ Done â€” render pending-approval page directly (avoids SW interception of redirect) â”€â”€
        return templates.TemplateResponse(
            "pages/consultant_pending.html",
            {
                "request": request,
                "page_title": "Application Submitted - SolaceSquad",
                "user_name": user.name,
            },
            status_code=200,
        )

    except Exception as e:
        import traceback; traceback.print_exc()
        db.rollback()
        return templates.TemplateResponse(
            "pages/consultant_onboarding.html",
            {"request": request, "page_title": "Complete Your Profile - SolaceSquad",
             "user": user, "error": f"Could not save profile: {str(e)}"}
        )


