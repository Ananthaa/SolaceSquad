@app.get("/api/admin/users/incomplete-consultants")
async def get_incomplete_consultants(request: Request, db: Session = Depends(get_db)):
    """List consultants whose profile is not yet complete."""
    admin_id = request.session.get("user_id")
    admin = db.query(User).filter(User.id == admin_id).first()
    if not admin or admin.user_type != "admin":
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=403)
    # 1. Consultants with an incomplete profile record
    profiles = db.query(ConsultantProfile).join(User).filter(
        ConsultantProfile.is_profile_completed == False
    ).all()
    result = []
    seen_user_ids = set()
    for p in profiles:
        seen_user_ids.add(p.user_id)
        fields = [p.full_name, p.specialization, p.bio, p.experience_years,
                  p.city, p.counselling_methods, p.expertise_areas]
        filled = sum(1 for f in fields if f)
        result.append({
            "user_id":    p.user_id, "profile_id": p.id,
            "name":       p.user.name, "email": p.user.email,
            "phone":      p.user.phone_number or "",
            "joined":     p.user.created_at.strftime("%b %d, %Y") if p.user.created_at else "—",
            "filled_pct": round(filled / len(fields) * 100),
            "is_active":  p.user.is_active,
        })

    # 2. Consultant users with NO profile row at all (stuck after email signup)
    from sqlalchemy import exists
    no_profile_users = db.query(User).filter(
        User.user_type == "consultant",
        User.is_active == True,
        ~db.query(ConsultantProfile).filter(
            ConsultantProfile.user_id == User.id
        ).exists()
    ).all()
    for u in no_profile_users:
        if u.id not in seen_user_ids:
            result.append({
                "user_id":    u.id, "profile_id": None,
                "name":       u.name, "email": u.email,
                "phone":      u.phone_number or "",
                "joined":     u.created_at.strftime("%b %d, %Y") if u.created_at else "—",
                "filled_pct": 0,
                "is_active":  u.is_active,
