        db.commit()
        db.refresh(consultant_profile)
        
    # Check profile completion
    if not consultant_profile.is_profile_completed:
        return RedirectResponse(url="/consultant/onboarding", status_code=303)

    # Check approval
    if not consultant_profile.is_approved:
        return RedirectResponse(url="/consultant/pending", status_code=303)

    consultant_name = request.session.get("user_name", "Consultant")
    
    # Generate initials from name
    name_parts = consultant_name.split()
    if len(name_parts) >= 2:
        initials = f"{name_parts[0][0]}{name_parts[-1][0]}".upper()
    elif len(name_parts) == 1:
        initials = name_parts[0][:2].upper()
    else:
        initials = "C"
    
    # Compute real average rating from ratings table
    from models import ConsultantRating
    ratings = db.query(ConsultantRating).filter(
        ConsultantRating.consultant_id == consultant_profile.id
    ).all()
    if ratings:
        avg_rating = round(sum(r.rating for r in ratings) / len(ratings), 1)
        rating_count = len(ratings)
    else:
        avg_rating = consultant_profile.rating or 0.0
        rating_count = 0

    # Real stats from DB
    active_clients = db.query(Appointment.user_id).filter(
        Appointment.consultant_id == consultant_profile.id
    ).distinct().count()

    # Live counts from Appointment table â€” prevents counter drift (completed > scheduled)
    calls_scheduled = db.query(Appointment).filter(
        Appointment.consultant_id == consultant_profile.id
    ).count()

    calls_completed = db.query(Appointment).filter(
