@app.get("/api/consultant/stats")
async def get_consultant_stats(
    request: Request,
    db: Session = Depends(get_db)
):
    """
    Return session stats for the logged-in consultant â€” used by consultant dashboard.
    Returns: calls_scheduled, calls_completed, completion_rate, avg_rating,
             total_ratings, and a recent feedback_log (last 20 entries).
    All data from Cloud SQL.
    """
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)

    user = db.query(User).filter(User.id == user_id).first()
    if not user or user.user_type != "consultant":
        return JSONResponse({"success": False, "error": "Consultant access required"}, status_code=403)

    try:
        profile = db.query(ConsultantProfile).filter(
            ConsultantProfile.user_id == user_id
        ).first()
        if not profile:
            return JSONResponse({"success": False, "error": "Consultant profile not found"}, status_code=404)

        # â”€â”€ Live counts from Appointment table (prevents counter drift) â”€â”€â”€â”€â”€â”€â”€â”€
        calls_scheduled = db.query(Appointment).filter(
            Appointment.consultant_id == profile.id
        ).count()

        calls_completed = db.query(Appointment).filter(
            Appointment.consultant_id == profile.id,
            Appointment.status == "completed"
        ).count()

        completion_rate = round((calls_completed / calls_scheduled * 100), 1) if calls_scheduled > 0 else 0.0

        # Active clients = distinct users who have scheduled at least one appointment with this consultant
        active_clients_result = db.query(Appointment.user_id).filter(
            Appointment.consultant_id == profile.id
        ).distinct().count()
        active_clients = active_clients_result or 0

        # Total earnings = completed calls Ã— consultant payout per session (set by admin)
        payout_per_session = float(profile.consultant_payout or 0.0)
        total_earnings = round(calls_completed * payout_per_session, 2)

        all_ratings = db.query(ConsultantRating).filter(
            ConsultantRating.consultant_id == profile.id
        ).order_by(ConsultantRating.created_at.desc()).all()
        total_ratings = len(all_ratings)
        avg_rating = round(sum(r.rating for r in all_ratings) / total_ratings, 2) if total_ratings > 0 else None

        feedback_log = [
            {
                "rating": r.rating,
                "feedback": r.feedback or "",
                "display_name": r.display_name or "SolaceSquad User",
                "is_anonymous": r.is_anonymous,
                "created_at": r.created_at.strftime("%b %d, %Y") if r.created_at else ""
            }
            for r in all_ratings[:20]
        ]

        return JSONResponse({
            "success": True,
            "calls_scheduled": calls_scheduled,
            "calls_completed": calls_completed,
            "completion_rate": completion_rate,
            "active_clients": active_clients,
            "total_earnings": total_earnings,
            "payout_per_session": payout_per_session,
            "avg_rating": avg_rating,
            "total_ratings": total_ratings,
            "feedback_log": feedback_log
        })

    except Exception as e:
        print(f"[ERROR] get_consultant_stats: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


