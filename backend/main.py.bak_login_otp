def check_consultant_patient_consent(db: Session, consultant_user_id: int, patient_id: int) -> bool:
    from models import ConsultantProfile, Appointment
    profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == consultant_user_id).first()
    if not profile:
        return False
    
    # 15 days validity from the appointment date
    now = datetime.utcnow()
    fifteen_days_ago = now - timedelta(days=15)
    
    appt = db.query(Appointment).filter(
        Appointment.user_id == patient_id,
        Appointment.consultant_id == profile.id,
        Appointment.consent_to_share_data == True,
        Appointment.appointment_date >= fifteen_days_ago,
        Appointment.appointment_date <= now + timedelta(days=1)
    ).first()
    return appt is not None


@app.get("/api/patient/{user_id}/health-data")
async def get_patient_health_data(
    user_id: int,
    request: Request,
    db: Session = Depends(get_db)
):
    """Get patient's vitals, mood, daily wellness scores, height, and weight for consultant view"""
    try:
        # Verify consultant is logged in
        consultant_user_id = request.session.get("user_id")
        user_type = request.session.get("user_type")
        
        if not consultant_user_id or user_type != "consultant":
            return {"success": False, "error": "Not authorized"}

        # Get last 500 vitals readings
        vitals = db.query(VitalsRecord).filter(
            VitalsRecord.user_id == user_id
        ).order_by(VitalsRecord.timestamp.desc()).limit(500).all()
        
        # Get last 500 mood entries
        moods = db.query(MoodEntry).filter(
            MoodEntry.user_id == user_id
        ).order_by(MoodEntry.timestamp.desc()).limit(500).all()
        
        # Get last 500 wellness scores
        wellness = db.query(DailyWellnessScore).filter(
            DailyWellnessScore.user_id == user_id
        ).order_by(DailyWellnessScore.score_date.desc()).limit(500).all()

        # Get patient profile (height and weight)
        profile = db.query(UserProfile).filter(UserProfile.user_id == user_id).first()
        height = profile.height if profile else None
        weight = profile.weight if profile else None
        
        import timezone_utils
        tz_name = request.session.get("timezone", "UTC")
        # Format vitals data
        vitals_data = []
        for vital in reversed(vitals):  # Reverse to show oldest first
            vitals_data.append({
                "timestamp": vital.timestamp.isoformat() + "Z",
                "date": timezone_utils.format_dt_local(vital.timestamp, "%b %d, %H:%M", tz_name),
                "heart_rate": vital.heart_rate,
                "blood_pressure_systolic": vital.blood_pressure_systolic,
                "blood_pressure_diastolic": vital.blood_pressure_diastolic,
                "temperature": vital.temperature,
                "respiratory_rate": vital.respiratory_rate,
                "oxygen_saturation": vital.spo2
            })
        
        # Format mood data
        mood_data = []
        for mood in reversed(moods):  # Reverse to show oldest first
            mood_data.append({
                "timestamp": mood.timestamp.isoformat() + "Z",
                "date": timezone_utils.format_dt_local(mood.timestamp, "%b %d, %H:%M", tz_name),
                "mood": mood.mood_rating,
                "notes": mood.notes,
                "emotional_wellness_score": mood.emotional_wellness_score
            })
            
        # Format wellness score data
        wellness_data = []
        for score in reversed(wellness):  # Reverse to show oldest first
            import datetime as _dt
            dt_stamp = _dt.datetime.combine(score.score_date, _dt.time.min)
            wellness_data.append({
                "timestamp": dt_stamp.isoformat() + "Z",
                "date": score.score_date.strftime("%b %d, %Y"),
                "health_score": score.health_score,
                "emotional_wellness_score": score.emotional_wellness_score,
                "lifestyle_score": score.lifestyle_score,
                "overall_wellness_score": score.overall_wellness_score
            })
        
        return {
            "success": True,
            "vitals": vitals_data,
            "moods": mood_data,
            "wellness_scores": wellness_data,
            "height": height,
            "weight": weight
        }
        
    except Exception as e:
        print(f"Error fetching patient health data: {str(e)}")
        return {"success": False, "error": str(e)}

