        appt_rows = db.execute(
            text("SELECT id FROM appointments WHERE consultant_id = :cpid"),
            {"cpid": cp_id}
        ).fetchall()
        appt_ids = [r[0] for r in appt_rows]
        aids = ",".join(str(i) for i in appt_ids) if appt_ids else "NULL"

        # Get call_session IDs for these appointments
        cs_ids = []
        if appt_ids:
            cs_rows = db.execute(
                text(f"SELECT id FROM call_sessions WHERE appointment_id IN ({aids})")
            ).fetchall()
            cs_ids = [r[0] for r in cs_rows]

        # Also get call_sessions by consultant_id (users.id)
        cs_rows2 = db.execute(
            text("SELECT id FROM call_sessions WHERE consultant_id = :uid"),
            {"uid": user_id}
        ).fetchall()
        cs_ids = list({*cs_ids, *[r[0] for r in cs_rows2]})
        csids = ",".join(str(i) for i in cs_ids) if cs_ids else "NULL"

        # Get prescription IDs
        pr_ids = []
        if appt_ids:
            pr_rows = db.execute(
                text(f"SELECT id FROM prescriptions WHERE appointment_id IN ({aids})")
            ).fetchall()
            pr_ids = [r[0] for r in pr_rows]
        pr_rows2 = db.execute(
            text("SELECT id FROM prescriptions WHERE consultant_id = :uid"),
            {"uid": user_id}
        ).fetchall()
        pr_ids = list({*pr_ids, *[r[0] for r in pr_rows2]})
        prids = ",".join(str(i) for i in pr_ids) if pr_ids else "NULL"

        # â”€â”€ 1. Anonymize session records â€” set consultant_id = NULL so users
        #       keep their history. Do NOT delete appointments / sessions /
        #       prescriptions / call_sessions as those belong to the user too.
        # â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        # Anonymize appointments where this consultant was involved
        db.execute(
            text("UPDATE appointments SET consultant_id = NULL WHERE consultant_id = :uid"),
            {"uid": user_id}
        )

        # Anonymize call_sessions linked by consultant user_id
