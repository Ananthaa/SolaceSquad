@app.get("/api/user/consultation-sessions")
async def get_consultation_sessions(request: Request, db: Session = Depends(get_db)):
    """All appointments for user â€” with recording + prescription info."""
    user_id = request.session.get("user_id")
    if not user_id:
        return JSONResponse({"success": False, "error": "Unauthorized"}, status_code=401)
    try:
        # 1. Get all appointments for this user (no date filter â€” timezone mismatch causes issues)
        appointments = db.query(Appointment).filter(
            Appointment.user_id == user_id
        ).order_by(Appointment.appointment_date.desc()).all()

        seen_appt_ids = set()
        sessions = []

        def build_session(appt, call_session, prescription):
            consultant_profile = db.query(ConsultantProfile).filter(
                ConsultantProfile.id == appt.consultant_id
            ).first()
            consultant_user = None
            if consultant_profile:
                consultant_user = db.query(User).filter(
                    User.id == consultant_profile.user_id
                ).first()

            duration_seconds = None
            if call_session and call_session.actual_start and call_session.actual_end:
                duration_seconds = int((call_session.actual_end - call_session.actual_start).total_seconds())
            elif call_session and call_session.duration_seconds:
                duration_seconds = call_session.duration_seconds

            return {
                "appointment_id": appt.id,
                "appointment_date": appt.appointment_date.isoformat() + "Z",
                "duration_minutes": appt.duration_minutes,
                "status": appt.status,
                "consultant_name": consultant_user.name if consultant_user else (
                    consultant_profile.full_name if consultant_profile else "Consultant"
                ),
                "consultant_specialization": consultant_profile.specialization if consultant_profile else "",
                "has_recording": call_session is not None and call_session.recording_url is not None,
                "call_session_id": call_session.id if call_session else None,
                "duration_seconds": duration_seconds,
                "has_prescription": prescription is not None,
                "prescription_id": prescription.id if prescription else None,
                "notes": appt.notes or "" if appt else "",
                "has_video": bool(getattr(call_session, 'has_video', False)) if call_session else False,
            }

        for appt in appointments:
            seen_appt_ids.add(appt.id)
            call_session = db.query(CallSession).filter(
                CallSession.appointment_id == appt.id
            ).first()
            prescription = db.query(Prescription).filter(
                Prescription.appointment_id == appt.id
            ).first()
            sessions.append(build_session(appt, call_session, prescription))

        # 2. Also pick up CallSessions not linked to appointments in the list above
        extra_sessions = db.query(CallSession).filter(
            CallSession.user_id == user_id
        ).all()
        for cs in extra_sessions:
            if cs.appointment_id and cs.appointment_id in seen_appt_ids:
                continue  # already included
            if cs.appointment_id:
                appt = db.query(Appointment).filter(Appointment.id == cs.appointment_id).first()
                if appt:
                    seen_appt_ids.add(appt.id)
                    prescription = db.query(Prescription).filter(
                        Prescription.appointment_id == appt.id
                    ).first()
                    sessions.append(build_session(appt, cs, prescription))

        # Sort newest first
        sessions.sort(key=lambda x: x["appointment_date"], reverse=True)

        return JSONResponse({"success": True, "sessions": sessions})
    except Exception as e:
        import traceback; traceback.print_exc()
        print(f"[Sessions API] Error: {e}")
        return JSONResponse({"success": False, "error": str(e)}, status_code=500)


@app.get("/api/recordings/{session_id}/stream")
async def stream_recording(session_id: int, request: Request, db: Session = Depends(get_db)):
    """
    HIPAA-compliant audio proxy:
    - Requires valid session (authenticated user)
    - Enforces ownership: only the patient or their consultant can access
    - Fetches from GCS using service-account credentials (bucket need not be public)
    - Never exposes the raw GCS URL to the browser
    """
    user_id = request.session.get("user_id")
    if not user_id:
        raise HTTPException(status_code=401, detail="Unauthorized")

    call_session = db.query(CallSession).filter(CallSession.id == session_id).first()
    if not call_session:
        raise HTTPException(status_code=404, detail="Session not found")

    # --- Access control: only the patient OR their consultant may stream ---
    # Also check via Appointment in case CallSession lacks user_id/consultant_id
    permitted = False
    if call_session.user_id and call_session.user_id == user_id:
        permitted = True
    elif call_session.consultant_id and call_session.consultant_id == user_id:
        permitted = True
    else:
        # Fallback: check via appointment
        if call_session.appointment_id:
            appt = db.query(Appointment).filter(Appointment.id == call_session.appointment_id).first()
            if appt:
                if appt.user_id == user_id:
                    permitted = True
                else:
                    # check if user_id is a consultant linked to appt.consultant_id
                    cp = db.query(ConsultantProfile).filter(
                        ConsultantProfile.id == appt.consultant_id,
                        ConsultantProfile.user_id == user_id
                    ).first()
                    if cp:
                        permitted = True

    if not permitted:
        raise HTTPException(status_code=403, detail="Access denied â€” you are not a participant in this session")

    if not call_session.recording_url:
        raise HTTPException(status_code=404, detail="No recording available")

    try:
        import asyncio
        from google.cloud import storage as gcs_storage
        from fastapi.responses import Response as BinaryResponse

        recording_url = call_session.recording_url
        # Parse bucket name and object path from the GCS URL
        # Stored as: https://storage.googleapis.com/{bucket}/{object_path}
        # or as: gs://{bucket}/{object_path}
        if recording_url.startswith("gs://"):
            parts = recording_url[5:].split("/", 1)
            bucket_name, object_path = parts[0], parts[1]
        elif "storage.googleapis.com/" in recording_url:
            after = recording_url.split("storage.googleapis.com/", 1)[1]
            bucket_name, object_path = after.split("/", 1)
        else:
            raise ValueError(f"Unrecognised GCS URL format: {recording_url}")

        def _download():
            client = gcs_storage.Client()
            bucket = client.bucket(bucket_name)
            blob = bucket.blob(object_path)
            return blob.download_as_bytes()

        raw_bytes = await asyncio.get_event_loop().run_in_executor(None, _download)

        rec_url_lower = (call_session.recording_url or "").lower()
        is_video = bool(call_session.has_video) or any(ext in rec_url_lower for ext in ['.mp4', '.webm', 'video'])
        stream_media_type = "video/webm" if is_video else "audio/webm"

        # Handle HTTP Range requests for HTML5 video player seeking
        range_header = request.headers.get("range")
        file_size = len(raw_bytes)

        if range_header and range_header.startswith("bytes="):
            try:
                parts = range_header.replace("bytes=", "").split("-")
                start = int(parts[0]) if parts[0] else 0
                end = int(parts[1]) if parts[1] else file_size - 1
                if start >= file_size:
                    start = file_size - 1
                if end >= file_size:
                    end = file_size - 1

                chunk_length = (end - start) + 1
                chunk_data = raw_bytes[start:end+1]

                return BinaryResponse(
                    content=chunk_data,
                    status_code=206,
                    media_type=stream_media_type,
                    headers={
                        "Content-Range": f"bytes {start}-{end}/{file_size}",
                        "Accept-Ranges": "bytes",
                        "Content-Length": str(chunk_length),
                        "Cache-Control": "private, no-store",
                        "Content-Disposition": "inline",
                    }
                )
            except Exception as re_err:
                print(f"[Stream] Range parsing warning: {re_err}")

        return BinaryResponse(
            content=raw_bytes,
            media_type=stream_media_type,
            headers={
                "Accept-Ranges": "bytes",
                "Content-Length": str(file_size),
                "Cache-Control": "private, no-store",   # HIPAA: no caching of PHI
                "Content-Disposition": "inline",
            }
        )
    except HTTPException:
        raise
    except Exception as e:
        print(f"[Stream] Error streaming session {session_id}: {e}")
        import traceback
        traceback.print_exc()
        raise HTTPException(status_code=500, detail="Failed to stream recording")


