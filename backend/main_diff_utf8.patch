+@app.get("/api/reports/{report_id}/file")
+async def get_report_file(
+    report_id: int,
+    request: Request,
+    download: Optional[str] = None,
+    db: Session = Depends(get_db)
+):
+    """Proxy: stream diagnosis report from GCS with access control and inline constraints"""
+    user_id = request.session.get("user_id")
+    user_type = request.session.get("user_type")
+    if not user_id:
+        raise HTTPException(status_code=401, detail="Unauthorized")
+        
+    report = db.query(DiagnosisReport).filter(DiagnosisReport.id == report_id).first()
+    if not report:
+        raise HTTPException(status_code=404, detail="Report not found")
+        
+    # Access Control Check
+    is_authorized = False
+    if user_type == "user" and report.user_id == user_id:
+        is_authorized = True
+    elif user_type == "admin":
+        is_authorized = True
+    elif user_type == "consultant":
+        consultant_profile = db.query(ConsultantProfile).filter(ConsultantProfile.user_id == user_id).first()
+        if consultant_profile:
+            appointment = db.query(Appointment).filter(
+                Appointment.user_id == report.user_id,
+                Appointment.consultant_id == consultant_profile.id,
+                Appointment.status == "scheduled",
+                Appointment.consent_to_share_data == True
+            ).first()
+            if appointment:
+                is_authorized = True
+                    
+    if not is_authorized:
+        raise HTTPException(status_code=403, detail="Forbidden")
+        
+    # Fetch from GCS
+    file_url = report.file_path
+    if "storage.googleapis.com/" not in file_url:
+        raise HTTPException(status_code=404, detail="Invalid file URL")
+        
+    try:
+        import asyncio
+        from google.cloud import storage as gcs_storage
+        from fastapi.responses import Response as BinaryResponse
+        
+        after = file_url.split("storage.googleapis.com/", 1)[1]
+        bucket_name, blob_path = after.split("/", 1)
+        
+        def _download():
+            client = gcs_storage.Client()
+            blob = client.bucket(bucket_name).blob(blob_path)
+            data = blob.download_as_bytes()
+            ct = blob.content_type or "application/pdf"
+            return data, ct
+            
+        file_bytes, content_type = await asyncio.get_event_loop().run_in_executor(None, _download)
+        
+        escaped_filename = report.file_name.replace('"', '\\"')
+        if user_type == "consultant":
+            # Consultant flow: ONLY inline allowed (no direct download)
+            disposition = f'inline; filename="{escaped_filename}"'
+        else:
+            # User flow: respect download param
+            if download == "true":
+                disposition = f'attachment; filename="{escaped_filename}"'
+            else:
+                disposition = f'inline; filename="{escaped_filename}"'
+                
+        return BinaryResponse(
+            content=file_bytes,
+            media_type=content_type,
+            headers={
+                "Content-Disposition": disposition,
+                "Cache-Control": "private, max-age=300",
+            }
+        )
+    except Exception as e:
+        print(f"[Reports] Error serving file for report {report_id}: {e}")
+        raise HTTPException(status_code=404, detail="File not available")
+
